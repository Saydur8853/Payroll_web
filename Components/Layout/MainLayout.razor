@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@inject PayrollRepository PayrollRepository
@inject NavigationManager Navigation

@code {
    private List<NavigationItem> menu = [];
    private string userName = "User";
    private string companyName = "Payroll";
    private string? companyLogoPath;
    private bool isAdmin;
    private bool hasDashboard;
    private bool hasUserManagement;
    private bool loaded;
    private string searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdValue = session?.GetString("UserId");
        if (!int.TryParse(userIdValue, out var userId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        userName = session?.GetString("UserName") ?? userName;
        companyName = session?.GetString("CompanyName") ?? companyName;
        isAdmin = session?.GetString("IsAdmin") == "1";
        menu = await PayrollRepository.GetMenuAsync(userId);

        try
        {
            var compIdStr = session?.GetString("CompanyId");
            if (int.TryParse(compIdStr, out var cId))
            {
                var companies = await PayrollRepository.GetCompaniesAsync();
                var activeComp = companies.FirstOrDefault(c => c.CompanyId == cId);
                if (activeComp is not null && !string.IsNullOrWhiteSpace(activeComp.LogoSource))
                {
                    companyLogoPath = activeComp.LogoSource;
                }
            }
        }
        catch { }

        hasDashboard = isAdmin || HasModuleRecursive(menu, item => item.Id == 184 || item.Name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase));
        hasUserManagement = isAdmin || HasModuleRecursive(menu, item => 
            item.Name.Contains("USER MANAGEMENT", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("USER & SYSTEM", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("User Privilege", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("User Privilage", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("Control Entry", StringComparison.OrdinalIgnoreCase));

        loaded = true;
    }

    private static bool HasModuleRecursive(IEnumerable<NavigationItem> items, Func<NavigationItem, bool> predicate)
    {
        foreach (var item in items)
        {
            if (predicate(item)) return true;
            if (item.Children.Count > 0 && HasModuleRecursive(item.Children, predicate)) return true;
        }
        return false;
    }

    private void SignOut()
    {
        HttpContextAccessor.HttpContext?.Session.Clear();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private string FullUnitBrandTitle =>
        string.IsNullOrWhiteSpace(companyName) || companyName.Equals("Payroll", StringComparison.OrdinalIgnoreCase)
            ? "TG Payroll"
            : companyName;

    private string ShortUnitBrandTitle =>
        string.IsNullOrWhiteSpace(companyName) || companyName.Equals("Payroll", StringComparison.OrdinalIgnoreCase)
            ? "TG Payroll"
            : GetAcronym(companyName);

    private string UnitBrandInitials =>
        string.IsNullOrWhiteSpace(companyName) || companyName.Equals("Payroll", StringComparison.OrdinalIgnoreCase)
            ? "TG"
            : GetInitials(companyName);

    private static string GetAcronym(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "TG";
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 1) return words[0];
        
        var acronym = new string(words.Select(w => char.ToUpperInvariant(w[0])).ToArray());
        return acronym.Length > 6 ? acronym.Substring(0, 6) : acronym;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "TG";
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2) return $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[1][0])}";
        return name.Length >= 2 ? name.Substring(0, 2).ToUpperInvariant() : name.ToUpperInvariant();
    }
}

@if (loaded)
{
    <main class="dashboard-page">
        <header class="topbar">
            <NavLink class="brand-link" href="/Dashboard">
                <div class="brand-badge">
                    @if (!string.IsNullOrWhiteSpace(companyLogoPath))
                    {
                        <img src="@companyLogoPath" alt="Logo" class="topbar-logo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                        <span class="brand-mark small" style="display:none;">@UnitBrandInitials</span>
                    }
                    else
                    {
                        <span class="brand-mark small">@UnitBrandInitials</span>
                    }
                </div>
                <div class="brand-text-group">
                    <span class="topbar-title topbar-title-full" title="@FullUnitBrandTitle">@FullUnitBrandTitle</span>
                    <span class="topbar-title topbar-title-short" title="@FullUnitBrandTitle">@ShortUnitBrandTitle</span>
                    <span class="topbar-tag">Enterprise HRIS & Payroll</span>
                </div>
            </NavLink>

            <div class="topbar-right">
                <NavLink class="topbar-user-pill topbar-user-link" href="/Account" Match="NavLinkMatch.Prefix" title="My Profile & Login Settings">
                    <div class="topbar-avatar">
                        <span>@(string.IsNullOrWhiteSpace(userName) ? "U" : userName[0].ToString().ToUpperInvariant())</span>
                        <span class="topbar-avatar-status"></span>
                    </div>
                    <div class="topbar-user-details">
                        <strong class="topbar-user-name">@userName</strong>
                        <small class="topbar-user-role">@(isAdmin ? "Administrator" : "Active Account")</small>
                    </div>
                </NavLink>

                <button type="button" class="topbar-btn topbar-btn-signout" @onclick="SignOut" title="Sign out of your session">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M19 10a.75.75 0 00-.75-.75H8.704l2.47-2.47a.75.75 0 10-1.06-1.06l-3.75 3.75a.75.75 0 000 1.06l3.75 3.75a.75.75 0 101.06-1.06l-2.47-2.47h9.546A.75.75 0 0019 10z" clip-rule="evenodd"/></svg>
                    <span>Sign out</span>
                </button>
            </div>
        </header>
        <div class="application-shell">
            <aside class="sidebar">
                <div class="sidebar-header">
                    <span class="sidebar-section-title">Navigation</span>
                </div>

                <div class="sidebar-search-box">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="sidebar-search-icon">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                    <input type="text"
                           class="sidebar-search-input"
                           placeholder="Search modules..."
                           @bind="searchQuery"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <button type="button" class="sidebar-search-clear" @onclick="() => searchQuery = string.Empty" title="Clear search">✕</button>
                    }
                </div>

                <nav class="sidebar-nav" aria-label="Main Navigation">
                    <MenuItems Items="menu" SearchQuery="@searchQuery" Level="0" />
                </nav>

                <div class="sidebar-footer-card">
                    <div class="sidebar-footer-header">
                        <div class="sidebar-footer-status">
                            <div class="sidebar-footer-dot"></div>
                            <span class="sidebar-footer-label">System Online</span>
                        </div>
                        <span class="sidebar-version-badge">v1.0.0 <span class="sidebar-beta-tag">BETA</span></span>
                    </div>
                    <div class="sidebar-footer-meta">
                        <strong title="@companyName">@companyName</strong>
                        <div class="sidebar-footer-sub">
                            <small>TG Payroll Enterprise</small>
                            <span class="sidebar-build-tag">Beta Release</span>
                        </div>
                    </div>
                </div>
            </aside>
            <div class="dashboard-content">@Body</div>
        </div>
    </main>
}
