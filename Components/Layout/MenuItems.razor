@code {
    [Parameter, EditorRequired] public IEnumerable<NavigationItem>? Items { get; set; }
    [Parameter] public string? SearchQuery { get; set; }
    [Parameter] public int Level { get; set; } = 0;

    private IEnumerable<NavigationItem> FilteredItems
    {
        get
        {
            if (Items is null) return [];
            var list = Items;
            if (string.IsNullOrWhiteSpace(SearchQuery)) return list;

            var q = SearchQuery.Trim();
            return list.Where(item => MatchesSearch(item, q));
        }
    }

    private static bool MatchesSearch(NavigationItem item, string query)
    {
        if (item.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
            return true;
        return item.Children.Any(c => MatchesSearch(c, query));
    }

    private bool IsOpen(NavigationItem item)
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery)) return true;
        return true;
    }

    private int GetVisibleChildrenCount(NavigationItem item)
    {
        return item.Children?.Count ?? 0;
    }

    private static bool IsDashboardItem(string name, int id)
    {
        return id == 90 || id == 184 || name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsEmployeeLeafItem(string name)
    {
        return name.Equals("Employee", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Employee Profiles", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Employee Profile", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsEmployeeItem(string name, int id = 0)
    {
        return id == 12
            || name.Equals("Employee", StringComparison.OrdinalIgnoreCase) 
            || name.Equals("Employee Profiles", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Employee Profile", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsControlEntryItem(string name)
    {
        return name.Equals("Control Entry", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Control_Entry", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Controls Entry", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Add Features", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Feature Entry", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSetCompanyItem(string name)
    {
        return name.Equals("Set Company", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Company", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Company Setup", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Company Information", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsTrackingTaskItem(string name)
    {
        return name.Equals("Tracking Task", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Task Tracking", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Tracking_Task", StringComparison.OrdinalIgnoreCase)
            || name.Equals("User Tracking", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsUserManagementItem(string name)
    {
        return name.Equals("User Management", StringComparison.OrdinalIgnoreCase) 
            || name.Equals("User Control", StringComparison.OrdinalIgnoreCase)
            || name.Equals("User Privilege", StringComparison.OrdinalIgnoreCase)
            || name.Equals("User Privileges", StringComparison.OrdinalIgnoreCase)
            || name.Equals("User Privilage", StringComparison.OrdinalIgnoreCase)
            || name.Equals("User Privilages", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDesignationItem(string name)
    {
        return name.Equals("Designation", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Designations", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsShiftInfoItem(string name)
    {
        return name.Equals("Shift Info", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Shift_Info", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Shift Information", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Shift", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsHolidayItem(string name)
    {
        return name.Equals("Set HoliDay", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Set Holiday", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Holiday", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Holidays", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsUnitItem(string name)
    {
        return name.Equals("Unit", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Unit Setup", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Units", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDepartmentItem(string name)
    {
        return name.Equals("Department", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Departments", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsCategoryItem(string name)
    {
        return name.Equals("Category", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Employee Category", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Emp Category", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Categories", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSectionItem(string name)
    {
        return name.Equals("Section", StringComparison.OrdinalIgnoreCase)
            || name.Equals("Sections", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsLineItem(string name)
    {
