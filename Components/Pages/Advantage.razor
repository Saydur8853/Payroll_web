@page "/Advantage"
@page "/Advantage/{TabName}"
@page "/AdvanceSalary"
@page "/FestivalBonus"
@page "/IncrementEntry"
@page "/Promotion"
@page "/EarnLeave"
@page "/AllowanceProcess"
@page "/Insurance"
@using System.Web
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject PayrollRepository PayrollRepository
@inject MasterRepository MasterRepository
@inject EmployeeRepository EmployeeRepository
@inject AdvantageRepository AdvantageRepository
@inject IJSRuntime JSRuntime

<PageTitle>@GetHeaderTitle() - TG Payroll</PageTitle>

@if (!loaded)
{
    <div class="control-entry-shell">
        <section class="control-form-panel">
            <div class="skeleton-shimmer" style="height:32px;width:240px;margin-bottom:12px;"></div>
            <div class="skeleton-shimmer" style="height:18px;width:380px;margin-bottom:24px;"></div>
            <div class="skeleton-shimmer" style="height:180px;border-radius:12px;margin-bottom:16px;"></div>
        </section>
        <section class="control-list-panel">
            <div class="skeleton-shimmer" style="height:350px;border-radius:12px;"></div>
        </section>
    </div>
}
else if (!hasAccess)
{
    <div class="database-error management-message">
        Access Restricted: You do not have permission to view Advantage modules.
    </div>
}
else
{
    <section class="management-heading">
        <div>
            <p class="eyebrow">ADVANTAGE & BENEFIT OPERATIONS</p>
            <h1>@GetHeaderTitle()</h1>
            <p>@GetHeaderSubtitle()</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="success-message">@successMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="database-error management-message">@errorMessage</div>
    }

    <!-- Universal Delete Consent Modal -->
    @if (showConfirmModal)
    {
        <div class="modal-backdrop-overlay" @onclick="CancelDelete">
            <div class="confirm-delete-modal" @onclick:stopPropagation>
                <div class="confirm-modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3>Are you sure?</h3>
                <p>Do you really want to delete <strong>@confirmItemTitle</strong> (@confirmItemType)? This action cannot be undone.</p>
                <div class="confirm-modal-actions">
                    <button type="button" class="btn-cancel-modal" @onclick="CancelDelete">No, Cancel</button>
                    <button type="button" class="btn-confirm-delete" @onclick="ExecuteConfirmedDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    }

    <!-- ==================== 1. ADVANCE SALARY ==================== -->
    @if (activeTab == "advancesalary" && canAccessAdvanceSalary)
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Advance Salary Processing</h2>
                    <p>Calculate and record monthly salary advances based on attendance and working days.</p>
                </div>
                <form @onsubmit="ProcessAdvanceSalary" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Advance Month / Effect Date</span>
                            <input type="month" value="@filter.EffectDate.ToString("yyyy-MM")" @onchange="OnAdvanceMonthChanged" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Attendance Start Date</span>
                            <input type="date" value="@filter.StartDate.ToString("yyyy-MM-dd")" @onchange="e => filter.StartDate = DateTime.Parse(e.Value?.ToString() ?? DateTime.Today.ToString())" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Attendance End Date</span>
                            <input type="date" value="@filter.EndDate.ToString("yyyy-MM-dd")" @onchange="e => filter.EndDate = DateTime.Parse(e.Value?.ToString() ?? DateTime.Today.ToString())" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Advance Title / Description</span>
                            <input @bind="filter.TitleOrType" placeholder="e.g. Mid-Month Advance" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Business Unit</span>
                            <select @bind="filter.UnitId" class="company-form-input">
                                <option value="">-- All Units --</option>
                                @foreach (var u in units) { <option value="@u.UnitId">@u.UnitName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Department</span>
                            <select @bind="filter.DepartmentId" class="company-form-input">
                                <option value="">-- All Departments --</option>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Round To Amount (BDT)</span>
                            <select @bind="advRoundAmount" class="company-form-input">
                                <option value="1">No Rounding (Exact)</option>
                                <option value="100">Round to 100</option>
                                <option value="500">Round to 500</option>
                                <option value="1000">Round to 1000</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Code (Optional)</span>
                            <input @bind="filter.EmpCode" placeholder="Specific Emp Code" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="LoadSavedAdvanceSalaries">Load Saved Records</button>
                        <button type="submit" class="btn-primary-action">
                            <span>Calculate / Process Advance</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Advance Salary Roster (@advanceSalaries.Count Records)</h2>
                        <p>Total Advance: <strong>৳ @advanceSalaries.Sum(a => a.AdvanceAmount).ToString("N2")</strong> | Bank: ৳ @advanceSalaries.Sum(a => a.BankPayable).ToString("N2") | Cash: ৳ @advanceSalaries.Sum(a => a.CashPayable).ToString("N2")</p>
                    </div>
                    @if (advanceSalaries.Count > 0)
                    {
                        <div class="table-action-group">
                            <button type="button" class="btn-primary-action" @onclick="SaveAdvanceSalaries">Save All Records</button>
                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Advance Salary Batch", filter.EffectDate.ToString("MMMM yyyy"), DeleteAdvanceSalaries)'>Clear Month</button>
                        </div>
                    }
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:40px;"><input type="checkbox" @onchange="ToggleSelectAllAdvances" checked="@(advanceSalaries.Count > 0 && advanceSalaries.All(a => a.IsSelected))" /></th>
                                <th>Emp Code</th>
                                <th>Employee Name</th>
                                <th>Designation / Dept</th>
                                <th style="text-align:right;">Gross</th>
                                <th style="text-align:center;">Present</th>
                                <th style="text-align:right;">Earning</th>
                                <th style="text-align:right;">Advance (Payable)</th>
                                <th>Pay Mode</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in advanceSalaries)
                            {
                                <tr>
                                    <td><input type="checkbox" @bind="a.IsSelected" /></td>
                                    <td><strong>@a.EmpCode</strong></td>
                                    <td>@a.EmpName</td>
                                    <td><small>@a.DesignationName</small><div class="badge-sub">@a.DepartmentName</div></td>
                                    <td style="text-align:right;">৳ @a.Gross.ToString("N0")</td>
                                    <td style="text-align:center;"><span class="type-pill">@a.PresentDays d</span></td>
                                    <td style="text-align:right;">৳ @a.EarningSalary.ToString("N0")</td>
                                    <td style="text-align:right;">
                                        <input type="number" @bind="a.AdvanceAmount" class="table-inline-input" style="width:90px;text-align:right;" @bind:after="() => RecalculateAdvanceRow(a)" />
                                    </td>
                                    <td><span class="@(a.AccType == "Bank" ? "admin-badge" : "type-pill")">@a.AccType</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== 2. FESTIVAL BONUS ==================== -->
    @if (activeTab == "bonus" && canAccessFestivalBonus)
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Festival Bonus Processing</h2>
                    <p>Compute festival bonuses (Eid, Puja, Year-End) with stamp deductions and bank/cash split.</p>
                </div>
                <form @onsubmit="ProcessFestivalBonus" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Festival / Bonus Title <strong class="req-star">*</strong></span>
                            <select @bind="filter.TitleOrType" class="company-form-input">
                                <option value="Eid-ul-Fitr">Eid-ul-Fitr</option>
                                <option value="Eid-ul-Adha">Eid-ul-Adha</option>
                                <option value="Durga Puja">Durga Puja</option>
                                <option value="Christmas / New Year">Christmas / New Year</option>
                                <option value="Special Festival Bonus">Special Festival Bonus</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Bonus Month / Effect Date</span>
                            <input type="month" value="@filter.EffectDate.ToString("yyyy-MM")" @onchange="OnBonusMonthChanged" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Bonus Formula / Calculation Rule</span>
                            <select @bind="bonusBasis" class="company-form-input">
                                <option value="BASIC_100">100% of Basic Salary</option>
                                <option value="BASIC_50">50% of Basic Salary (Half Basic)</option>
                                <option value="GROSS_50">50% of Gross Salary</option>
                                <option value="GROSS_100">100% of Gross Salary</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Business Unit</span>
                            <select @bind="filter.UnitId" class="company-form-input">
                                <option value="">-- All Units --</option>
                                @foreach (var u in units) { <option value="@u.UnitId">@u.UnitName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Department</span>
                            <select @bind="filter.DepartmentId" class="company-form-input">
                                <option value="">-- All Departments --</option>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Category</span>
                            <select @bind="filter.CategoryId" class="company-form-input">
                                <option value="">-- All Categories --</option>
                                @foreach (var c in categories) { <option value="@c.CategoryId">@c.CategoryName</option> }
                            </select>
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="LoadSavedFestivalBonuses">Load Saved Records</button>
                        <button type="submit" class="btn-primary-action">
                            <span>Calculate / Process Bonus</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Festival Bonus Register (@festivalBonuses.Count Employees)</h2>
                        <p>Total Bonus: <strong>৳ @festivalBonuses.Sum(b => b.BonusAmount).ToString("N2")</strong> | Net Cash: ৳ @festivalBonuses.Sum(b => b.NetCashPayable).ToString("N2") | Bank: ৳ @festivalBonuses.Sum(b => b.BankPayable).ToString("N2")</p>
                    </div>
                    @if (festivalBonuses.Count > 0)
                    {
                        <div class="table-action-group">
                            <button type="button" class="btn-primary-action" @onclick="SaveFestivalBonuses">Save Bonus Records</button>
                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Festival Bonus Batch", filter.EffectDate.ToString("MMMM yyyy"), DeleteFestivalBonuses)'>Clear Batch</button>
                        </div>
                    }
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:40px;"><input type="checkbox" @onchange="ToggleSelectAllBonuses" checked="@(festivalBonuses.Count > 0 && festivalBonuses.All(b => b.IsSelected))" /></th>
                                <th>Emp Code</th>
                                <th>Employee Name</th>
                                <th>Department / Desig</th>
                                <th style="text-align:right;">Gross</th>
                                <th style="text-align:right;">Basic</th>
                                <th style="text-align:center;">Service</th>
                                <th style="text-align:right;">Bonus</th>
                                <th style="text-align:right;">Stamp</th>
                                <th style="text-align:right;">Net Cash</th>
                                <th>Mode</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in festivalBonuses)
                            {
                                <tr>
                                    <td><input type="checkbox" @bind="b.IsSelected" /></td>
                                    <td><strong>@b.EmpCode</strong></td>
                                    <td>@b.EmpName</td>
                                    <td><small>@b.DepartmentName</small><div class="badge-sub">@b.DesignationName</div></td>
                                    <td style="text-align:right;">৳ @b.Gross.ToString("N0")</td>
                                    <td style="text-align:right;">৳ @b.Basic.ToString("N0")</td>
                                    <td style="text-align:center;"><span class="type-pill">@b.ServicePeriod</span></td>
                                    <td style="text-align:right;">
                                        <input type="number" @bind="b.BonusAmount" class="table-inline-input" style="width:85px;text-align:right;" @bind:after="() => RecalculateBonusRow(b)" />
                                    </td>
                                    <td style="text-align:right;">৳ @b.Stamp.ToString("N0")</td>
                                    <td style="text-align:right;"><strong>৳ @b.NetCashPayable.ToString("N0")</strong></td>
                                    <td><span class="@(b.AccType == "Bank" ? "admin-badge" : "type-pill")">@b.AccType</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== 3. INCREMENT ENTRY ==================== -->
    @if (activeTab == "increment" && canAccessIncrement)
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Yearly / Periodic Increment Entry</h2>
                    <p>Apply percentage or fixed-amount salary increments across departments and sections.</p>
                </div>
                <form @onsubmit="PrepareIncrementBatch" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Effective Date</span>
                            <input type="date" value="@filter.EffectDate.ToString("yyyy-MM-dd")" @onchange="e => filter.EffectDate = DateTime.Parse(e.Value?.ToString() ?? DateTime.Today.ToString())" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Increment Method</span>
                            <select @bind="isIncrementPercentage" class="company-form-input">
                                <option value="true">Percentage of Gross (%)</option>
                                <option value="false">Fixed Amount (BDT)</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Increment Value @(isIncrementPercentage ? "(%)" : "(BDT)")</span>
                            <input type="number" step="0.5" @bind="incrementValue" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Department</span>
                            <select @bind="filter.DepartmentId" class="company-form-input">
                                <option value="">-- All Departments --</option>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Section</span>
                            <select @bind="filter.SectionId" class="company-form-input">
                                <option value="">-- All Sections --</option>
                                @foreach (var s in sections) { <option value="@s.SectionId">@s.SectionName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Code</span>
                            <input @bind="filter.EmpCode" placeholder="Specific Emp Code" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="LoadSavedIncrements">View History</button>
                        <button type="submit" class="btn-primary-action">
                            <span>Preview Increment Batch</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Increment Roster (@increments.Count Employees)</h2>
                        <p>Total Increment: <strong>৳ @increments.Sum(i => i.IncrementAmount).ToString("N2")</strong> | Post-Increment Gross: ৳ @increments.Sum(i => i.PromotedGross).ToString("N2")</p>
                    </div>
                    @if (increments.Count > 0)
                    {
                        <div class="table-action-group">
                            <button type="button" class="btn-primary-action" @onclick="SaveIncrements">Confirm & Apply All Increments</button>
                        </div>
                    }
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:40px;"><input type="checkbox" @onchange="ToggleSelectAllIncrements" checked="@(increments.Count > 0 && increments.All(i => i.IsSelected))" /></th>
                                <th>Emp Code</th>
                                <th>Name / Designation</th>
                                <th>Department</th>
                                <th style="text-align:right;">Current Gross</th>
                                <th style="text-align:right;">Increment</th>
                                <th style="text-align:right;">New Gross</th>
                                <th style="text-align:center;">Effective</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in increments)
                            {
                                <tr>
                                    <td><input type="checkbox" @bind="i.IsSelected" /></td>
                                    <td><strong>@i.EmpCode</strong></td>
                                    <td><strong>@i.EmpName</strong><div class="badge-sub">@i.DesignationName</div></td>
                                    <td>@i.DepartmentName</td>
                                    <td style="text-align:right;">৳ @i.PreGross.ToString("N0")</td>
                                    <td style="text-align:right;">
                                        <input type="number" @bind="i.IncrementAmount" class="table-inline-input" style="width:85px;text-align:right;" @bind:after="() => RecalculateIncrementRow(i)" />
                                    </td>
                                    <td style="text-align:right;"><strong style="color:#16a34a;">৳ @i.PromotedGross.ToString("N0")</strong></td>
                                    <td style="text-align:center;"><small>@i.EffectiveDate.ToString("dd-MMM-yyyy")</small></td>
                                    <td>
                                        @if (i.IncrementId > 0)
                                        {
                                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Increment", i.EmpName, () => DeleteIncrement(i.IncrementId))'>Revert</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== 4. PROMOTION ==================== -->
    @if (activeTab == "promotion" && canAccessPromotion)
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Employee Promotion Entry</h2>
                    <p>Promote employee to higher designation, grade, and updated gross salary structure.</p>
                </div>
                <form @onsubmit="SavePromotion" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Code <strong class="req-star">*</strong></span>
                            <div style="display:flex;gap:8px;">
                                <input @bind="promotionEmpCode" placeholder="e.g. 10025" required class="company-form-input" />
                                <button type="button" class="btn-secondary-action" @onclick="SearchPromotionEmployee">Search</button>
                            </div>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Name</span>
                            <input value="@promotionItem.EmpName" disabled class="company-form-input" style="background:#f1f5f9;" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Current Designation</span>
                            <input value="@promotionItem.PreDesignation" disabled class="company-form-input" style="background:#f1f5f9;" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Current Gross Salary</span>
                            <input value="৳ @promotionItem.PreGross.ToString("N0")" disabled class="company-form-input" style="background:#f1f5f9;" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">New Promoted Designation <strong class="req-star">*</strong></span>
                            <select @bind="promotionItem.PromDesignationId" required class="company-form-input" @bind:after="OnPromotionDesignationSelected">
                                <option value="0">-- Select Promoted Designation --</option>
                                @foreach (var d in designations) { <option value="@d.DesignationId">@d.DesignationName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">New Grade</span>
                            <input @bind="promotionItem.PromGrade" placeholder="e.g. Grade-3" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">New Promoted Gross Salary <strong class="req-star">*</strong></span>
                            <input type="number" @bind="promotionItem.PromGross" required class="company-form-input" @bind:after="OnPromotionGrossChanged" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Promotion Increment Amount</span>
                            <input type="number" @bind="promotionItem.PromotionAmount" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Effective Date <strong class="req-star">*</strong></span>
                            <input type="date" value="@promotionItem.EffectiveDate.ToString("yyyy-MM-dd")" @onchange="e => promotionItem.EffectiveDate = DateTime.Parse(e.Value?.ToString() ?? DateTime.Today.ToString())" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Promotion Remarks</span>
                            <input @bind="promotionItem.IncrDesc" placeholder="e.g. Annual Performance Promotion" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="ResetPromotionForm">Reset</button>
                        <button type="submit" class="btn-primary-action">
                            <span>Confirm Promotion</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Promotion History Records (@promotions.Count)</h2>
                        <p>Chronological audit log of employee promotions and grade elevations.</p>
                    </div>
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
