@code {
    [Parameter]
    public string? TabName { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    private bool loaded;
    private bool hasAccess;
    private int currentUserId;
    private string currentUserName = "User";
    private bool currentUserIsAdmin;

    private string activeTab = "advancesalary";

    // Permission flags
    private bool canAccessAdvanceSalary;
    private bool canAccessFestivalBonus;
    private bool canAccessIncrement;
    private bool canAccessPromotion;
    private bool canAccessEarnLeave;
    private bool canAccessAllowance;
    private bool canAccessInsurance;

    // Filter and Master Data
    private AdvantageFilter filter = new();
    private List<UnitItem> units = [];
    private List<DepartmentItem> departments = [];
    private List<SectionItem> sections = [];
    private List<DesignationItem> designations = [];
    private List<CategoryItem> categories = [];

    // Module Data
    private List<AdvanceSalaryItem> advanceSalaries = [];
    private int advRoundAmount = 100;

    private List<FestivalBonusItem> festivalBonuses = [];
    private string bonusBasis = "BASIC_100";

    private List<IncrementItem> increments = [];
    private bool isIncrementPercentage = true;
    private decimal incrementValue = 5;

    private List<PromotionItem> promotions = [];
    private string promotionEmpCode = "";
    private PromotionItem promotionItem = new();

    private List<EarnLeaveProcessItem> earnLeaves = [];
    private List<AllowanceItem> allowances = [];

    private List<InsuranceItem> insuranceList = [];
    private string insuranceFilterType = "ALL";

    // Feedback & Confirmation
    private string? successMessage;
    private string? errorMessage;
    private bool showConfirmModal;
    private string confirmItemTitle = "";
    private string confirmItemType = "";
    private Func<Task>? pendingDeleteAction;

    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdStr = session?.GetString("UserId");
        if (!int.TryParse(userIdStr, out currentUserId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        currentUserName = session?.GetString("UserName") ?? "User";
        currentUserIsAdmin = session?.GetString("IsAdmin") == "1";

        var menu = await PayrollRepository.GetMenuAsync(currentUserId);
        canAccessAdvanceSalary = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 147 || item.Name.Contains("Advance Salary", StringComparison.OrdinalIgnoreCase));
        canAccessFestivalBonus = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 113 || item.Name.Contains("Festival Bonus", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Bonus", StringComparison.OrdinalIgnoreCase));
        canAccessIncrement = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 45 || item.Name.Contains("Increment", StringComparison.OrdinalIgnoreCase));
        canAccessPromotion = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 130 || item.Name.Contains("Promotion", StringComparison.OrdinalIgnoreCase));
        canAccessEarnLeave = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 117 || item.Name.Contains("Earn Leave", StringComparison.OrdinalIgnoreCase));
        canAccessAllowance = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 126 || item.Name.Contains("Allowance", StringComparison.OrdinalIgnoreCase));
        canAccessInsurance = currentUserIsAdmin || HasModuleRecursive(menu, item => item.Id == 118 || item.Name.Contains("Insurance", StringComparison.OrdinalIgnoreCase));

        hasAccess = canAccessAdvanceSalary || canAccessFestivalBonus || canAccessIncrement || canAccessPromotion || canAccessEarnLeave || canAccessAllowance || canAccessInsurance;

        if (!hasAccess)
        {
            loaded = true;
            return;
        }

        units = await MasterRepository.GetUnitsAsync();
        departments = await MasterRepository.GetDepartmentsAsync();
        sections = await MasterRepository.GetSectionsAsync();
        designations = await MasterRepository.GetDesignationsAsync();
        categories = await MasterRepository.GetCategoriesAsync();

        ResolveActiveTab();
        loaded = true;
    }

    protected override void OnParametersSet()
    {
        if (loaded)
        {
            ResolveActiveTab();
        }
    }

    private void ResolveActiveTab()
    {
        var uri = Navigation.Uri.ToLowerInvariant();
        var tab = QueryTab ?? TabName;

        if (!string.IsNullOrWhiteSpace(tab))
        {
            var t = tab.ToLowerInvariant();
            if (t.Contains("advance") && canAccessAdvanceSalary) activeTab = "advancesalary";
            else if (t.Contains("bonus") && canAccessFestivalBonus) activeTab = "bonus";
            else if (t.Contains("increment") && canAccessIncrement) activeTab = "increment";
            else if (t.Contains("promotion") && canAccessPromotion) activeTab = "promotion";
            else if (t.Contains("earn") || t.Contains("leave") && canAccessEarnLeave) activeTab = "earnleave";
            else if (t.Contains("allowance") && canAccessAllowance) activeTab = "allowance";
            else if (t.Contains("insurance") && canAccessInsurance) activeTab = "insurance";
        }
        else if (uri.Contains("/advancesalary") && canAccessAdvanceSalary) activeTab = "advancesalary";
        else if (uri.Contains("/festivalbonus") && canAccessFestivalBonus) activeTab = "bonus";
        else if (uri.Contains("/incremententry") && canAccessIncrement) activeTab = "increment";
        else if (uri.Contains("/promotion") && canAccessPromotion) activeTab = "promotion";
        else if (uri.Contains("/earnleave") && canAccessEarnLeave) activeTab = "earnleave";
        else if (uri.Contains("/allowanceprocess") && canAccessAllowance) activeTab = "allowance";
        else if (uri.Contains("/insurance") && canAccessInsurance) activeTab = "insurance";
        else
        {
            if (canAccessAdvanceSalary) activeTab = "advancesalary";
            else if (canAccessFestivalBonus) activeTab = "bonus";
            else if (canAccessIncrement) activeTab = "increment";
            else if (canAccessPromotion) activeTab = "promotion";
            else if (canAccessEarnLeave) activeTab = "earnleave";
            else if (canAccessAllowance) activeTab = "allowance";
            else if (canAccessInsurance) activeTab = "insurance";
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        successMessage = null;
        errorMessage = null;
    }

    private static bool HasModuleRecursive(List<NavigationItem> items, Func<NavigationItem, bool> predicate)
    {
        foreach (var item in items)
        {
            if (predicate(item)) return true;
            if (item.Children.Count > 0 && HasModuleRecursive(item.Children, predicate)) return true;
        }
        return false;
    }

    // ==========================================
    // 1. ADVANCE SALARY METHODS
    // ==========================================
    private void OnAdvanceMonthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString() + "-01", out var dt))
        {
            filter.EffectDate = dt;
            filter.StartDate = new DateTime(dt.Year, dt.Month, 1);
            filter.EndDate = new DateTime(dt.Year, dt.Month, Math.Min(DateTime.Today.Day, DateTime.DaysInMonth(dt.Year, dt.Month)));
        }
    }

    private async Task ProcessAdvanceSalary()
    {
        try
        {
            advanceSalaries = await AdvantageRepository.CalculateAdvanceSalariesAsync(filter, advRoundAmount);
            successMessage = $"Successfully computed advance salary for {advanceSalaries.Count} active employees.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task LoadSavedAdvanceSalaries()
    {
        try
        {
            advanceSalaries = await AdvantageRepository.GetAdvanceSalariesAsync(filter.EffectDate, filter.UnitId, filter.DepartmentId, filter.SectionId);
            successMessage = $"Loaded {advanceSalaries.Count} saved advance salary records from database.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private void ToggleSelectAllAdvances(ChangeEventArgs e)
    {
        var chk = (bool)(e.Value ?? false);
        foreach (var a in advanceSalaries) a.IsSelected = chk;
    }

    private void RecalculateAdvanceRow(AdvanceSalaryItem item)
    {
        if (item.AccType == "Bank")
        {
            item.BankPayable = item.AdvanceAmount;
            item.CashPayable = 0;
        }
        else
        {
            item.CashPayable = item.AdvanceAmount;
            item.BankPayable = 0;
        }
    }

    private async Task SaveAdvanceSalaries()
    {
        try
        {
            var selected = advanceSalaries.Where(a => a.IsSelected).ToList();
            await AdvantageRepository.SaveAdvanceSalariesAsync(selected);
            successMessage = $"Saved {selected.Count} advance salary records to database successfully.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task DeleteAdvanceSalaries()
    {
        try
        {
            await AdvantageRepository.DeleteAdvanceSalariesAsync(filter.EffectDate);
            advanceSalaries.Clear();
            successMessage = "Advance salary batch cleared successfully.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    // ==========================================
    // 2. FESTIVAL BONUS METHODS
    // ==========================================
    private void OnBonusMonthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString() + "-01", out var dt))
        {
            filter.EffectDate = dt;
        }
    }

    private async Task ProcessFestivalBonus()
    {
        try
        {
            festivalBonuses = await AdvantageRepository.CalculateFestivalBonusesAsync(filter, bonusBasis);
            successMessage = $"Computed festival bonus for {festivalBonuses.Count} employees.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task LoadSavedFestivalBonuses()
    {
        try
        {
            festivalBonuses = await AdvantageRepository.GetFestivalBonusesAsync(filter.EffectDate, filter.UnitId, filter.DepartmentId);
            successMessage = $"Loaded {festivalBonuses.Count} saved festival bonus records from database.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private void ToggleSelectAllBonuses(ChangeEventArgs e)
    {
        var chk = (bool)(e.Value ?? false);
        foreach (var b in festivalBonuses) b.IsSelected = chk;
    }

    private void RecalculateBonusRow(FestivalBonusItem item)
    {
        if (item.AccType == "Bank")
        {
            item.BankPayable = item.BonusAmount;
            item.CashPayable = 0;
            item.NetCashPayable = 0;
        }
        else
        {
            item.CashPayable = item.BonusAmount;
            item.NetCashPayable = Math.Max(0, item.BonusAmount - item.Stamp);
            item.BankPayable = 0;
        }
