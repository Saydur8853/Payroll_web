    // ==========================================
    private void PromptDelete(string itemType, string itemName, Func<Task> onConfirm)
    {
        confirmItemType = itemType;
        confirmItemTitle = itemName;
        pendingDeleteAction = onConfirm;
        showConfirmModal = true;
    }

    private void CancelDelete()
    {
        showConfirmModal = false;
        pendingDeleteAction = null;
    }

    private async Task ExecuteConfirmedDelete()
    {
        if (pendingDeleteAction != null)
        {
            var action = pendingDeleteAction;
            showConfirmModal = false;
            pendingDeleteAction = null;
            await action();
        }
    }

