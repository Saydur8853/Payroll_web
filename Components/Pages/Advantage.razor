    // ==========================================
    // 4. PROMOTION METHODS
    // ==========================================
    private async Task SearchPromotionEmployee()
    {
        if (string.IsNullOrWhiteSpace(promotionEmpCode)) return;
        try
        {
            var empList = await EmployeeRepository.GetEmployeesAsync(promotionEmpCode.Trim());
            var empSummary = empList.FirstOrDefault(e => e.EmployeeCode.Equals(promotionEmpCode.Trim(), StringComparison.OrdinalIgnoreCase)) ?? empList.FirstOrDefault();
            if (empSummary != null)
            {
                var emp = await EmployeeRepository.GetEmployeeAsync(empSummary.EmployeeId);
                if (emp != null)
                {
                    var desigName = designations.FirstOrDefault(d => d.DesignationId == emp.DesignationId)?.DesignationName ?? "";
                    promotionItem = new PromotionItem
                    {
                        EmpId = emp.EmployeeId,
                        EmpCode = emp.EmployeeCode,
                        EmpName = emp.EmployeeName,
                        PreDesignationId = emp.DesignationId,
                        PreDesignation = desigName,
                        PreGrade = emp.EmployeeGrade,
                        PreGross = emp.Gross,
                        PromGross = emp.Gross,
                        EffectiveDate = DateTime.Today
                    };
                    promotions = await AdvantageRepository.GetPromotionsAsync(new AdvantageFilter { EmpCode = emp.EmployeeCode });
                    successMessage = $"Loaded official details for {emp.EmployeeName}.";
                    errorMessage = null;
                    return;
                }
            }
            errorMessage = $"Employee with code '{promotionEmpCode}' not found.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private void OnPromotionDesignationSelected()
    {
        var d = designations.FirstOrDefault(x => x.DesignationId == promotionItem.PromDesignationId);
        if (d != null) promotionItem.PromDesignation = d.DesignationName;
    }

    private void OnPromotionGrossChanged()
    {
        promotionItem.PromotionAmount = Math.Max(0, promotionItem.PromGross - promotionItem.PreGross);
    }

    private void ResetPromotionForm()
    {
        promotionEmpCode = "";
        promotionItem = new PromotionItem();
        successMessage = null;
        errorMessage = null;
    }

    private async Task SavePromotion()
    {
        if (promotionItem.EmpId == 0)
        {
            errorMessage = "Please search and select an employee first.";
            return;
        }
        if (promotionItem.PromDesignationId == 0)
        {
            errorMessage = "Please select the promoted designation.";
            return;
        }
        try
        {
            await AdvantageRepository.SavePromotionAsync(promotionItem);
            successMessage = $"Promotion confirmed! {promotionItem.EmpName} promoted to {promotionItem.PromDesignation} with gross ৳ {promotionItem.PromGross:N0}.";
            promotions = await AdvantageRepository.GetPromotionsAsync(new AdvantageFilter { EmpCode = promotionItem.EmpCode });
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

