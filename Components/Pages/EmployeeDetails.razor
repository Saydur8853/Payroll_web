@page "/EmployeeDetails"
@inject EmployeeRepository EmployeeRepository
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using TG.Payroll.Web.Models
@using TG.Payroll.Web.Services

<div class="emp-page-container emp-status-page">
    <!-- Header Section -->
    <header class="emp-status-clean-header">
        <div class="emp-header-left">
            <div class="emp-badge-category">
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                <span>WORKFORCE DIRECTORY</span>
            </div>
            <h1 class="emp-clean-title">Employee Details</h1>
            <p class="emp-clean-subtitle">Comprehensive employee registry, placements, departmental breakdown, service tenures, and compensation.</p>
        </div>
        
        <div class="emp-header-right">
            @if (hasLoaded && totalCount > 0)
            {
                <div class="emp-total-counter-pill">
                    <span class="pill-dot"></span>
                    <span class="pill-text">Total: <strong>@totalCount.ToString("N0")</strong></span>
                </div>
            }
            <button type="button" class="emp-btn emp-btn-outline" @onclick="ExportToCsvAsync" disabled="@(isExporting || !hasLoaded || employees.Count == 0)">
                @if (isExporting)
                {
                    <span class="emp-spinner-dot"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    <span>Export CSV</span>
                }
            </button>
            <a href="/EmployeeInformation" class="emp-btn emp-btn-primary">
                <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                <span>Add / Edit</span>
            </a>
        </div>
    </header>

    <!-- Filters Section -->
    <section class="emp-card emp-status-filter-card">
        <div class="emp-status-filter-grid">
            <div class="emp-field">
                <label class="emp-label">Unit</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="filter.UnitId">
                        <option value="">All Units</option>
                        @foreach (var u in lookups.Units)
                        {
                            <option value="@u.Id">@u.Name</option>
                        }
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field">
                <label class="emp-label">Department</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="filter.DepartmentId">
                        <option value="">All Departments</option>
                        @foreach (var d in lookups.Departments)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field">
                <label class="emp-label">Category</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="filter.CategoryId">
                        <option value="">All Categories</option>
                        @foreach (var c in lookups.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field">
                <label class="emp-label">Status</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="filter.Status">
                        <option value="Active">Active</option>
                        <option value="Close">Close</option>
                        <option value="Maternity">Maternity</option>
                        <option value="ALL">All Statuses</option>
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field emp-field-search">
                <label class="emp-label">Search</label>
                <div class="emp-search-input-wrap">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                    <input type="text" class="emp-input" placeholder="Code, Name, ERP, Mobile, NID..." @bind="filter.Search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>
            </div>

            <div class="emp-field emp-field-actions">
                <label class="emp-label">&nbsp;</label>
                <div class="emp-filter-btns-wrap">
                    <button type="button" class="emp-btn emp-btn-primary emp-btn-search" @onclick="ApplyFilterAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="emp-spinner-dot"></span>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                            <span>Filter</span>
                        }
                    </button>
                    <button type="button" class="emp-btn emp-btn-secondary" @onclick="ResetFilter" title="Reset Filters">Clear</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Employees Data Table Section -->
    <section class="emp-card emp-status-table-card">
        <div class="emp-status-table-header">
            <div class="table-header-left">
                <h3>
                    @if (hasLoaded)
                    {
                        <span>Employees Registry (@totalCount.ToString("N0") Total)</span>
                    }
                    else
                    {
                        <span>Employee Details Directory</span>
                    }
                </h3>
            </div>
            <div class="table-header-right">
                @if (hasLoaded && totalCount > 0)
                {
                    <span style="font-size:12px; color:#64748b; font-weight:500;">
                        Page @filter.Page of @TotalPages
                    </span>
                }
            </div>
        </div>

        <div class="emp-status-table-wrap">
            <table class="emp-status-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">Emp Code</th>
                        <th style="width: 190px;">Employee Name</th>
                        <th style="width: 150px;">Bangla Name</th>
                        <th style="width: 150px;">Department</th>
                        <th style="width: 160px;">Designation</th>
                        <th style="width: 140px;">Section / Line</th>
                        <th style="width: 80px;">Shift</th>
                        <th style="width: 105px;">Joining Date</th>
                        <th style="width: 110px;">Age / LOS</th>
                        <th style="width: 110px; text-align: right;">Gross</th>
                        <th style="width: 115px;">Contact No</th>
                        <th class="col-center" style="width: 80px;">Status</th>
                        <th class="col-center" style="width: 60px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="13" class="table-loading-cell">
                                <div class="table-spinner"></div>
                                <span>Loading employee records from database...</span>
                            </td>
                        </tr>
                    }
                    else if (!hasLoaded)
                    {
                        <tr>
                            <td colspan="13" class="table-loading-cell" style="padding: 48px 16px;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:42px; height:42px; margin-bottom:10px; color:#94a3b8;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <div style="font-weight: 700; color: #334155; font-size: 15px; margin-bottom: 4px;">Ready to Search Employees</div>
                                <div style="color: #64748b; font-size: 13px;">Select filters above and click "Filter" to view employee records.</div>
                            </td>
                        </tr>
                    }
                    else if (employees.Count == 0)
                    {
                        <tr>
                            <td colspan="13" class="table-loading-cell" style="padding: 48px 16px;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:42px; height:42px; margin-bottom:10px; color:#94a3b8;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                <div style="font-weight: 700; color: #334155; font-size: 15px; margin-bottom: 4px;">No Employee Records Found</div>
                                <div style="color: #64748b; font-size: 13px;">Try adjusting your search query or selecting a different Department / Unit.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in employees)
                        {
                            <tr>
                                <td>
                                    <span class="emp-code-badge">@emp.EmployeeCode</span>
                                    @if (!string.IsNullOrWhiteSpace(emp.ErpCode))
                                    {
                                        <span class="emp-erp-tag">@emp.ErpCode</span>
                                    }
                                </td>
                                <td>
                                    <strong class="emp-name-main">@emp.EmployeeName</strong>
                                    <div class="emp-meta-sub">@emp.UnitName</div>
                                </td>
                                <td>
                                    <span class="emp-bangla-text">@(string.IsNullOrWhiteSpace(emp.BanglaEmployeeName) ? "-" : emp.BanglaEmployeeName)</span>
                                </td>
                                <td>@emp.DepartmentName</td>
                                <td>
                                    <strong>@emp.DesignationName</strong>
                                    @if (!string.IsNullOrWhiteSpace(emp.EmployeeGrade))
                                    {
                                        <span class="emp-grade-pill">Gr: @emp.EmployeeGrade</span>
                                    }
                                </td>
                                <td>
                                    <div>@emp.SectionName</div>
                                    @if (!string.IsNullOrWhiteSpace(emp.LineName))
                                    {
                                        <div class="emp-meta-sub">Line: @emp.LineName</div>
                                    }
                                </td>
                                <td>@emp.ShiftName</td>
                                <td>@(emp.DateOfJoining?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td>
                                    <div>@CalculateAge(emp.DateOfBirth)</div>
                                    <div class="emp-meta-sub">LOS: @CalculateLos(emp.DateOfJoining)</div>
                                </td>
                                <td style="text-align: right;">
                                    <strong style="color:#059669;">৳ @emp.Gross.ToString("N0")</strong>
                                </td>
                                <td>
                                    <span>@(string.IsNullOrWhiteSpace(emp.ContactNo) ? "-" : emp.ContactNo)</span>
                                </td>
                                <td class="col-center">
                                    <span class="emp-status-pill @emp.EmployeeStatus.ToLowerInvariant()">@emp.EmployeeStatus</span>
                                </td>
                                <td class="col-center">
                                    <a href="/EmployeeInformation?empCode=@emp.EmployeeCode" class="emp-btn-action" title="View / Edit Profile">
                                        <svg viewBox="0 0 20 20" fill="currentColor" style="width:14px;height:14px"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Toolbar -->
        @if (hasLoaded && totalCount > 0)
        {
            <div class="emp-pagination-bar">
                <div class="emp-page-info">
                    Showing @(((filter.Page - 1) * filter.PageSize) + 1) to @(Math.Min(filter.Page * filter.PageSize, totalCount)) of <strong>@totalCount.ToString("N0")</strong> records
                </div>
                <div class="emp-page-controls">
                    <button type="button" class="emp-page-btn" disabled="@(filter.Page <= 1)" @onclick="() => GoToPageAsync(filter.Page - 1)">&laquo; Prev</button>
                    <span class="emp-page-indicator">Page @filter.Page of @TotalPages</span>
                    <button type="button" class="emp-page-btn" disabled="@(filter.Page >= TotalPages)" @onclick="() => GoToPageAsync(filter.Page + 1)">Next &raquo;</button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private EmployeeDetailFilter filter = new();
    private List<EmployeeDetailItem> employees = [];
    private EmployeeLookups lookups = new();
    private int totalCount = 0;
    private bool isLoading = false;
    private bool hasLoaded = false;
    private bool isExporting = false;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / filter.PageSize));

    protected override async Task OnInitializedAsync()
    {
        lookups = await EmployeeRepository.GetLookupsAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        hasLoaded = true;
        try
        {
            var res = await EmployeeRepository.GetEmployeeDetailsPagedAsync(filter);
            employees = res.Items;
            totalCount = res.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilterAsync()
    {
        filter.Page = 1;
        await LoadDataAsync();
    }

    private void ResetFilter()
    {
        filter = new EmployeeDetailFilter();
        employees.Clear();
        totalCount = 0;
        hasLoaded = false;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilterAsync();
        }
    }

    private async Task GoToPageAsync(int p)
    {
        if (p < 1 || p > TotalPages) return;
        filter.Page = p;
        await LoadDataAsync();
    }

    private async Task ExportToCsvAsync()
    {
        isExporting = true;
        try
        {
            var exportFilter = new EmployeeDetailFilter
            {
                Search = filter.Search,
                UnitId = filter.UnitId,
                CategoryId = filter.CategoryId,
                DepartmentId = filter.DepartmentId,
                SectionId = filter.SectionId,
                DesignationId = filter.DesignationId,
                ShiftId = filter.ShiftId,
                Status = filter.Status,
                Page = 1,
                PageSize = 10000
            };
            var res = await EmployeeRepository.GetEmployeeDetailsPagedAsync(exportFilter);
            
            var exportItems = res.Items.Select(e => new EmployeeExportItem
            {
                EmployeeCode = e.EmployeeCode,
                EmployeeName = e.EmployeeName,
                BanglaEmployeeName = e.BanglaEmployeeName,
                ErpCode = e.ErpCode,
                UnitName = e.UnitName,
                CategoryName = e.CategoryName,
                DepartmentName = e.DepartmentName,
                SectionName = e.SectionName,
                LineName = e.LineName,
                DesignationName = e.DesignationName,
                ShiftName = e.ShiftName,
                SalaryRuleName = e.SalaryRuleName,
                FloorName = e.FloorName,
                DateOfJoining = e.DateOfJoining,
                DateOfBirth = e.DateOfBirth,
                Gross = e.Gross,
                EmployeeStatus = e.EmployeeStatus,
                Gender = e.Gender,
                Religion = e.Religion,
                MaritalStatus = e.MaritalStatus,
                BloodGroup = e.BloodGroup,
                NationalId = e.NationalId,
                ContactNo = e.ContactNo,
                Email = e.Email,
                FatherName = e.FatherName,
                MotherName = e.MotherName,
                SpouseName = e.SpouseName,
                PresentVillage = e.PresentAddress,
                PermanentVillage = e.PermanentAddress,
                EmployeeGrade = e.EmployeeGrade
            }).ToList();

            var csv = EmployeeCsvHelper.BuildExportCsv(exportItems);
            var bytes = EmployeeCsvHelper.GetUtf8BomBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Employee_Details_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "text/csv;charset=utf-8;");
        }
        finally
        {
            isExporting = false;
        }
    }

    private string CalculateAge(DateTime? dob)
    {
        if (!dob.HasValue) return "-";
        var today = DateTime.Today;
        var age = today.Year - dob.Value.Year;
        if (dob.Value.Date > today.AddYears(-age)) age--;
        return $"{age} Yrs";
    }

    private string CalculateLos(DateTime? doj)
    {
        if (!doj.HasValue) return "-";
        var today = DateTime.Today;
        var months = (today.Year - doj.Value.Year) * 12 + today.Month - doj.Value.Month;
        if (today.Day < doj.Value.Day) months--;
        var yrs = months / 12;
        var m = months % 12;
        return yrs > 0 ? $"{yrs}y {m}m" : $"{m}m";
    }
}
