    private async Task OpenCharDrawerAsync()
    {
        if (string.IsNullOrWhiteSpace(employee.EmployeeCode)) return;
        showCharDrawer = true;
        charCertificates = await EmployeeRepository.GetCharacterCertificatesAsync(employee.EmployeeCode, employee.DateOfJoining);
    }

    private void CloseCharDrawer() => showCharDrawer = false;

    private void SelectRating(CharacterCertificateItem item, string rating)
    {
        if (!canEdit)
        {
            OpenPasswordDialog();
            return;
        }
        item.Rating = rating;
        StateHasChanged();
    }

    private static bool IsRatingMatch(string? current, string target)
    {
        if (string.IsNullOrWhiteSpace(current)) return false;
        current = current.Trim();
        if (string.Equals(current, target, StringComparison.OrdinalIgnoreCase)) return true;

        if (target.Equals("Satisfactory", StringComparison.OrdinalIgnoreCase) || target == "সন্তোষজনক")
        {
            return current.Equals("Satisfactory", StringComparison.OrdinalIgnoreCase)
                || current.Equals("Good", StringComparison.OrdinalIgnoreCase)
                || current.Equals("S", StringComparison.OrdinalIgnoreCase)
                || current == "1"
                || (current.Contains("সন্তোষ") && !current.Contains("মধ্যম") && !current.Contains("অসন্তোষ"))
                || current.StartsWith("?") || current.Contains("???");
        }

        if (target.Equals("Moderate", StringComparison.OrdinalIgnoreCase) || target.Contains("মধ্যম"))
        {
            return current.Equals("Moderate", StringComparison.OrdinalIgnoreCase)
                || current.Equals("Medium", StringComparison.OrdinalIgnoreCase)
                || current.Equals("Average", StringComparison.OrdinalIgnoreCase)
                || current.Equals("M", StringComparison.OrdinalIgnoreCase)
                || current == "2"
                || current.Contains("মধ্যম");
        }

        if (target.Equals("Unsatisfactory", StringComparison.OrdinalIgnoreCase) || target == "অসন্তোষজনক")
        {
            return current.Equals("Unsatisfactory", StringComparison.OrdinalIgnoreCase)
                || current.Equals("Poor", StringComparison.OrdinalIgnoreCase)
                || current.Equals("Bad", StringComparison.OrdinalIgnoreCase)
                || current.Equals("U", StringComparison.OrdinalIgnoreCase)
                || current == "3"
                || current.Contains("অসন্তোষ");
        }

        return false;
    }

    private static string GetStatusClass(string? status) => (status?.Trim().ToLowerInvariant()) switch
