    private async Task SaveCharCertificatesAsync()
    {
        if (!canEdit)
        {
            OpenPasswordDialog();
            return;
        }

        if (string.IsNullOrWhiteSpace(employee.EmployeeCode) || employee.EmployeeId <= 0) return;
        isSavingChar = true;
        try
        {
            var userId = int.TryParse(HttpContextAccessor.HttpContext?.Session.GetString("UserId"), out var value) ? value : 0;
            var count = await EmployeeRepository.SaveCharacterCertificatesAsync(employee.EmployeeCode, employee.EmployeeId, charCertificates, userId);
            ShowToast($"চারিত্রিক মূল্যায়ন সংরক্ষিত ও আপডেট হয়েছে ({count} টি রেকর্ড)।");
            CloseCharDrawer();
        }
        catch (Exception ex)
        {
            ShowToast($"সংরক্ষণে সমস্যা: {ex.Message}");
        }
        finally
        {
            isSavingChar = false;
        }
    }

    private void OpenPasswordDialog()
    {
        verificationPassword = string.Empty;
        passwordError = null;
        showPasswordDialog = true;
