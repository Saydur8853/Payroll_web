    private bool cropNeedsInit;

    private async Task PhotoSelected(InputFileChangeEventArgs args) => await StartCropAsync(args.File, "photo");
    private async Task SignatureSelected(InputFileChangeEventArgs args) => await StartCropAsync(args.File, "signature");

    private async Task StartCropAsync(IBrowserFile file, string target)
    {
        var bytes = await ReadImageAsync(file);
        if (bytes is null) return;
        cropSource = ImageSource(bytes);
        cropTarget = target;
        cropNeedsInit = true;
        showCropDialog = true;
    }

    private void TriggerCropExisting(string target)
    {
        var bytes = target == "signature" ? employee.Signature : employee.Photo;
        if (bytes is null || bytes.Length == 0) return;
        cropSource = ImageSource(bytes);
        cropTarget = target;
        cropNeedsInit = true;
        showCropDialog = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showCropDialog && cropNeedsInit && cropSource is not null)
        {
            cropNeedsInit = false;
            await Task.Delay(60);
            try
            {
                await JS.InvokeVoidAsync("sdsCropper.init", "sds-crop-canvas", cropSource, cropTarget);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to initialize sdsCropper canvas");
            }
        }
    }

    private void RemoveImage(string target)
    {
        if (target == "signature") employee.Signature = null;
        else employee.Photo = null;
        ShowToast(target == "signature" ? "Signature removed." : "Photo removed.");
    }

    private void CancelCrop()
    {
        showCropDialog = false;
        cropSource = null;
        cropNeedsInit = false;
    }

    private async Task ApplyCrop()
    {
        if (cropSource is null) return;
        try
        {
            var result = await JS.InvokeAsync<string>("sdsCropper.getCroppedResult");
            if (!string.IsNullOrEmpty(result))
            {
                var comma = result.IndexOf(',');
                var bytes = Convert.FromBase64String(comma >= 0 ? result[(comma + 1)..] : result);
                if (cropTarget == "photo") employee.Photo = bytes;
                else employee.Signature = bytes;
                CancelCrop();
                ShowToast(cropTarget == "photo" ? "Photo cropped and updated." : "Signature cropped and updated.");
            }
            else
            {
                CancelCrop();
            }
        }
        catch (Exception ex)
        {
            assetError = $"Cropping failed: {ex.Message}";
            CancelCrop();
        }
    }

    private async Task<byte[]?> ReadImageAsync(IBrowserFile file)
    {
        assetError = null;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            assetError = "Please select a valid image file (JPG, PNG, WebP).";
            return null;
        }

        try
        {
            await using var input = file.OpenReadStream(2_000_000);
            using var output = new MemoryStream();
            await input.CopyToAsync(output);
            return output.ToArray();
        }
        catch
        {
            assetError = "Image file must be smaller than 2 MB.";
            return null;
        }
    }

    private static string ImageSource(byte[] bytes) => $"data:{ImageMimeType(bytes)};base64,{Convert.ToBase64String(bytes)}";
    private static string ImageMimeType(byte[] bytes) =>
        bytes.Length >= 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47 ? "image/png" :
        bytes.Length >= 12 && bytes[0] == 0x52 && bytes[1] == 0x49 && bytes[8] == 0x57 && bytes[9] == 0x45 ? "image/webp" : "image/jpeg";

    private async Task Save()
    {
        if (isEdit && !isUnlocked)
        {
            OpenPasswordDialog();
            return;
        }

        pageError = null;
        if (!employee.EmployeeStatus.Equals("Active", StringComparison.OrdinalIgnoreCase) && employee.CloseDate is null)
        {
            pageError = "Close / Release Date is required for an inactive employee.";
            return;
        }

        if (employee.EmployeeStatus.Equals("Active", StringComparison.OrdinalIgnoreCase))
        {
            employee.CloseDate = null;
            employee.StatusReason = string.Empty;
        }

        try
        {
            var userId = int.TryParse(HttpContextAccessor.HttpContext?.Session.GetString("UserId"), out var value) ? value : 0;
            if (userId == 0)
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            var assignNextEmployeeCode = !isEdit && employee.EmployeeCode == autoSuggestedEmployeeCode;
            var id = await EmployeeRepository.SaveEmployeeAsync(employee, userId, assignNextEmployeeCode);
            employee = await EmployeeRepository.GetEmployeeAsync(id) ?? employee;
            searchEmployeeCode = employee.EmployeeCode;
            autoSuggestedEmployeeCode = null;
            saved = true;
            isUnlocked = false;
            await LoadData();
            await LoadLeaveSummaryAsync();
            ShowToast("Employee record saved successfully.");
        }
        catch (Exception ex)
        {
            pageError = ex is InvalidOperationException ? ex.Message : "Employee record could not be saved. Please check database logs.";
        }
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        toastLeaving = false;
        _ = ClearToastAfterDelayAsync(++toastVersion);
    }

    private async Task FadeEmployeeCodeWarningAfterDelayAsync(int version)
    {
        await Task.Delay(4500);
        if (version != employeeCodeWarningVersion) return;

        employeeCodeWarningLeaving = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(500);
        if (version != employeeCodeWarningVersion) return;

        employeeCodeTaken = false;
        employeeCodeWarningLeaving = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearToastAfterDelayAsync(int version)
    {
        await Task.Delay(4500);
        if (version != toastVersion) return;
        toastLeaving = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(400);
        if (version != toastVersion) return;
        toastMessage = null;
        toastLeaving = false;
        await InvokeAsync(StateHasChanged);
    }
}
