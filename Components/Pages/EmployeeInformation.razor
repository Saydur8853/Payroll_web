                        <strong>🔒 View Only (Locked)</strong>
                        <span>Employee is locked. To modify or delete evaluations, please unlock first.</span>
                    </div>
                    <button type="button" class="emp-btn emp-btn-unlock" @onclick="OpenPasswordDialog" style="padding: 5px 12px; font-size: 12px; white-space: nowrap;">
                        <svg viewBox="0 0 20 20" fill="currentColor" style="width:13px;height:13px"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
                        <span>Unlock</span>
                    </button>
                </div>
            }

            @if (charCertificates.Count == 0)
            {
                <div style="text-align: center; padding: 40px 20px; color: #64748b;">
                    <span>Loading certificate records...</span>
                </div>
            }
            else
            {
                @foreach (var item in charCertificates)
                {
                    <div class="emp-char-row @(!canEdit ? "is-disabled" : string.Empty)">
                        <div class="emp-char-row-header-wrap">
                            <span class="emp-char-row-header">@item.RecordDate.ToString("MMMM - yyyy")</span>
                            @if (!string.IsNullOrEmpty(item.Rating) || !string.IsNullOrEmpty(item.Remarks))
                            {
                                <button type="button"
                                        class="emp-btn-char-clear"
                                        @onclick="@(() => ClearCharRating(item))"
                                        title="Clear / Delete this month's evaluation">
                                    ✕ Clear (মুছুন)
                                </button>
                            }
                        </div>
                        <div class="emp-char-radios">
                            <button type="button"
                                    class="emp-char-rating-btn @(IsRatingMatch(item.Rating, "Satisfactory") ? "is-selected good" : string.Empty)"
                                    @onclick="@(() => SelectRating(item, "Satisfactory"))">
                                <span class="dot"></span>
                                <span>Satisfactory (সন্তোষজনক)</span>
                            </button>
                            <button type="button"
                                    class="emp-char-rating-btn @(IsRatingMatch(item.Rating, "Moderate") ? "is-selected medium" : string.Empty)"
                                    @onclick="@(() => SelectRating(item, "Moderate"))">
                                <span class="dot"></span>
                                <span>Moderate (মধ্যম)</span>
                            </button>
                            <button type="button"
                                    class="emp-char-rating-btn @(IsRatingMatch(item.Rating, "Unsatisfactory") ? "is-selected poor" : string.Empty)"
                                    @onclick="@(() => SelectRating(item, "Unsatisfactory"))">
                                <span class="dot"></span>
                                <span>Unsatisfactory (অসন্তোষজনক)</span>
                            </button>
                        </div>
                        <div class="emp-char-note-wrap">
                            <span class="emp-char-note-lbl">Remarks (মন্তব্য):</span>
                            <input type="text" class="emp-char-note-input" disabled="@(!canEdit)" placeholder="Notes / remarks..." @bind="item.Remarks" />
                        </div>
                    </div>
                }
            }
        </div>

        <footer class="emp-drawer-footer">
            <button type="button" class="emp-btn emp-btn-secondary" @onclick="CloseCharDrawer">Close</button>
            @if (!canEdit)
            {
                <button type="button" class="emp-btn emp-btn-unlock" @onclick="OpenPasswordDialog">
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:14px;height:14px"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
                    <span>Unlock to Edit</span>
                </button>
            }
            else
            {
                <button type="button" class="emp-btn emp-btn-primary" @onclick="SaveCharCertificatesAsync" disabled="@isSavingChar">
                    <span>@(isSavingChar ? "Saving..." : "Save Assessment (সংরক্ষণ করুন)")</span>
                </button>
            }
        </footer>
    </aside>
}

@code {
    private EmployeeModel employee = new();
    private string searchEmployeeCode = string.Empty;
    private EmployeeLookups lookups = new();
    private List<SalaryRuleDetail> salaryRuleDetails = [];
    private EmployeeLeaveSummary leaveSummary = new();
    private List<CharacterCertificateItem> charCertificates = [];
    private string? pageError;
    private string? assetError;
    private string? toastMessage;
    private string? passwordError;
    private string? cropSource;
    private string cropTarget = "photo";
    private string verificationPassword = string.Empty;
    private bool saved;
    private bool isUnlocked;
    private bool showPasswordDialog;
    private bool showCropDialog;
    private bool showCharDrawer;
    private bool isSavingChar;
    private bool toastLeaving;
    private bool showLockShake;
    private bool showUnlockHint;
    private bool employeeCodeTaken;
    private bool employeeCodeWarningLeaving;
    private string? autoSuggestedEmployeeCode;
    private int employeeCodeWarningVersion;
    private double unlockHintX;
    private double unlockHintY;
    private int toastVersion;

    private bool isEdit => employee.EmployeeId > 0;
    private bool canEdit => !isEdit || isUnlocked;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            lookups = await EmployeeRepository.GetLookupsAsync();
            salaryRuleDetails = await EmployeeRepository.GetSalaryRuleDetailsAsync();
            if (!isEdit) SetDefaults();
        }
        catch
        {
            pageError = "Employee lookup options could not be loaded from the database.";
        }
    }

    private void SetDefaults()
    {
        employee.UnitId = lookups.Units.FirstOrDefault()?.Id ?? 0;
        employee.CategoryId = lookups.Categories.FirstOrDefault()?.Id ?? 0;
        employee.DepartmentId = lookups.Departments.FirstOrDefault()?.Id ?? 0;
        employee.SectionId = lookups.Sections.FirstOrDefault()?.Id ?? 0;
        employee.LineId = lookups.Lines.FirstOrDefault()?.Id ?? 0;
        employee.DesignationId = lookups.Designations.FirstOrDefault()?.Id ?? 0;
        employee.ShiftId = lookups.Shifts.FirstOrDefault()?.Id ?? 0;
        employee.SalaryRuleId = lookups.SalaryRules.FirstOrDefault()?.Id ?? 0;
        employee.FloorId = lookups.Floors.FirstOrDefault()?.Id ?? 0;
    }

    private async Task LookupCodeManual()
    {
        autoSuggestedEmployeeCode = null;
        employeeCodeWarningVersion++;
        employeeCodeWarningLeaving = false;
        var code = (string.IsNullOrWhiteSpace(searchEmployeeCode) ? employee.EmployeeCode : searchEmployeeCode)?.Trim();
        if (string.IsNullOrWhiteSpace(code))
        {
            ShowToast("Please enter an employee code to search.");
            return;
        }

        saved = false;
        pageError = null;
        toastMessage = null;

        try
        {
            var found = await EmployeeRepository.GetEmployeeByCodeAsync(code);
            if (found is not null)
            {
                employee = found;
                searchEmployeeCode = found.EmployeeCode;
                employeeCodeTaken = true;
                _ = FadeEmployeeCodeWarningAfterDelayAsync(++employeeCodeWarningVersion);
                isUnlocked = false;
                await LoadLeaveSummaryAsync();
                ShowToast($"Employee found: {found.EmployeeName} ({found.EmployeeCode}). Unlock to edit.");
            }
            else
            {
                employee = new EmployeeModel { EmployeeCode = code };
                searchEmployeeCode = code;
                employeeCodeTaken = false;
                isUnlocked = false;
                leaveSummary = new EmployeeLeaveSummary();
                await LoadData();
                ShowToast($"Employee code '{code}' not found. You can enter details to register as new.");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            pageError = $"Search error: {ex.Message}";
        }
    }

    private async Task UpdateSearchEmployeeCode(ChangeEventArgs args)
    {
        employeeCodeWarningVersion++;
        employeeCodeWarningLeaving = false;
        var enteredValue = args.Value?.ToString() ?? string.Empty;
        searchEmployeeCode = new string(enteredValue.Where(char.IsAsciiDigit).ToArray());
        if (isEdit)
        {
            employeeCodeTaken = false;
            return;
        }

        employee.EmployeeCode = searchEmployeeCode;
        employeeCodeTaken = await EmployeeRepository.EmployeeCodeExistsAsync(searchEmployeeCode);
    }

    private async Task HandleEmployeeCodeKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await LookupCodeManual();
        }
    }

    private async Task LoadLeaveSummaryAsync()
    {
        if (employee.EmployeeId > 0)
        {
            leaveSummary = await EmployeeRepository.GetEmployeeLeaveSummaryAsync(
                employee.EmployeeId,
                employee.EmployeeCode,
                employee.DateOfJoining,
                employee.CloseDate);
        }
        else
        {
            leaveSummary = new EmployeeLeaveSummary();
        }
    }

    private static string CalculateAge(DateTime? dob)
    {
        if (dob is null || dob == DateTime.MinValue) return "N/A";
        var today = DateTime.Today;
        var birth = dob.Value;
        if (birth > today) return "0 Days";

        int years = today.Year - birth.Year;
        int months = today.Month - birth.Month;
        int days = today.Day - birth.Day;

        if (days < 0)
        {
            months--;
            var prevMonth = today.AddMonths(-1);
            days += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }
        if (months < 0)
        {
            years--;
            months += 12;
        }

        var parts = new List<string>();
        if (years > 0) parts.Add($"{years} Yrs");
        if (months > 0) parts.Add($"{months} Mon");
        if (days > 0 || parts.Count == 0) parts.Add($"{days} Days");

        return string.Join(", ", parts);
    }

    private static string CalculateLos(DateTime joinDate, DateTime? closeDate)
    {
        if (joinDate == DateTime.MinValue) return "N/A";
        var end = closeDate ?? DateTime.Today;
        if (joinDate > end) return "0 Days";

        int years = end.Year - joinDate.Year;
        int months = end.Month - joinDate.Month;
        int days = end.Day - joinDate.Day;

        if (days < 0)
        {
            months--;
            var prevMonth = end.AddMonths(-1);
            days += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }
        if (months < 0)
        {
            years--;
            months += 12;
        }

        var parts = new List<string>();
        if (years > 0) parts.Add($"{years} Yrs");
        if (months > 0) parts.Add($"{months} Mon");
        if (days > 0 || parts.Count == 0) parts.Add($"{days} Days");

        return string.Join(", ", parts);
    }

    private decimal CalculateBasicSalary(decimal gross, int ruleId)
    {
        if (gross <= 0) return 0;
        var rule = salaryRuleDetails.FirstOrDefault(r => r.RuleId == ruleId);
        if (rule is null) return Math.Round(gross * 0.5m, 0);

        decimal allowances = rule.RuleMedical + rule.RuleTransport + rule.RuleFood;
        if (rule.RuleBasic == 40 || rule.RuleBasic == 50)
        {
            return Math.Round(gross * (rule.RuleBasic / 100m), 0);
        }
        if (rule.RuleHouseRent > 0)
        {
            decimal divisor = 1m + (rule.RuleHouseRent / 100m);
            return Math.Round((gross - allowances) / divisor, 0);
        }
        return Math.Round(gross * 0.5m, 0);
    }

    private void UpdateGrossSalary(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            employee.Gross = 0;
            return;
        }

        if (decimal.TryParse(rawValue, System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var gross))
        {
            employee.Gross = gross;
        }
    }

    private void CopyPresentToPermanent()
    {
        employee.PermanentVillage = employee.PresentVillage;
        employee.BanglaPermanentVillage = employee.BanglaPresentVillage;
        employee.PermanentPost = employee.PresentPost;
        employee.BanglaPermanentPost = employee.BanglaPresentPost;
