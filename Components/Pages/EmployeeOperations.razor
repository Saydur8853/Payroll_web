            </div>

            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" @onclick="CloseImportModal" disabled="@isImportSaving">Cancel</button>
                <button type="button" class="emp-btn emp-btn-primary" @onclick="ExecuteImportSaveAsync" disabled="@(isImportSaving || !HasParsedRowsToSave)">
                    @if (isImportSaving)
                    {
                        <span class="emp-spinner-dot"></span>
                        <span>Updating Database...</span>
                    }
                    else
                    {
                        <span>Apply & Save to Database</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private string activeTab = "status";
    private EmployeeLookups lookups = new();
    private string? toastMessage;

    // --- Bulk Import State ---
    private bool isImportModalOpen = false;
    private string importMode = "status";
    private string? selectedImportFileName;
    private string? importParseError;
    private bool isImportSaving = false;

    private List<BulkStatusImportRow> parsedStatusRows = [];
    private List<BulkPriorityImportRow> parsedPriorityRows = [];
    private List<BulkContactImportRow> parsedContactRows = [];

    private bool HasParsedRowsToSave => importMode switch
    {
        "status" => parsedStatusRows.Count > 0,
        "priority" => parsedPriorityRows.Count > 0,
        "contact" => parsedContactRows.Count > 0,
        _ => false
    };

    // --- Tab 1: Status State ---
    private EmployeeStatusFilter statusFilter = new() { UnitId = 0, DepartmentId = 0 };
    private List<EmployeeStatusItem> statusEmployees = [];
    private bool isStatusLoading = false;
    private bool hasStatusLoaded = false;
    private bool isStatusSaving = false;

    private bool HasStatusDirtyRows => statusEmployees.Any(e => e.IsEdited);
    private int StatusDirtyCount => statusEmployees.Count(e => e.IsEdited);

    // --- Tab 2: Priority State ---
    private List<EmployeePriorityItem> priorityEmployees = [];
    private int? priorityDeptId;
    private int? prioritySectionId;
    private int? priorityDesigId;
    private string prioritySearch = string.Empty;
    private bool isPriorityLoading = false;
    private bool hasPriorityLoaded = false;
    private bool isPrioritySaving = false;

    private bool HasPriorityUnsavedChanges => priorityEmployees.Any(e => e.Priority != e.InitialPriority);
    private int PriorityDirtyCount => priorityEmployees.Count(e => e.Priority != e.InitialPriority);

    // --- Tab 3: Contact State ---
    private List<EmployeeContactItem> contactEmployees = [];
    private int? contactDeptId;
    private int? contactSectionId;
    private string contactStatus = "Active";
    private string contactSearch = string.Empty;
    private int contactPage = 1;
    private int contactPageSize = 25;
    private int contactTotalCount = 0;
    private bool isContactLoading = false;
    private bool hasContactLoaded = false;
    private bool isContactExporting = false;

    private int ContactTotalPages => contactTotalCount == 0 ? 1 : (int)Math.Ceiling((double)contactTotalCount / contactPageSize);

    // Quick edit modal
    private EmployeeContactItem? editingContact;
    private string? editContactNo;
    private string? editEmail;
    private string? editBloodGroup;
    private string? editEmrgName;
    private string? editEmrgCell;
    private string? editNomineeCell;
    private string? editRefCell;
    private bool isSavingQuickEdit = false;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(TabQuery))
        {
            var cleanTab = TabQuery.Trim().ToLowerInvariant();
            if (cleanTab is "status" or "priority" or "contact")
            {
                activeTab = cleanTab;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        lookups = await EmployeeRepository.GetLookupsAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    // ================= Bulk Import / Export Handlers =================
    private void OpenImportModal(string mode)
    {
        importMode = mode;
        selectedImportFileName = null;
        importParseError = null;
        parsedStatusRows.Clear();
        parsedPriorityRows.Clear();
        parsedContactRows.Clear();
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
    }

    private async Task DownloadCurrentModeTemplate()
    {
        switch (importMode)
        {
            case "status":
                await DownloadStatusTemplate();
                break;
            case "priority":
                await DownloadPriorityTemplate();
                break;
            case "contact":
                await DownloadContactTemplate();
                break;
        }
    }

    private async Task DownloadStatusTemplate()
    {
        var csv = EmployeeCsvHelper.GenerateStatusTemplateCsv();
        var bytes = EmployeeCsvHelper.GetUtf8BomBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", "Bulk_Status_Template.csv", "text/csv;charset=utf-8;", base64);
        ShowToast("Status Template CSV downloaded.");
    }

    private async Task DownloadPriorityTemplate()
    {
        var csv = EmployeeCsvHelper.GeneratePriorityTemplateCsv();
        var bytes = EmployeeCsvHelper.GetUtf8BomBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", "Bulk_Priority_Template.csv", "text/csv;charset=utf-8;", base64);
        ShowToast("Priority Template CSV downloaded.");
    }

    private async Task DownloadContactTemplate()
    {
        var csv = EmployeeCsvHelper.GenerateContactTemplateCsv();
        var bytes = EmployeeCsvHelper.GetUtf8BomBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", "Bulk_Contact_Template.csv", "text/csv;charset=utf-8;", base64);
        ShowToast("Contact Template CSV downloaded.");
    }

    private async Task HandleImportCsvSelected(InputFileChangeEventArgs args)
    {
        importParseError = null;
        parsedStatusRows.Clear();
        parsedPriorityRows.Clear();
        parsedContactRows.Clear();

        var file = args.File;
        if (file is null) return;
        selectedImportFileName = file.Name;

        try
        {
            using var stream = file.OpenReadStream(15_000_000);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var content = await reader.ReadToEndAsync();

            var parsedGrid = EmployeeCsvHelper.ParseCsv(content);
            if (parsedGrid.Count < 2)
            {
                importParseError = "The CSV file must contain a header row and at least one data row.";
                return;
            }

            var headers = parsedGrid[0];
            var headerMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            for (int i = 0; i < headers.Count; i++)
            {
                var h = EmployeeCsvHelper.NormalizeHeaderName(headers[i]);
                if (!string.IsNullOrEmpty(h) && !headerMap.ContainsKey(h))
                {
                    headerMap[h] = i;
                }
            }

            for (int r = 1; r < parsedGrid.Count; r++)
            {
                var rowData = parsedGrid[r];
                if (rowData.Count == 0 || rowData.All(string.IsNullOrWhiteSpace)) continue;

                var empCode = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Emp Code", "EmployeeCode", "Code", "EMP_CODE");
                if (string.IsNullOrWhiteSpace(empCode)) continue;

                if (importMode == "status")
                {
                    var grossStr = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Gross", "GrossSalary", "Salary", "BASIC");
                    decimal.TryParse(grossStr.Replace(",", ""), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var gross);

                    var otStr = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "OverTime", "OT", "OVER_TIME");
                    var isOt = otStr.Equals("Y", StringComparison.OrdinalIgnoreCase) || otStr.Equals("Yes", StringComparison.OrdinalIgnoreCase) || otStr == "1";

                    var trStr = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Transport", "TR", "TRANSPORT");
                    var isTr = trStr.Equals("Y", StringComparison.OrdinalIgnoreCase) || trStr.Equals("Yes", StringComparison.OrdinalIgnoreCase) || trStr == "1";

                    var standStr = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Transport Stand", "TransportStand", "Stand", "TRANSPORT_STAND");
                    var dojStr = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "DOJ", "Joining Date", "DateOfJoining", "DATE_OF_JOINING");
                    DateTime? doj = null;
                    if (EmployeeCsvHelper.TryParseFlexibleDate(dojStr, out var parsedDoj)) doj = parsedDoj;

                    parsedStatusRows.Add(new BulkStatusImportRow
                    {
                        RowIndex = r,
                        EmployeeCode = empCode,
                        Gross = gross,
                        OverTime = isOt ? "Y" : "N",
                        Transport = isTr ? "Y" : "N",
                        TransportStand = standStr,
                        DateOfJoining = doj
                    });
                }
                else if (importMode == "priority")
                {
                    var priorityStr = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Priority", "Order", "PRIORITY");
                    int.TryParse(priorityStr, out var priority);
                    if (priority <= 0) priority = r;

                    parsedPriorityRows.Add(new BulkPriorityImportRow
                    {
                        RowIndex = r,
                        EmployeeCode = empCode,
                        Priority = priority
                    });
                }
                else if (importMode == "contact")
                {
                    var phone = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Contact No", "ContactNo", "Mobile", "CONTACT_NO", "Phone");
                    var email = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Email", "E_MAIL", "EmailAddress");
                    var bg = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Blood Group", "BloodGroup", "BLOOD_GROUP", "BG");
                    var emrgName = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Emergency Contact Person", "Emergency Contact", "EMRG_CONTACT_NAME", "EmergencyName");
                    var emrgCell = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Emergency Cell", "EmergencyCell", "EMRG_CELL_NO", "EmergencyMobile");
                    var nomCell = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Nominee Cell", "NomineeCell", "NOMINEE_CELL_NO");
                    var refCell = EmployeeCsvHelper.ExtractCsvVal(rowData, headerMap, "Reference Cell", "Ref Cell", "REF_CELL_NO");

                    parsedContactRows.Add(new BulkContactImportRow
                    {
                        RowIndex = r,
                        EmployeeCode = empCode,
                        ContactNo = phone,
                        Email = email,
                        BloodGroup = bg,
                        EmergencyContactName = emrgName,
                        EmergencyCellNo = emrgCell,
                        NomineeCellNo = nomCell,
                        RefCellNo = refCell
                    });
                }
            }

            if ((importMode == "status" && parsedStatusRows.Count == 0) ||
                (importMode == "priority" && parsedPriorityRows.Count == 0) ||
                (importMode == "contact" && parsedContactRows.Count == 0))
            {
                importParseError = "Could not map any valid rows. Please check if the 'Emp Code' header is present.";
            }
        }
        catch (Exception ex)
        {
            importParseError = "Failed to parse CSV file: " + ex.Message;
        }
    }

    private async Task ExecuteImportSaveAsync()
    {
        isImportSaving = true;
        try
        {
            if (importMode == "status")
            {
                var items = parsedStatusRows.Select(r => new EmployeeStatusItem
                {
                    EmployeeCode = r.EmployeeCode,
                    Gross = r.Gross,
                    OverTime = r.OverTime,
                    Transport = r.Transport,
                    TransportStand = r.TransportStand,
                    DateOfJoining = r.DateOfJoining,
                    IsEdited = true
                }).ToList();

                var count = await EmployeeRepository.BulkUpdateEmployeeStatusAsync(items, 1);
                ShowToast($"Successfully imported and updated {count} status records in Oracle!");
                CloseImportModal();
                if (hasStatusLoaded) await SearchStatusAsync();
            }
            else if (importMode == "priority")
            {
                var payload = parsedPriorityRows.Select(r => (r.EmployeeCode, r.Priority)).ToList();
                var count = await EmployeeRepository.BulkUpdateEmployeePrioritiesByCodeAsync(payload, 1);
                ShowToast($"Successfully imported and updated priorities for {count} employees!");
                CloseImportModal();
                if (hasPriorityLoaded) await LoadPriorityAsync();
            }
            else if (importMode == "contact")
            {
                var payload = parsedContactRows.Select(r => (
                    r.EmployeeCode,
                    (string?)r.ContactNo,
                    (string?)r.Email,
                    (string?)r.EmergencyContactName,
                    (string?)r.EmergencyCellNo,
                    (string?)r.NomineeCellNo,
                    (string?)r.RefCellNo,
                    (string?)r.BloodGroup
                )).ToList();

                var count = await EmployeeRepository.BulkUpdateEmployeeContactsByCodeAsync(payload, 1);
                ShowToast($"Successfully imported contacts & blood groups for {count} employees!");
                CloseImportModal();
                if (hasContactLoaded) await SearchContactsAsync();
            }
        }
        catch (Exception ex)
        {
            ShowToast("Bulk import failed: " + ex.Message);
        }
        finally
        {
            isImportSaving = false;
        }
    }

