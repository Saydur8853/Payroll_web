    private async Task OnStatusKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchStatusAsync();
    }

    private void CheckStatusEdited(EmployeeStatusItem item)
    {
        item.IsEdited = item.Gross != item.OriginalGross 
                     || item.OverTime != item.OriginalOverTime 
                     || item.Transport != item.OriginalTransport 
                     || item.TransportStand != item.OriginalTransportStand;
    }

    private void ToggleStatusOt(EmployeeStatusItem item, ChangeEventArgs e)
    {
        item.OverTime = (bool)(e.Value ?? false) ? "Y" : "N";
        CheckStatusEdited(item);
    }

    private void ToggleStatusTransport(EmployeeStatusItem item, ChangeEventArgs e)
    {
        item.Transport = (bool)(e.Value ?? false) ? "Y" : "N";
        CheckStatusEdited(item);
    }

    private async Task SaveStatusSingleRowAsync(EmployeeStatusItem item)
    {
        var count = await EmployeeRepository.BulkUpdateEmployeeStatusAsync(new[] { item }, 1);
        if (count > 0)
        {
            item.OriginalGross = item.Gross;
            item.OriginalOverTime = item.OverTime;
            item.OriginalTransport = item.Transport;
            item.OriginalTransportStand = item.TransportStand;
            item.IsEdited = false;
            ShowToast($"Saved changes for {item.EmployeeName} ({item.EmployeeCode})");
        }
    }

    private async Task SaveStatusAllChangesAsync()
    {
        var dirty = statusEmployees.Where(e => e.IsEdited).ToList();
        if (dirty.Count == 0) return;

        isStatusSaving = true;
        try
        {
            var count = await EmployeeRepository.BulkUpdateEmployeeStatusAsync(dirty, 1);
            foreach (var item in dirty)
            {
                item.OriginalGross = item.Gross;
                item.OriginalOverTime = item.OverTime;
                item.OriginalTransport = item.Transport;
                item.OriginalTransportStand = item.TransportStand;
                item.IsEdited = false;
            }
            ShowToast($"Successfully updated {count} employee records in database.");
        }
        finally
        {
            isStatusSaving = false;
        }
    }

    private async Task ExportStatusCsv()
    {
        if (statusEmployees.Count == 0) return;
        var csv = EmployeeCsvHelper.BuildStatusExportCsv(statusEmployees);
        var bytes = EmployeeCsvHelper.GetUtf8BomBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", $"Workforce_Status_{DateTime.Now:yyyyMMdd_HHmm}.csv", "text/csv;charset=utf-8;", base64);
        ShowToast("Workforce status CSV exported.");
    }

