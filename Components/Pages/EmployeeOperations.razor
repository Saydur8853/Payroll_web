    private void MovePriorityUp(int index)
    {
        if (index <= 0 || index >= priorityEmployees.Count) return;
        var cur = priorityEmployees[index];
        var prev = priorityEmployees[index - 1];
        var temp = cur.Priority;
        cur.Priority = prev.Priority;
        prev.Priority = temp;
        priorityEmployees[index] = prev;
        priorityEmployees[index - 1] = cur;
    }

    private void MovePriorityDown(int index)
    {
        if (index < 0 || index >= priorityEmployees.Count - 1) return;
        var cur = priorityEmployees[index];
        var next = priorityEmployees[index + 1];
        var temp = cur.Priority;
        cur.Priority = next.Priority;
        next.Priority = temp;
        priorityEmployees[index] = next;
        priorityEmployees[index + 1] = cur;
    }

    private void AutoSequencePriorities()
    {
        for (int i = 0; i < priorityEmployees.Count; i++)
        {
            priorityEmployees[i].Priority = (i + 1);
        }
    }

    private async Task SavePriorityChangesAsync()
    {
        var dirty = priorityEmployees.Where(e => e.Priority != e.InitialPriority).ToList();
        if (dirty.Count == 0) return;

        isPrioritySaving = true;
        try
        {
            var updatePayload = dirty.Select(e => (e.EmployeeId, e.Priority)).ToList();
            await EmployeeRepository.SaveEmployeePrioritiesAsync(updatePayload);

            foreach (var item in dirty)
            {
                item.InitialPriority = item.Priority;
            }

            ShowToast($"Successfully updated priority hierarchy for {updatePayload.Count} employees.");
        }
        finally
        {
            isPrioritySaving = false;
        }
    }

