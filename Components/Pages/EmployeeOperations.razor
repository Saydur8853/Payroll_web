                    </div>
                }

                <!-- Preview Area -->
                @if (importMode == "status" && parsedStatusRows.Count > 0)
                {
                    <div style="margin-bottom:0.5rem; display:flex; justify-content:space-between; align-items:center;">
                        <strong>Parsed Rows Preview (@parsedStatusRows.Count records ready)</strong>
                        <span style="font-size:12px; color:#16a34a; font-weight:700;">✅ Valid Structure</span>
                    </div>
                    <div style="max-height: 240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px;">
