                                {
                                    <tr>
                                        <td>@r.RowIndex</td>
                                        <td><strong>@r.EmployeeCode</strong></td>
                                        <td>৳@r.Gross.ToString("N0")</td>
                                        <td><span class="emp-status-badge @(r.OverTime == "Y" ? "active" : "")">@r.OverTime</span></td>
                                        <td><span class="emp-status-badge @(r.Transport == "Y" ? "active" : "")">@r.Transport</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(r.TransportStand) ? "—" : r.TransportStand)</td>
                                        <td>@(r.DateOfJoining?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
