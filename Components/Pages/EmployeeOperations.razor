                    </div>
                    @if (parsedStatusRows.Count > 25)
                    {
                        <div style="color:#64748b; font-size:11.5px; margin-top:4px; text-align:right;">Showing first 25 of @parsedStatusRows.Count rows</div>
                    }
                }
                else if (importMode == "priority" && parsedPriorityRows.Count > 0)
                {
                    <div style="margin-bottom:0.5rem; display:flex; justify-content:space-between; align-items:center;">
                        <strong>Parsed Priorities Preview (@parsedPriorityRows.Count records ready)</strong>
                        <span style="font-size:12px; color:#16a34a; font-weight:700;">✅ Valid Structure</span>
                    </div>
                    <div style="max-height: 240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px;">
                        <table class="emp-status-table" style="font-size:12.5px;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Emp Code</th>
                                    <th>Priority Sequence</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in parsedPriorityRows.Take(25))
                                {
                                    <tr>
                                        <td>@r.RowIndex</td>
                                        <td><strong>@r.EmployeeCode</strong></td>
                                        <td><span class="emp-code-badge">@r.Priority</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (importMode == "contact" && parsedContactRows.Count > 0)
                {
                    <div style="margin-bottom:0.5rem; display:flex; justify-content:space-between; align-items:center;">
                        <strong>Parsed Contacts Preview (@parsedContactRows.Count records ready)</strong>
                        <span style="font-size:12px; color:#16a34a; font-weight:700;">✅ Valid Structure</span>
                    </div>
                    <div style="max-height: 240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px;">
                        <table class="emp-status-table" style="font-size:12.5px;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Emp Code</th>
                                    <th>Contact No</th>
                                    <th>Email</th>
                                    <th>Blood Group</th>
                                    <th>Emergency Name</th>
                                    <th>Emergency Cell</th>
                                    <th>Nominee Cell</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in parsedContactRows.Take(25))
                                {
