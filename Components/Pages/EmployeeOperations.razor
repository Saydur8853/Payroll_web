                <div style="display:flex; align-items:center; justify-content:space-between; background:#f8fafc; padding:12px 16px; border-radius:8px; border:1px solid #e2e8f0; margin-bottom:1rem; flex-wrap:wrap; gap:8px;">
                    <div>
                        <strong>Format Guidelines:</strong>
                        <div style="color:#64748b; font-size:12px; margin-top:2px;">
                            @if (importMode == "status")
                            {
                                <span>Columns: <code>Emp Code, Gross, OverTime (Y/N), Transport (Y/N), Transport Stand, DOJ</code></span>
                            }
                            else if (importMode == "priority")
                            {
                                <span>Columns: <code>Emp Code, Priority</code></span>
                            }
                            else
                            {
                                <span>Columns: <code>Emp Code, Contact No, Email, Blood Group, Emergency Contact Person, Emergency Cell, Nominee Cell, Reference Cell</code></span>
                            }
                        </div>
                    </div>
                    <button type="button" class="emp-btn emp-btn-outline" style="font-size:12px; padding:6px 12px;" @onclick="DownloadCurrentModeTemplate">
                        <span>📄 Download Template</span>
                    </button>
                </div>

                <!-- Dropzone / File Picker -->
                <div style="border: 2px dashed #cbd5e1; border-radius:10px; padding: 24px; text-align:center; background:#fafafa; margin-bottom:1rem; position:relative;">
                    <InputFile OnChange="HandleImportCsvSelected" accept=".csv,text/csv" disabled="@isImportSaving" style="position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; z-index:2;" />
