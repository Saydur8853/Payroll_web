                                        <td>@r.RowIndex</td>
                                        <td><strong>@r.EmployeeCode</strong></td>
                                        <td>@r.ContactNo</td>
                                        <td>@r.Email</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(r.BloodGroup))
