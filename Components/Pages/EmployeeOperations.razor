                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:20px;">📥</span>
                    <div>
                        <h3 style="margin:0; font-size:16px;">
                            @if (importMode == "status")
                            {
                                <span>Bulk Import Salary & Status (Excel / CSV)</span>
                            }
                            else if (importMode == "priority")
                            {
                                <span>Bulk Import Priority Hierarchy (Excel / CSV)</span>
                            }
                            else
                            {
                                <span>Bulk Import Emergency Contacts & Blood Group (Excel / CSV)</span>
                            }
