@page "/EmployeeOperations"
@inject EmployeeRepository EmployeeRepository
@inject PayrollRepository PayrollRepository
@inject IJSRuntime JS
@using TG.Payroll.Web.Models
@using TG.Payroll.Web.Services

<div class="emp-page-container emp-status-page">
    <!-- Clean Header -->
    <header class="emp-status-clean-header">
        <div class="emp-header-left">
            <div class="emp-badge-category">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                <span>OPERATIONS & BULK MANAGEMENT</span>
            </div>
            <h1 class="emp-clean-title">Workforce Operations</h1>
            <p class="emp-clean-subtitle">Unified workplace operations for bulk salary adjustments, priority hierarchy, and emergency contacts.</p>
        </div>
        
        <div class="emp-header-right">
            @if (activeTab == "status")
            {
                <button type="button" class="emp-btn emp-btn-outline" @onclick='() => OpenImportModal("status")'>
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V3zm3.707 5.707a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L5.414 12H11a1 1 0 100-2H5.414l1.293-1.293z" clip-rule="evenodd"/></svg>
                    <span>Import Status (CSV)</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="DownloadStatusTemplate" title="Download sample CSV template">
                    <span>📄 Template</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="ExportStatusCsv" disabled="@(statusEmployees.Count == 0)">
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    <span>Export CSV</span>
                </button>
                <button type="button" class="emp-btn emp-btn-primary" @onclick="SaveStatusAllChangesAsync" disabled="@(isStatusSaving || !HasStatusDirtyRows)">
                    @if (isStatusSaving)
                    {
                        <span class="emp-spinner-dot"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Status Changes @(StatusDirtyCount > 0 ? $"({StatusDirtyCount})" : "")</span>
                    }
                </button>
            }
            else if (activeTab == "priority")
            {
                <button type="button" class="emp-btn emp-btn-outline" @onclick='() => OpenImportModal("priority")'>
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V3zm3.707 5.707a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L5.414 12H11a1 1 0 100-2H5.414l1.293-1.293z" clip-rule="evenodd"/></svg>
                    <span>Import Priorities (CSV)</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="DownloadPriorityTemplate" title="Download sample CSV template">
                    <span>📄 Template</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="ExportPriorityCsv" disabled="@(priorityEmployees.Count == 0)">
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    <span>Export CSV</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="AutoSequencePriorities" disabled="@(isPrioritySaving || priorityEmployees.Count == 0)">
                    <span>Auto-Sequence (1..N)</span>
                </button>
                <button type="button" class="emp-btn emp-btn-primary" @onclick="SavePriorityChangesAsync" disabled="@(isPrioritySaving || !HasPriorityUnsavedChanges)">
                    @if (isPrioritySaving)
                    {
                        <span class="emp-spinner-dot"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Priorities @(PriorityDirtyCount > 0 ? $"({PriorityDirtyCount})" : "")</span>
                    }
                </button>
            }
            else if (activeTab == "contact")
            {
                <button type="button" class="emp-btn emp-btn-outline" @onclick='() => OpenImportModal("contact")'>
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V3zm3.707 5.707a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L5.414 12H11a1 1 0 100-2H5.414l1.293-1.293z" clip-rule="evenodd"/></svg>
                    <span>Import Contacts (CSV)</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="DownloadContactTemplate" title="Download sample CSV template">
                    <span>📄 Template</span>
                </button>
                <button type="button" class="emp-btn emp-btn-outline" @onclick="ExportContactsCsvAsync" disabled="@isContactExporting">
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    <span>Export Directory</span>
                </button>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="emp-toast-banner animate-in">
            <span>✅</span>
            <span>@toastMessage</span>
        </div>
    }

    <!-- Tab Navigation Pills -->
    <div class="emp-tab-nav-wrapper" style="margin-bottom: 1.25rem;">
        <div class="emp-tab-nav-pills">
            <button type="button" class="emp-tab-pill @(activeTab == "status" ? "active" : "")" @onclick='() => SetTab("status")'>
                <span class="pill-icon">⚡</span>
                <span class="pill-title">Bulk Salary & Status</span>
                @if (StatusDirtyCount > 0)
                {
                    <span class="emp-badge-counter">@StatusDirtyCount</span>
                }
            </button>
            <button type="button" class="emp-tab-pill @(activeTab == "priority" ? "active" : "")" @onclick='() => SetTab("priority")'>
                <span class="pill-icon">🔢</span>
                <span class="pill-title">Priority & Hierarchy</span>
                @if (PriorityDirtyCount > 0)
                {
                    <span class="emp-badge-counter">@PriorityDirtyCount</span>
                }
            </button>
            <button type="button" class="emp-tab-pill @(activeTab == "contact" ? "active" : "")" @onclick='() => SetTab("contact")'>
                <span class="pill-icon">📞</span>
                <span class="pill-title">Emergency Contact Book</span>
                @if (contactTotalCount > 0)
                {
                    <span class="emp-badge-counter-sub">@contactTotalCount</span>
                }
            </button>
        </div>
    </div>

    <!-- ==================== TAB 1: BULK SALARY & STATUS ==================== -->
    @if (activeTab == "status")
    {
        <!-- Filter Card -->
        <section class="emp-card emp-status-filter-card">
            <div class="emp-status-filter-grid">
                <div class="emp-field">
                    <label class="emp-label">From Date (Joining)</label>
                    <input type="date" class="emp-input" @bind="statusFilter.FromDate" />
                </div>
                <div class="emp-field">
                    <label class="emp-label">To Date (Joining)</label>
                    <input type="date" class="emp-input" @bind="statusFilter.ToDate" />
                </div>
                <div class="emp-field">
                    <label class="emp-label">Unit</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="statusFilter.UnitId">
                            <option value="0">All Units</option>
                            @foreach (var u in lookups.Units)
                            {
                                <option value="@u.Id">@u.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field">
                    <label class="emp-label">Department</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="statusFilter.DepartmentId">
                            <option value="0">All Departments</option>
                            @foreach (var d in lookups.Departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field emp-field-search">
                    <label class="emp-label">Search</label>
                    <div class="emp-search-input-wrap">
                        <input type="text" class="emp-input" placeholder="Code / Name..." @bind="statusFilter.SearchQuery" @bind:event="oninput" @onkeyup="OnStatusKeyUp" />
                    </div>
                </div>
                <div class="emp-field emp-field-actions">
                    <label class="emp-label">&nbsp;</label>
                    <div class="emp-filter-btns-wrap">
                        <button type="button" class="emp-btn emp-btn-primary emp-btn-search" @onclick="SearchStatusAsync" disabled="@isStatusLoading">
                            @if (isStatusLoading)
                            {
                                <span class="emp-spinner-dot"></span>
                                <span>Loading...</span>
                            }
                            else
                            {
                                <span>Filter</span>
                            }
                        </button>
                        <button type="button" class="emp-btn emp-btn-secondary" @onclick="ResetStatusFilter">Clear</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Status Table -->
        <section class="emp-card emp-status-table-card">
            <div class="emp-status-table-wrap">
                <table class="emp-status-table">
                    <thead>
                        <tr>
                            <th class="col-center" style="width: 45px;">#</th>
                            <th style="width: 105px;">Emp Code</th>
                            <th style="width: 200px;">Employee Name</th>
                            <th style="width: 170px;">Designation</th>
                            <th style="width: 160px;">Department</th>
                            <th style="width: 110px;">Joining</th>
                            <th style="width: 130px;">Gross Salary</th>
                            <th class="col-center" style="width: 75px;">OT</th>
                            <th class="col-center" style="width: 80px;">Transport</th>
                            <th style="width: 160px;">Transport Stand</th>
                            <th class="col-center" style="width: 80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isStatusLoading)
                        {
                            <tr>
                                <td colspan="11" class="table-loading-cell">
                                    <div class="table-spinner"></div>
                                    <span>Loading workforce records...</span>
                                </td>
                            </tr>
                        }
                        else if (!hasStatusLoaded)
                        {
                            <tr>
                                <td colspan="11" class="table-loading-cell" style="padding:48px 16px;">
                                    <div style="font-weight:700; color:#334155; font-size:15px; margin-bottom:4px;">Ready to Manage Workforce Status</div>
                                    <div style="color:#64748b; font-size:13px;">Select Department, Joining Date or search keyword and click "Filter" to edit bulk records.</div>
                                </td>
                            </tr>
                        }
                        else if (statusEmployees.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="table-loading-cell" style="padding:48px 16px;">
                                    <div style="font-weight:700; color:#334155; font-size:15px;">No Records Found</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < statusEmployees.Count; i++)
                            {
                                var index = i;
                                var emp = statusEmployees[index];
                                <tr class="@(emp.IsEdited ? "row-edited" : "")">
                                    <td class="col-center" style="color:#64748b;">@(index + 1)</td>
                                    <td><span class="emp-code-badge">@emp.EmployeeCode</span></td>
                                    <td>
                                        <strong>@emp.EmployeeName</strong>
                                        @if (!string.IsNullOrWhiteSpace(emp.BanglaEmployeeName))
                                        {
                                            <div class="emp-bangla-text"><small>@emp.BanglaEmployeeName</small></div>
                                        }
                                    </td>
                                    <td>@emp.DesignationName</td>
                                    <td>@emp.DepartmentName</td>
                                    <td>@(emp.DateOfJoining?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>
                                        <input type="number" step="100" class="table-inline-input" @bind="emp.Gross" @bind:event="oninput" @bind:after="() => CheckStatusEdited(emp)" />
                                    </td>
                                    <td class="col-center">
                                        <input type="checkbox" checked="@(emp.OverTime == "Y")" @onchange='(e) => ToggleStatusOt(emp, e)' />
                                    </td>
                                    <td class="col-center">
                                        <input type="checkbox" checked="@(emp.Transport == "Y")" @onchange='(e) => ToggleStatusTransport(emp, e)' />
                                    </td>
                                    <td>
                                        <input type="text" class="table-inline-input" placeholder="Stand..." @bind="emp.TransportStand" @bind:event="oninput" @bind:after="() => CheckStatusEdited(emp)" />
                                    </td>
                                    <td class="col-center">
                                        <button type="button" class="emp-btn-save-row" disabled="@(!emp.IsEdited)" @onclick="() => SaveStatusSingleRowAsync(emp)" title="Save Row">
                                            💾
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <!-- ==================== TAB 2: PRIORITY & HIERARCHY ==================== -->
    @if (activeTab == "priority")
    {
        <!-- Filter Card -->
        <section class="emp-card emp-status-filter-card">
            <div class="emp-status-filter-grid">
                <div class="emp-field">
                    <label class="emp-label">Department</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="priorityDeptId">
                            <option value="">All Departments</option>
                            @foreach (var d in lookups.Departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field">
                    <label class="emp-label">Section</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="prioritySectionId">
                            <option value="">All Sections</option>
                            @foreach (var s in lookups.Sections)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field">
                    <label class="emp-label">Designation</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="priorityDesigId">
                            <option value="">All Designations</option>
                            @foreach (var des in lookups.Designations)
                            {
                                <option value="@des.Id">@des.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field emp-field-search">
                    <label class="emp-label">Search</label>
                    <div class="emp-search-input-wrap">
                        <input type="text" class="emp-input" placeholder="Search..." @bind="prioritySearch" @bind:event="oninput" @onkeyup="OnPriorityKeyUp" />
                    </div>
                </div>
                <div class="emp-field emp-field-actions">
                    <label class="emp-label">&nbsp;</label>
                    <div class="emp-filter-btns-wrap">
                        <button type="button" class="emp-btn emp-btn-primary emp-btn-search" @onclick="LoadPriorityAsync" disabled="@isPriorityLoading">
                            @if (isPriorityLoading)
                            {
                                <span class="emp-spinner-dot"></span>
                                <span>Loading...</span>
                            }
                            else
                            {
                                <span>Load Hierarchy</span>
                            }
                        </button>
                        <button type="button" class="emp-btn emp-btn-secondary" @onclick="ResetPriorityFilter">Clear</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Priority Table -->
        <section class="emp-card emp-status-table-card">
            <div class="emp-status-table-wrap">
                <table class="emp-status-table">
                    <thead>
                        <tr>
                            <th class="col-center" style="width: 50px;">Order</th>
                            <th style="width: 110px;">Priority #</th>
                            <th style="width: 105px;">Emp Code</th>
                            <th style="width: 220px;">Employee Name</th>
                            <th style="width: 160px;">Bangla Name</th>
                            <th style="width: 160px;">Department</th>
                            <th style="width: 160px;">Section</th>
                            <th style="width: 180px;">Designation</th>
                            <th class="col-center" style="width: 85px;">Status</th>
                            <th class="col-center" style="width: 95px;">Reorder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isPriorityLoading)
                        {
                            <tr>
                                <td colspan="10" class="table-loading-cell">
                                    <div class="table-spinner"></div>
                                    <span>Loading priority roster...</span>
                                </td>
                            </tr>
                        }
                        else if (!hasPriorityLoaded)
                        {
                            <tr>
                                <td colspan="10" class="table-loading-cell" style="padding:48px 16px;">
                                    <div style="font-weight:700; color:#334155; font-size:15px; margin-bottom:4px;">Ready to Configure Priority</div>
                                    <div style="color:#64748b; font-size:13px;">Select Department, Section or search keywords and click "Load Hierarchy".</div>
                                </td>
                            </tr>
                        }
                        else if (priorityEmployees.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="table-loading-cell" style="padding:48px 16px;">
                                    <div style="font-weight:700; color:#334155; font-size:15px;">No Records Match Filter</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < priorityEmployees.Count; i++)
                            {
                                var index = i;
                                var emp = priorityEmployees[index];
                                var isDirty = emp.Priority != emp.InitialPriority;
                                <tr class="@(isDirty ? "emp-row-modified" : "")">
                                    <td class="col-center" style="color:#64748b; font-weight:600;">@(index + 1)</td>
                                    <td>
                                        <input type="number" min="0" max="99999" class="emp-input emp-priority-input @(isDirty ? "emp-input-dirty" : "")" @bind="emp.Priority" @bind:event="oninput" />
                                    </td>
                                    <td><span class="emp-code-badge">@emp.EmployeeCode</span></td>
                                    <td><strong>@emp.EmployeeName</strong></td>
                                    <td><span class="emp-bangla-text">@(string.IsNullOrWhiteSpace(emp.BanglaEmployeeName) ? "-" : emp.BanglaEmployeeName)</span></td>
                                    <td>@emp.DepartmentName</td>
                                    <td>@emp.SectionName</td>
                                    <td><strong>@emp.DesignationName</strong></td>
                                    <td class="col-center"><span class="emp-status-pill @emp.EmployeeStatus.ToLowerInvariant()">@emp.EmployeeStatus</span></td>
                                    <td class="col-center">
                                        <div class="emp-reorder-btn-group">
                                            <button type="button" class="emp-btn-mini" disabled="@(index == 0)" @onclick="() => MovePriorityUp(index)">▲</button>
                                            <button type="button" class="emp-btn-mini" disabled="@(index == priorityEmployees.Count - 1)" @onclick="() => MovePriorityDown(index)">▼</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <!-- ==================== TAB 3: CONTACT DIRECTORY ==================== -->
    @if (activeTab == "contact")
    {
        <!-- Filter Card -->
        <section class="emp-card emp-status-filter-card">
            <div class="emp-status-filter-grid">
                <div class="emp-field">
                    <label class="emp-label">Department</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="contactDeptId">
                            <option value="">All Departments</option>
                            @foreach (var d in lookups.Departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field">
                    <label class="emp-label">Section</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="contactSectionId">
                            <option value="">All Sections</option>
                            @foreach (var s in lookups.Sections)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field">
                    <label class="emp-label">Status</label>
                    <div class="emp-select-wrap">
                        <select class="emp-input emp-select" @bind="contactStatus">
                            <option value="Active">Active</option>
                            <option value="Close">Close</option>
                            <option value="ALL">All</option>
                        </select>
                        <span class="emp-select-arrow">▼</span>
                    </div>
                </div>
                <div class="emp-field emp-field-search">
                    <label class="emp-label">Search (Phone / Name / Code)</label>
                    <div class="emp-search-input-wrap">
                        <input type="text" class="emp-input" placeholder="Phone or Name..." @bind="contactSearch" @bind:event="oninput" @onkeyup="OnContactKeyUp" />
                    </div>
                </div>
                <div class="emp-field emp-field-actions">
                    <label class="emp-label">&nbsp;</label>
                    <div class="emp-filter-btns-wrap">
                        <button type="button" class="emp-btn emp-btn-primary emp-btn-search" @onclick="SearchContactsAsync" disabled="@isContactLoading">
                            @if (isContactLoading)
                            {
                                <span class="emp-spinner-dot"></span>
                                <span>Searching...</span>
                            }
                            else
                            {
                                <span>Search Contacts</span>
                            }
                        </button>
                        <button type="button" class="emp-btn emp-btn-secondary" @onclick="ResetContactFilter">Clear</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Table -->
        <section class="emp-card emp-status-table-card">
            <div class="emp-status-table-wrap">
                <table class="emp-status-table">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Emp Code</th>
                            <th style="width: 190px;">Employee Name</th>
                            <th style="width: 170px;">Department & Role</th>
                            <th style="width: 130px;">Primary Mobile</th>
                            <th style="width: 160px;">Email</th>
                            <th class="col-center" style="width: 90px;">Blood Group</th>
                            <th style="width: 180px;">Emergency Contact</th>
                            <th style="width: 150px;">Nominee / Ref</th>
                            <th style="width: 170px;">Address</th>
                            <th class="col-center" style="width: 80px;">Status</th>
                            <th class="col-center" style="width: 80px;">Quick Edit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isContactLoading)
                        {
                            <tr>
                                <td colspan="11" class="table-loading-cell">
                                    <div class="table-spinner"></div>
                                    <span>Searching contact directory...</span>
                                </td>
                            </tr>
                        }
                        else if (!hasContactLoaded)
                        {
                            <tr>
                                <td colspan="11" class="table-loading-cell" style="padding:48px 16px;">
                                    <div style="font-weight:700; color:#334155; font-size:15px; margin-bottom:4px;">Ready to Search Contacts</div>
                                    <div style="color:#64748b; font-size:13px;">Enter phone number, name or department above and click "Search Contacts".</div>
                                </td>
                            </tr>
                        }
                        else if (contactEmployees.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="table-loading-cell" style="padding:48px 16px;">
                                    <div style="font-weight:700; color:#334155; font-size:15px;">No Contacts Found</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in contactEmployees)
                            {
                                <tr>
                                    <td><span class="emp-code-badge">@c.EmployeeCode</span></td>
                                    <td>
                                        <strong>@c.EmployeeName</strong>
                                        @if (!string.IsNullOrWhiteSpace(c.BanglaEmployeeName))
                                        {
                                            <div class="emp-bangla-text"><small>@c.BanglaEmployeeName</small></div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@c.DesignationName</strong>
                                        <div class="emp-meta-sub">@c.DepartmentName</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(c.ContactNo))
                                        {
                                            <a href="tel:@c.ContactNo" class="emp-phone-link">📞 @c.ContactNo</a>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(c.Email))
                                        {
                                            <a href="mailto:@c.Email" class="emp-email-link">✉️ @c.Email</a>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">-</span>
                                        }
                                    </td>
                                    <td class="col-center">
                                        @if (!string.IsNullOrWhiteSpace(c.BloodGroup))
                                        {
                                            <span class="emp-blood-pill">🩸 @c.BloodGroup</span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(c.EmergencyCellNo) || !string.IsNullOrWhiteSpace(c.EmergencyContactName))
                                        {
                                            <div><strong>@c.EmergencyContactName</strong></div>
                                            <small class="emp-phone-link">📞 @c.EmergencyCellNo</small>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(c.NomineeCellNo))
                                        {
                                            <div><small>Nom: @c.NomineeCellNo</small></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.RefCellNo))
                                        {
                                            <div><small>Ref: @c.RefCellNo</small></div>
                                        }
                                    </td>
                                    <td>
                                        <small style="max-width: 180px; display:inline-block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@c.PresentAddress">
                                            @(string.IsNullOrWhiteSpace(c.PresentAddress) ? "-" : c.PresentAddress)
                                        </small>
                                    </td>
                                    <td class="col-center"><span class="emp-status-pill @c.EmployeeStatus.ToLowerInvariant()">@c.EmployeeStatus</span></td>
                                    <td class="col-center">
                                        <button type="button" class="emp-btn-mini" @onclick="() => OpenQuickEdit(c)">✏️ Edit</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Contact Pagination -->
            @if (hasContactLoaded && contactTotalCount > 0)
            {
                <div class="emp-pagination-bar">
                    <div class="emp-page-info">
                        Showing @(((contactPage - 1) * contactPageSize) + 1) to @(Math.Min(contactPage * contactPageSize, contactTotalCount)) of <strong>@contactTotalCount.ToString("N0")</strong> contacts
                    </div>
                    <div class="emp-page-controls">
                        <button type="button" class="emp-page-btn" disabled="@(contactPage <= 1)" @onclick="() => GoToContactPage(contactPage - 1)">&laquo; Prev</button>
                        <span class="emp-page-indicator">Page @(contactPage) of @ContactTotalPages</span>
                        <button type="button" class="emp-page-btn" disabled="@(contactPage >= ContactTotalPages)" @onclick="() => GoToContactPage(contactPage + 1)">Next &raquo;</button>
                    </div>
                </div>
            }
        </section>
    }
</div>

