        "unit" => "Unit Setup",
        "department" => "Department Setup",
        "category" => "Employee Category Setup",
        "section" => "Section Setup",
        "line" => "Line Information",
        "transport" => "Transport Stand Setup",
        "salaryrule" => "Salary Rule Structure",
        "signing" => "Signing Authority Setup",
        "dormitory" => "Dormitory Setup",
