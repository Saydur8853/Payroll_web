@page "/MasterSetup"
@page "/Master"
@page "/Master/{TabName}"
@page "/Designation"
@page "/ShiftInfo"
@page "/Holiday"
@page "/UnitSetup"
@page "/Department"
@page "/EmployeeCategory"
@page "/Section"
@page "/LineInfo"
@page "/TransportStand"
@page "/SalaryRule"
@page "/SigningOption"
@page "/Dormitory"
@using System.Web
@inject IHttpContextAccessor HttpContextAccessor
@inject MasterRepository MasterRepository
@inject PayrollRepository PayrollRepository
@inject NavigationManager Navigation
@inject ILogger<MasterSetup> Logger

<PageTitle>Master Data Management - TG Payroll</PageTitle>

@if (!loaded)
{
    <div class="skeleton-shell">
        <div class="skeleton-header-card">
            <div class="skeleton-box" style="width:180px;height:12px;"></div>
            <div class="skeleton-box" style="width:320px;height:32px;border-radius:8px;"></div>
            <div class="skeleton-box" style="width:520px;height:14px;"></div>
        </div>

        <div class="skeleton-card">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div class="skeleton-box" style="width:220px;height:22px;"></div>
                <div class="skeleton-box" style="width:100px;height:14px;"></div>
            </div>
            <div class="skeleton-grid">
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:120px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:100px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:90px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:110px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:8px;">
                <div class="skeleton-box" style="width:80px;height:38px;border-radius:8px;"></div>
                <div class="skeleton-box" style="width:140px;height:38px;border-radius:8px;"></div>
            </div>
        </div>

        <div class="skeleton-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                <div class="skeleton-box" style="width:200px;height:20px;"></div>
                <div class="skeleton-box" style="width:220px;height:36px;border-radius:8px;"></div>
            </div>
            <div class="skeleton-table-wrap">
                <table class="skeleton-table">
                    <thead>
                        <tr>
                            <th style="width:60px;"><div class="skeleton-box" style="width:40px;height:12px;"></div></th>
                            <th><div class="skeleton-box" style="width:150px;height:12px;"></div></th>
                            <th><div class="skeleton-box" style="width:100px;height:12px;"></div></th>
                            <th><div class="skeleton-box" style="width:100px;height:12px;"></div></th>
                            <th style="width:120px;"><div class="skeleton-box" style="width:80px;height:12px;"></div></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < 5; i++)
                        {
                            <tr>
                                <td><div class="skeleton-box" style="width:36px;height:18px;border-radius:12px;"></div></td>
                                <td>
                                    <div class="skeleton-box" style="width:180px;height:14px;display:block;margin-bottom:4px;"></div>
                                    <div class="skeleton-box" style="width:110px;height:11px;"></div>
                                </td>
                                <td><div class="skeleton-box" style="width:80px;height:18px;border-radius:12px;"></div></td>
                                <td><div class="skeleton-box" style="width:90px;height:14px;"></div></td>
                                <td>
                                    <div style="display:flex;gap:6px;">
                                        <div class="skeleton-box" style="width:40px;height:24px;border-radius:6px;"></div>
                                        <div class="skeleton-box" style="width:45px;height:24px;border-radius:6px;"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (!hasAccess)
{
    <div class="database-error management-message">
        Access Restricted: You do not have permission to view Master Data Setup.
    </div>
}
else
{
    <section class="management-heading">
        <div>
            <p class="eyebrow">MASTER CONFIGURATION</p>
            <h1>@GetHeaderTitle()</h1>
            <p>@GetHeaderSubtitle()</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="success-message">@successMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="database-error management-message">@errorMessage</div>
    }

    @if (showConfirmModal)
    {
        <div class="modal-backdrop-overlay" @onclick="CancelDelete">
            <div class="confirm-delete-modal" @onclick:stopPropagation>
                <div class="confirm-modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3>Are you sure?</h3>
                <p>Do you really want to delete <strong>@confirmItemTitle</strong> (@confirmItemType)? This action cannot be undone.</p>
                <div class="confirm-modal-actions">
                    <button type="button" class="btn-cancel-modal" @onclick="CancelDelete">No, Cancel</button>
                    <button type="button" class="btn-confirm-delete" @onclick="ExecuteConfirmedDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    }

    <!-- ==================== TAB 1: DESIGNATION ==================== -->
    @if (activeTab == "designation")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>@(editDesig.DesignationId > 0 ? $"Edit Designation (ID: #{editDesig.DesignationId})" : "Add New Designation")</h2>
                    <p>Configure employee job titles, Bengali nomenclature, grades, and attendance bonuses.</p>
                </div>
                <form @onsubmit="SaveDesignation" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Designation Name (English) <strong class="req-star">*</strong></span>
                            <input @bind="editDesig.DesignationName" placeholder="e.g. Senior Operator" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">পদবী (বাংলায়)</span>
                            <input @bind="editDesig.DesignationNameBang" placeholder="যেমনঃ সিনিয়র অপারেটর" class="company-form-input emp-bangla-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Grade / গ্রেড</span>
                            <input @bind="editDesig.Grade" placeholder="e.g. Grade-4" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Position / পদমর্যাদা</span>
                            <input @bind="editDesig.Position" placeholder="e.g. Worker / Staff / Officer" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Position Priority</span>
                            <input type="number" @bind="editDesig.PositionPriority" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Attendance Bonus (Tk)</span>
                            <input type="number" step="0.01" @bind="editDesig.AttendanceBonus" class="company-form-input" />
                        </label>
                    </div>
                    <label class="company-form-group" style="margin-top:12px;">
                        <span class="company-form-label">Remarks</span>
                        <input @bind="editDesig.Remarks" placeholder="Optional notes" class="company-form-input" />
                    </label>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="ResetDesigForm">Reset</button>
                        <button type="submit" class="btn-primary-action @(editDesig.DesignationId > 0 ? "btn-update-mode" : "")">
                            <span>@(editDesig.DesignationId > 0 ? "Update Designation" : "Save Designation")</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Registered Designations</h2>
                        <p>Total @designations.Count designations in database.</p>
                    </div>
                    <div class="control-search-wrap">
                        <input type="text" placeholder="Search designations..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">ID</th>
                                <th>Designation Name</th>
                                <th>Grade</th>
                                <th>Position</th>
                                <th>Priority</th>
                                <th>Attn Bonus</th>
                                <th style="width:110px;text-align:center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in FilteredDesignations)
                            {
                                <tr>
                                    <td><span class="id-badge">#@d.DesignationId</span></td>
                                    <td>
                                        <strong>@d.DesignationName</strong>
                                        @if (!string.IsNullOrWhiteSpace(d.DesignationNameBang))
                                        {
                                            <div class="emp-bangla-text"><small>@d.DesignationNameBang</small></div>
                                        }
                                    </td>
                                    <td><span class="type-pill">@(string.IsNullOrWhiteSpace(d.Grade) ? "-" : d.Grade)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(d.Position) ? "-" : d.Position)</td>
                                    <td>@d.PositionPriority</td>
                                    <td>@(d.AttendanceBonus > 0 ? $"{d.AttendanceBonus:N2} Tk" : "-")</td>
                                    <td style="text-align:center;">
                                        <div class="table-action-group">
                                            <button type="button" class="action-btn btn-edit-ctrl" @onclick="() => EditDesignation(d)">Edit</button>
                                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Designation", d.DesignationName, () => DeleteDesignation(d.DesignationId))'>Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== TAB 2: SHIFT INFO ==================== -->
    @if (activeTab == "shift")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>@(editShift.ShiftId > 0 ? $"Edit Shift (ID: #{editShift.ShiftId})" : "Add New Shift")</h2>
                    <p>Configure working shifts, in/out buffers, grace periods, and break timings.</p>
                </div>
                <form @onsubmit="SaveShift" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Shift Name <strong class="req-star">*</strong></span>
                            <input @bind="editShift.ShiftName" placeholder="e.g. Day Shift" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">In Time (HH:mm AM/PM)</span>
                            <input @bind="editShift.InTime" placeholder="08:00 AM" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Out Time (HH:mm AM/PM)</span>
                            <input @bind="editShift.OutTime" placeholder="05:00 PM" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">In Time Buffer From</span>
                            <input @bind="editShift.InTimeFrom" placeholder="07:00 AM" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Out Time Buffer From</span>
                            <input @bind="editShift.OutTimeFrom" placeholder="04:30 PM" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Grace Period (Minutes)</span>
                            <input @bind="editShift.Grace" placeholder="15" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Lunch Start</span>
                            <input @bind="editShift.LunchStart" placeholder="01:00 PM" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Lunch End</span>
                            <input @bind="editShift.LunchEnd" placeholder="02:00 PM" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Default Status</span>
                            <select @bind="editShift.DefaultStatus" class="company-form-input">
                                <option value="General">General</option>
                                <option value="Night">Night</option>
                                <option value="Roster">Roster</option>
                            </select>
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="ResetShiftForm">Reset</button>
                        <button type="submit" class="btn-primary-action @(editShift.ShiftId > 0 ? "btn-update-mode" : "")">
                            <span>@(editShift.ShiftId > 0 ? "Update Shift" : "Save Shift")</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Registered Shifts</h2>
                        <p>Total @shifts.Count shift routines in database.</p>
                    </div>
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">ID</th>
                                <th>Shift Name</th>
                                <th>Working Hours</th>
                                <th>Punch Window</th>
                                <th>Grace</th>
                                <th>Lunch Break</th>
                                <th>Status</th>
                                <th style="width:110px;text-align:center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in shifts)
                            {
                                <tr>
                                    <td><span class="id-badge">#@s.ShiftId</span></td>
                                    <td><strong>@s.ShiftName</strong></td>
                                    <td><span class="type-pill">@s.InTime — @s.OutTime</span></td>
                                    <td><small style="color:#64748b;">@s.InTimeFrom to @s.OutTimeFrom</small></td>
                                    <td>@s.Grace min</td>
                                    <td>@s.LunchStart - @s.LunchEnd</td>
                                    <td><span class="type-pill">@s.DefaultStatus</span></td>
                                    <td style="text-align:center;">
                                        <div class="table-action-group">
                                            <button type="button" class="action-btn btn-edit-ctrl" @onclick="() => EditShift(s)">Edit</button>
                                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Shift", s.ShiftName, () => DeleteShift(s.ShiftId))'>Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== TAB 3: HOLIDAY ==================== -->
    @if (activeTab == "holiday")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>@(editHoliday.HolidayId > 0 ? $"Edit Holiday (ID: #{editHoliday.HolidayId})" : "Add Government / Factory Holiday")</h2>
                    <p>Declare and schedule organizational holidays for payroll and attendance calculations.</p>
                </div>
                <form @onsubmit="SaveHoliday" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Holiday Date <strong class="req-star">*</strong></span>
                            <input type="date" @bind="editHoliday.Date" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Holiday Type</span>
                            <select @bind="editHoliday.Type" class="company-form-input">
                                <option value="Holiday">Government Holiday</option>
                                <option value="Festival">Festival Holiday</option>
                                <option value="Special">Special Holiday</option>
                                <option value="Weekend">Weekend Holiday</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Applicable Category</span>
                            <select @bind="editHoliday.Category" class="company-form-input">
                                <option value="All">All Categories</option>
                                <option value="Staff">Staff</option>
                                <option value="Worker">Worker</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Remarks / Description</span>
                            <input @bind="editHoliday.Remarks" placeholder="e.g. Eid-ul-Fitr / Independence Day" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="ResetHolidayForm">Reset</button>
                        <button type="submit" class="btn-primary-action @(editHoliday.HolidayId > 0 ? "btn-update-mode" : "")">
                            <span>@(editHoliday.HolidayId > 0 ? "Update Holiday" : "Save Holiday")</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Holiday Calendar (@DateTime.Today.Year)</h2>
                        <p>Total @holidays.Count holidays declared this year.</p>
                    </div>
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">ID</th>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Description / Remarks</th>
                                <th style="width:110px;text-align:center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in holidays)
                            {
                                <tr>
                                    <td><span class="id-badge">#@h.HolidayId</span></td>
                                    <td><strong>@h.Date.ToString("dd-MMM-yyyy")</strong></td>
                                    <td><span class="type-pill">@h.Date.ToString("dddd")</span></td>
                                    <td>@h.Type</td>
                                    <td><span class="type-pill">@h.Category</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(h.Remarks) ? "-" : h.Remarks)</td>
                                    <td style="text-align:center;">
                                        <div class="table-action-group">
                                            <button type="button" class="action-btn btn-edit-ctrl" @onclick="() => EditHoliday(h)">Edit</button>
                                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Holiday", $"{h.Date:dd MMM yyyy} - {h.Type}", () => DeleteHoliday(h.HolidayId))'>Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== TAB 4: UNIT ==================== -->
    @if (activeTab == "unit")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>@(editUnit.UnitId > 0 ? $"Edit Unit (ID: #{editUnit.UnitId})" : "Add New Unit")</h2>
                    <p>Configure operational business units, mills, factories, and branch addresses.</p>
                </div>
                <form @onsubmit="SaveUnit" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Unit Name (English) <strong class="req-star">*</strong></span>
                            <input @bind="editUnit.UnitName" placeholder="e.g. Unit-1 Spinning" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">ইউনিটের নাম (বাংলায়)</span>
                            <input @bind="editUnit.UnitNameBang" placeholder="যেমনঃ ইউনিট-১ স্পিনিং" class="company-form-input emp-bangla-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Short Name / Code</span>
                            <input @bind="editUnit.ShortName" placeholder="e.g. U1" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Address</span>
                            <input @bind="editUnit.Address" placeholder="e.g. Mirzapur, Gazipur" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="ResetUnitForm">Reset</button>
                        <button type="submit" class="btn-primary-action @(editUnit.UnitId > 0 ? "btn-update-mode" : "")">
                            <span>@(editUnit.UnitId > 0 ? "Update Unit" : "Save Unit")</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Registered Units</h2>
                        <p>Total @units.Count operational units in database.</p>
                    </div>
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">ID</th>
                                <th>Unit Name</th>
                                <th>Short Code</th>
                                <th>Company</th>
                                <th>Address</th>
                                <th style="width:110px;text-align:center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in units)
                            {
                                <tr>
                                    <td><span class="id-badge">#@u.UnitId</span></td>
                                    <td>
                                        <strong>@u.UnitName</strong>
                                        @if (!string.IsNullOrWhiteSpace(u.UnitNameBang))
                                        {
                                            <div class="emp-bangla-text"><small>@u.UnitNameBang</small></div>
                                        }
                                    </td>
                                    <td><span class="type-pill">@(string.IsNullOrWhiteSpace(u.ShortName) ? "-" : u.ShortName)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(u.CompanyName) ? "-" : u.CompanyName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(u.Address) ? "-" : u.Address)</td>
                                    <td style="text-align:center;">
                                        <div class="table-action-group">
                                            <button type="button" class="action-btn btn-edit-ctrl" @onclick="() => EditUnit(u)">Edit</button>
                                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Unit", u.UnitName, () => DeleteUnit(u.UnitId))'>Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== TAB 5: DEPARTMENT ==================== -->
    @if (activeTab == "department")
    {
