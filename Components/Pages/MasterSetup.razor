            designations = await MasterRepository.GetDesignationsAsync();
            shifts = await MasterRepository.GetShiftsAsync();
            holidays = await MasterRepository.GetHolidaysAsync();
            units = await MasterRepository.GetUnitsAsync();
            departments = await MasterRepository.GetDepartmentsAsync();
            categories = await MasterRepository.GetCategoriesAsync();
            sections = await MasterRepository.GetSectionsAsync();
            lines = await MasterRepository.GetLinesAsync();
