    private IEnumerable<DesignationItem> FilteredDesignations =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? designations
            : designations.Where(d =>
                d.DesignationName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (d.DesignationNameBang != null && d.DesignationNameBang.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (d.Grade != null && d.Grade.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdStr = session?.GetString("UserId");
        if (!int.TryParse(userIdStr, out currentUserId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        currentUserIsAdmin = session?.GetString("IsAdmin") == "1";
        hasAccess = currentUserIsAdmin || true; // Master accessible to authenticated users with permissions

        ResolveActiveTab();
        await LoadAllDataAsync();
        loaded = true;
    }

    protected override void OnParametersSet()
    {
        ResolveActiveTab();
    }

    private void ResolveActiveTab()
    {
        var uri = Navigation.Uri.ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(QueryTab))
        {
            activeTab = QueryTab.ToLowerInvariant();
        }
        else if (!string.IsNullOrWhiteSpace(TabName))
        {
            activeTab = NormalizeTab(TabName);
        }
        else if (uri.Contains("/designation")) activeTab = "designation";
        else if (uri.Contains("/shiftinfo") || uri.Contains("/shift")) activeTab = "shift";
        else if (uri.Contains("/holiday")) activeTab = "holiday";
        else if (uri.Contains("/unitsetup") || uri.Contains("/unit")) activeTab = "unit";
        else if (uri.Contains("/department")) activeTab = "department";
        else if (uri.Contains("/employeecategory") || uri.Contains("/category")) activeTab = "category";
        else if (uri.Contains("/section")) activeTab = "section";
        else if (uri.Contains("/lineinfo") || uri.Contains("/line")) activeTab = "line";
        else if (uri.Contains("/transportstand") || uri.Contains("/transport")) activeTab = "transport";
        else if (uri.Contains("/salaryrule")) activeTab = "salaryrule";
        else if (uri.Contains("/signingoption") || uri.Contains("/signing")) activeTab = "signing";
        else if (uri.Contains("/dormitory")) activeTab = "dormitory";
    }

    private static string NormalizeTab(string input)
    {
        var n = input.ToLowerInvariant();
        if (n.Contains("desig")) return "designation";
        if (n.Contains("shift")) return "shift";
        if (n.Contains("holi")) return "holiday";
        if (n.Contains("unit")) return "unit";
        if (n.Contains("dept") || n.Contains("department")) return "department";
        if (n.Contains("cat")) return "category";
        if (n.Contains("sec")) return "section";
        if (n.Contains("line")) return "line";
        if (n.Contains("trans") || n.Contains("stand")) return "transport";
        if (n.Contains("salary") || n.Contains("rule")) return "salaryrule";
        if (n.Contains("sign")) return "signing";
        if (n.Contains("dorm") || n.Contains("quarter") || n.Contains("qtr")) return "dormitory";
        return n;
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        successMessage = null;
        errorMessage = null;
    }

    private async Task LoadAllDataAsync()
    {
        try
