@code {
    [Parameter]
    public string? TabName { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    private bool loaded;
    private bool hasAccess;
    private int currentUserId;
    private string currentUserName = "User";
    private bool currentUserIsAdmin;

    private string activeTab = "salary";

    // Master Data
    private SalaryFilter filter = new();
    private List<UnitItem> units = [];
    private List<DepartmentItem> departments = [];
    private List<SectionItem> sections = [];
    private List<DesignationItem> designations = [];
    private List<CategoryItem> categories = [];

    // Module Data
    private List<SalaryProcessItem> salaries = [];
    private List<AdvanceDuesDeductionItem> advanceDuesList = [];
    private string addEmpCode = "";
    private AdvanceDuesDeductionItem addItem = new();

    private List<HourPunishmentItem> punishments = [];
    private string punishEmpCode = "";
    private HourPunishmentItem punishItem = new();

