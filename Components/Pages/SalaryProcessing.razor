    private string maternityEmpCode = "";
    private MaternityLeaveItem maternityItem = new();

    private List<MicroLeaveItem> microLeaves = [];
    private string microEmpCode = "";
    private MicroLeaveItem microItem = new();

    private List<LeaveEntryItem> leaveEntries = [];
    private string leaveEmpCode = "";
    private LeaveEntryItem leaveItem = new();
    private LeaveBalanceInfo leaveBalance = new();

    // Binary Dynamic SQL Runner State
    private string binarySqlQuery = "SELECT EMP_ID, EMP_CODE, EMP_NAME, GROSS, BASIC, EMP_STATUS FROM EMP_OFFICIAL WHERE ROWNUM <= 50";
    private DataTable? binaryDataTable;
    private bool isExecutingBinary;

    // Feedback & Auto-Dismiss Toast System (5 Seconds)
    private string? _successMessage;
    private string? successMessage
    {
        get => _successMessage;
        set
        {
            _successMessage = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _errorMessage = null;
                ScheduleToastDismiss();
            }
        }
    }

    private string? _errorMessage;
    private string? errorMessage
    {
        get => _errorMessage;
        set
        {
            _errorMessage = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _successMessage = null;
                ScheduleToastDismiss();
            }
        }
    }

    private CancellationTokenSource? toastCts;
    private void ScheduleToastDismiss()
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        _successMessage = null;
                        _errorMessage = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    private bool showConfirmModal;
    private string confirmItemTitle = "";
    private string confirmItemType = "";
    private Func<Task>? pendingDeleteAction;

    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdStr = session?.GetString("UserId");
        if (!int.TryParse(userIdStr, out currentUserId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        currentUserName = session?.GetString("UserName") ?? "User";
        currentUserIsAdmin = session?.GetString("IsAdmin") == "1";
        hasAccess = true;

        units = await MasterRepository.GetUnitsAsync();
        departments = await MasterRepository.GetDepartmentsAsync();
        sections = await MasterRepository.GetSectionsAsync();
        designations = await MasterRepository.GetDesignationsAsync();
        categories = await MasterRepository.GetCategoriesAsync();

        ResolveActiveTab();
        loaded = true;
    }

    protected override void OnParametersSet()
    {
        if (loaded)
        {
            ResolveActiveTab();
        }
    }

    private void ResolveActiveTab()
    {
        var uri = Navigation.Uri.ToLowerInvariant();
        var tab = QueryTab ?? TabName;

        if (!string.IsNullOrWhiteSpace(tab))
        {
            var t = tab.ToLowerInvariant();
            if (t.Contains("leave") && !t.Contains("maternity") && !t.Contains("microleave")) activeTab = "leave";
            else if (t.Contains("dues") || t.Contains("advance-dues")) activeTab = "advancedues";
            else if (t.Contains("punish")) activeTab = "punishment";
            else if (t.Contains("maternity")) activeTab = "maternity";
            else if (t.Contains("microleave") || t.Contains("weekend")) activeTab = "microleave";
            else if (t.Contains("microsalary")) activeTab = "microsalary";
            else if (t.Contains("binary")) activeTab = "binary";
            else if (t.Contains("buyer")) activeTab = "buyer";
            else activeTab = "salary";
        }
        else if (uri.Contains("/leaveprocess")) activeTab = "leave";
        else if (uri.Contains("/advanceduesdeduction")) activeTab = "advancedues";
        else if (uri.Contains("/hourpunishment")) activeTab = "punishment";
        else if (uri.Contains("/maternityleaveprocess")) activeTab = "maternity";
        else if (uri.Contains("/microleave")) activeTab = "microleave";
        else if (uri.Contains("/microsalary")) activeTab = "microsalary";
        else if (uri.Contains("/binarysalary")) activeTab = "binary";
        else if (uri.Contains("/buyermanual")) activeTab = "buyer";
        else activeTab = "salary";
    }

