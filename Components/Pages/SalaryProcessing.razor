        {
            salaries = await SalaryRepository.GetSavedSalariesAsync(filter);
            successMessage = $"Loaded {salaries.Count} saved salary records from database.";
            errorMessage = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

