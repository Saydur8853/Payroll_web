    private async Task SearchAddEmployee()
    {
        if (string.IsNullOrWhiteSpace(addEmpCode)) return;
        try
        {
            var empList = await EmployeeRepository.GetEmployeesAsync(addEmpCode.Trim());
            var empSummary = empList.FirstOrDefault(e => e.EmployeeCode.Equals(addEmpCode.Trim(), StringComparison.OrdinalIgnoreCase)) ?? empList.FirstOrDefault();
            if (empSummary != null)
            {
                var emp = await EmployeeRepository.GetEmployeeAsync(empSummary.EmployeeId);
                if (emp != null)
                {
                    addItem.EmpId = emp.EmployeeId;
                    addItem.EmpCode = emp.EmployeeCode;
                    addItem.EmpName = emp.EmployeeName;
                    successMessage = $"Found employee: {emp.EmployeeName}.";
                    errorMessage = null;
                    return;
                }
            }
            errorMessage = $"Employee '{addEmpCode}' not found.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

