    private void LoadBinaryTemplate(int templateId)
    {
        binarySqlQuery = templateId switch
        {
            1 => "SELECT EMP_ID, EMP_CODE, EMP_NAME, GROSS, BASIC, EMP_STATUS FROM EMP_OFFICIAL WHERE ROWNUM <= 50",
            2 => "SELECT EMP_CODE, EMP_NAME, GROSS, BASIC, NET_PAYABLE, SALARY_FOR FROM SALARY WHERE ROWNUM <= 50",
            3 => "SELECT EMP_ID, ATTD_DATE, IN_TIME, OUT_TIME, STATUS, OVER_TIME FROM ATTENDANCE_DETAILS WHERE ROWNUM <= 50",
            4 => "SELECT * FROM ADVANCE_DUES_DEDUCTION WHERE ROWNUM <= 50",
            5 => "SELECT * FROM LEAVE WHERE ROWNUM <= 50",
            _ => "SELECT * FROM EMP_OFFICIAL WHERE ROWNUM <= 50"
        };
    }

    private void SetBinaryTemplate(string sql)
    {
        binarySqlQuery = sql;
    }

    private async Task ExecuteBinaryQuery()
    {
        if (string.IsNullOrWhiteSpace(binarySqlQuery))
        {
            errorMessage = "Please enter an SQL query to execute.";
            return;
        }

        try
        {
            isExecutingBinary = true;
            errorMessage = null;
            successMessage = null;
            binaryDataTable = await SalaryRepository.ExecuteBinaryQueryAsync(binarySqlQuery);
            successMessage = $"Query executed successfully! Returned {binaryDataTable.Rows.Count} rows.";
        }
        catch (Exception ex)
        {
            errorMessage = $"SQL Execution Error: {ex.Message}";
            binaryDataTable = null;
        }
        finally
        {
            isExecutingBinary = false;
        }
    }

    private async Task CheckBinaryQuerySyntax()
    {
        if (string.IsNullOrWhiteSpace(binarySqlQuery))
        {
            errorMessage = "Please enter an SQL query to check.";
            return;
        }

        try
        {
            isExecutingBinary = true;
            errorMessage = null;
            var cleanSql = binarySqlQuery.Trim().TrimEnd(';', '/', ' ', '\t', '\r', '\n').Trim();
            var testSql = $"SELECT * FROM ({cleanSql}) WHERE ROWNUM <= 1";
            await SalaryRepository.ExecuteBinaryQueryAsync(testSql);
            successMessage = "Your SQL Query syntax is completely valid and ready to execute!";
        }
        catch (Exception ex)
        {
            errorMessage = $"SQL Syntax Error: {ex.Message}";
        }
        finally
        {
            isExecutingBinary = false;
        }
    }

    private void ClearBinaryQuery()
    {
        binarySqlQuery = "";
        binaryDataTable = null;
        successMessage = null;
        errorMessage = null;
    }

    private async Task ExportBinaryToCsv()
    {
        if (binaryDataTable == null || binaryDataTable.Rows.Count == 0)
        {
            errorMessage = "No data available to export. Please execute a query first.";
            return;
        }

        try
        {
            var sb = new System.Text.StringBuilder();
            var colNames = new List<string>();
            foreach (DataColumn c in binaryDataTable.Columns)
            {
                colNames.Add("\"" + c.ColumnName.Replace("\"", "\"\"") + "\"");
            }
            sb.AppendLine(string.Join(",", colNames));

            foreach (DataRow row in binaryDataTable.Rows)
            {
                var rowVals = new List<string>();
                foreach (var item in row.ItemArray)
                {
                    rowVals.Add("\"" + (item?.ToString() ?? "").Replace("\"", "\"\"") + "\"");
                }
                sb.AppendLine(string.Join(",", rowVals));
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var filename = "Binary_Report_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".csv";
            await JSRuntime.InvokeVoidAsync("eval", "const a = document.createElement('a'); a.href = 'data:text/csv;base64," + base64 + "'; a.download = '" + filename + "'; a.click();");
            successMessage = "Exported " + binaryDataTable.Rows.Count + " records to " + filename + ".";
        }
        catch (Exception ex)
        {
            errorMessage = $"Export Failed: {ex.Message}";
        }
    }

