@page "/SalaryProcessing"
@page "/SalaryProcessing/{TabName}"
@page "/AdvanceDuesDeduction"
@page "/HourPunishment"
@page "/LeaveProcess"
@page "/SalaryProcess"
@page "/MicroSalary"
@page "/MaternityLeaveProcess"
@page "/BinarySalary"
@page "/MicroLeave"
@page "/SalaryPayment"
@page "/BuyerManual"
@page "/SalarySetup"
@using System.Web
@using System.Data
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject PayrollRepository PayrollRepository
@inject MasterRepository MasterRepository
@inject EmployeeRepository EmployeeRepository
@inject SalaryRepository SalaryRepository
@inject AdvantageRepository AdvantageRepository
@inject IJSRuntime JSRuntime

<PageTitle>@GetHeaderTitle() - TG Payroll</PageTitle>

@if (!loaded)
{
    <div class="control-entry-shell">
        <section class="control-form-panel">
            <div class="skeleton-shimmer" style="height:32px;width:240px;margin-bottom:12px;"></div>
            <div class="skeleton-shimmer" style="height:18px;width:380px;margin-bottom:24px;"></div>
            <div class="skeleton-shimmer" style="height:180px;border-radius:12px;margin-bottom:16px;"></div>
        </section>
        <section class="control-list-panel">
            <div class="skeleton-shimmer" style="height:350px;border-radius:12px;"></div>
        </section>
    </div>
}
else if (!hasAccess)
{
    <div class="database-error management-message">
        Access Restricted: You do not have permission to access Salary Processing modules.
    </div>
}
else
{
    <section class="management-heading">
        <div>
            <p class="eyebrow">PAYROLL & DISBURSEMENT OPERATIONS</p>
            <h1>@GetHeaderTitle()</h1>
            <p>@GetHeaderSubtitle()</p>
        </div>
    </section>

    <!-- Floating Modern Toast Notifications -->
    <div class="toast-notification-container">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="toast-item toast-success">
                <div class="toast-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div class="toast-body">
                    <div class="toast-title">Operation Successful</div>
                    <div class="toast-text">@successMessage</div>
                </div>
                <button type="button" class="toast-close-btn" @onclick="() => successMessage = null">&times;</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="toast-item toast-error">
                <div class="toast-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01"/></svg>
                </div>
                <div class="toast-body">
                    <div class="toast-title">Notice / Query Error</div>
                    <div class="toast-text">@errorMessage</div>
                </div>
                <button type="button" class="toast-close-btn" @onclick="() => errorMessage = null">&times;</button>
            </div>
        }
    </div>

    <!-- Universal Delete Consent Modal -->
    @if (showConfirmModal)
    {
        <div class="modal-backdrop-overlay" @onclick="CancelDelete">
            <div class="confirm-delete-modal" @onclick:stopPropagation>
                <div class="confirm-modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3>Are you sure?</h3>
                <p>Do you really want to delete <strong>@confirmItemTitle</strong> (@confirmItemType)? This action cannot be undone.</p>
                <div class="confirm-modal-actions">
                    <button type="button" class="btn-cancel-modal" @onclick="CancelDelete">No, Cancel</button>
                    <button type="button" class="btn-confirm-delete" @onclick="ExecuteConfirmedDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    }

    <!-- ==================== 1. MAIN SALARY PROCESS / MICROSALARY / BUYER ==================== -->
    @if (activeTab == "salary" || activeTab == "microsalary" || activeTab == "buyer")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>@(activeTab == "microsalary" ? "MicroSalary Processing" : activeTab == "buyer" ? "Buyer Manual Salary" : "Monthly Salary Processing")</h2>
                    <p>Calculate regular salary, attendance, OT, allowances, night shifts, and deductions.</p>
                </div>
                <form @onsubmit="ProcessMonthlySalary" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Salary Month / Year <strong class="req-star">*</strong></span>
                            <input type="month" value="@filter.SalaryMonth.ToString("yyyy-MM")" @onchange="OnSalaryMonthChanged" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Business Unit</span>
                            <select @bind="filter.UnitId" class="company-form-input">
                                <option value="">-- All Units --</option>
                                @foreach (var u in units) { <option value="@u.UnitId">@u.UnitName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Department</span>
                            <select @bind="filter.DepartmentId" class="company-form-input">
                                <option value="">-- All Departments --</option>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Section</span>
                            <select @bind="filter.SectionId" class="company-form-input">
                                <option value="">-- All Sections --</option>
                                @foreach (var s in sections) { <option value="@s.SectionId">@s.SectionName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Category</span>
                            <select @bind="filter.CategoryId" class="company-form-input">
                                <option value="">-- All Categories --</option>
                                @foreach (var c in categories) { <option value="@c.CategoryId">@c.CategoryName</option> }
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Code</span>
                            <input @bind="filter.EmpCode" placeholder="Specific Code" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="LoadSavedSalaries">Load Saved Salary</button>
                        <button type="submit" class="btn-primary-action">
                            <span>Calculate Monthly Salary</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Salary Sheet (@salaries.Count Employees)</h2>
                        <p>Total Net Payable: <strong>৳ @salaries.Sum(s => s.NetPayable).ToString("N2")</strong> | Bank: ৳ @salaries.Sum(s => s.BankPayable).ToString("N2") | Cash: ৳ @salaries.Sum(s => s.NetCashPayable).ToString("N2")</p>
                    </div>
                    @if (salaries.Count > 0)
                    {
                        <div class="table-action-group">
                            <button type="button" class="btn-primary-action" @onclick="SaveMonthlySalaries">Save All Salaries</button>
                            <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Salary Sheet Batch", filter.SalaryMonth.ToString("MMMM yyyy"), DeleteSalaries)'>Clear Month</button>
                        </div>
                    }
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:40px;"><input type="checkbox" @onchange="ToggleSelectAllSalaries" checked="@(salaries.Count > 0 && salaries.All(s => s.IsSelected))" /></th>
                                <th>Emp Code</th>
                                <th>Name / Desig</th>
                                <th style="text-align:right;">Gross</th>
                                <th style="text-align:center;">P/A/L/H</th>
                                <th style="text-align:right;">Earning</th>
                                <th style="text-align:right;">OT Amt</th>
                                <th style="text-align:right;">Adv/Deduct</th>
                                <th style="text-align:right;">Net Payable</th>
                                <th>Mode</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in salaries)
                            {
                                <tr>
                                    <td><input type="checkbox" @bind="s.IsSelected" /></td>
                                    <td><strong>@s.EmpCode</strong></td>
                                    <td>@s.EmpName<div class="badge-sub">@s.DesignationName</div></td>
                                    <td style="text-align:right;">৳ @s.Gross.ToString("N0")</td>
                                    <td style="text-align:center;"><span class="type-pill">@s.PresentDays/@s.AbsentDays/@s.LeaveDays/@(s.HolidayDays + s.WeekendDays)</span></td>
                                    <td style="text-align:right;">৳ @s.EarningSalary.ToString("N0")</td>
                                    <td style="text-align:right;">৳ @s.OtAmount.ToString("N0")<small class="badge-sub">@s.OverTimeHours h</small></td>
                                    <td style="text-align:right;color:#e11d48;">-৳ @s.TotalDeduction.ToString("N0")</td>
                                    <td style="text-align:right;"><strong style="color:#16a34a;">৳ @s.NetPayable.ToString("N0")</strong></td>
                                    <td><span class="@(s.AccType == "Bank" ? "admin-badge" : "type-pill")">@s.AccType</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== BINARY REPORT & QUERY AUDITOR ==================== -->
    @if (activeTab == "binary")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Binary SQL Query Console</h2>
                    <p>Enter and execute custom Oracle SQL queries for compliance audits, custom dataset generation, and verification.</p>
                </div>

                <div style="margin-bottom:12px;">
                    <span style="font-size:12px;font-weight:600;color:#64748b;display:block;margin-bottom:6px;">QUICK QUERY TEMPLATES:</span>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        <button type="button" class="btn-secondary-action" style="padding:4px 10px;font-size:12px;" @onclick="() => LoadBinaryTemplate(1)">Employees</button>
                        <button type="button" class="btn-secondary-action" style="padding:4px 10px;font-size:12px;" @onclick="() => LoadBinaryTemplate(2)">Salary Sheet</button>
                        <button type="button" class="btn-secondary-action" style="padding:4px 10px;font-size:12px;" @onclick="() => LoadBinaryTemplate(3)">Attendance</button>
                        <button type="button" class="btn-secondary-action" style="padding:4px 10px;font-size:12px;" @onclick="() => LoadBinaryTemplate(4)">Advance/Dues</button>
                        <button type="button" class="btn-secondary-action" style="padding:4px 10px;font-size:12px;" @onclick="() => LoadBinaryTemplate(5)">Leave Log</button>
                    </div>
                </div>

                <form @onsubmit="ExecuteBinaryQuery" @onsubmit:preventDefault>
                    <div class="company-form-group">
                        <span class="company-form-label" style="display:flex;justify-content:space-between;">
                            <span>SQL Query Statement <strong class="req-star">*</strong></span>
                            <small style="color:#64748b;">(Oracle SQL syntax)</small>
                        </span>
                        <textarea @bind="binarySqlQuery" class="company-form-input" style="font-family:Consolas, 'Fira Code', monospace;font-size:13px;background:#0f172a;color:#38bdf8;border-color:#334155;line-height:1.6;padding:14px;border-radius:10px;height:220px;min-height:180px;resize:vertical;" placeholder="SELECT * FROM ..."></textarea>
                    </div>
                    <div class="control-form-actions" style="margin-top:12px;gap:8px;">
                        <button type="button" class="btn-secondary-action" @onclick="ClearBinaryQuery">Clear</button>
                        <button type="button" class="btn-secondary-action" @onclick="CheckBinaryQuerySyntax">Check Syntax</button>
                        @if (binaryDataTable != null && binaryDataTable.Rows.Count > 0)
                        {
                            <button type="button" class="btn-secondary-action" style="background:#16a34a;color:#fff;border:none;" @onclick="ExportBinaryToCsv">Export to CSV / Excel</button>
                        }
                        <button type="submit" class="btn-primary-action" disabled="@isExecutingBinary">
                            @if (isExecutingBinary)
                            {
                                <span>Executing...</span>
                            }
                            else
                            {
                                <span>Execute Query</span>
                            }
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Query Results @(binaryDataTable != null ? $"({binaryDataTable.Rows.Count} Rows, {binaryDataTable.Columns.Count} Columns)" : "(0 Rows)")</h2>
                        <p>Real-time dataset view returned from database execution.</p>
                    </div>
                    @if (binaryDataTable != null && binaryDataTable.Rows.Count > 0)
                    {
                        <div class="table-action-group">
                            <button type="button" class="btn-primary-action" @onclick="ExportBinaryToCsv">Export Dataset</button>
                        </div>
                    }
                </div>

                @if (binaryDataTable != null && binaryDataTable.Rows.Count > 0)
                {
                    <div class="controls-table-container" style="max-height:550px;overflow:auto;">
                        <table class="controls-data-table">
                            <thead>
                                <tr>
                                    @foreach (DataColumn col in binaryDataTable.Columns)
                                    {
                                        <th style="white-space:nowrap;">@col.ColumnName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow row in binaryDataTable.Rows)
                                {
                                    <tr>
                                        @foreach (DataColumn col in binaryDataTable.Columns)
                                        {
                                            <td style="white-space:nowrap;"><small>@(row[col] == DBNull.Value ? "-" : row[col].ToString())</small></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div style="padding:48px 24px;text-align:center;color:#64748b;border:1px dashed #cbd5e1;border-radius:10px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:48px;height:48px;margin:0 auto 12px;color:#94a3b8;"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7zm0 5h16M9 4v16"/></svg>
                        <h4 style="margin:0 0 6px;color:#334155;">No Query Results Yet</h4>
                        <p style="margin:0;font-size:13px;">Write or select an SQL query on the left console and click "Execute Query" to inspect results.</p>
                    </div>
                }
            </section>
        </div>
    }

    <!-- ==================== 2. LEAVE PROCESS & ENTRY ==================== -->
    @if (activeTab == "leave")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Leave Processing & Posting</h2>
                    <p>Post employee Casual (CL), Sick (SL), Earn (EL), or Special leave and sync with attendance.</p>
                </div>
                <form @onsubmit="SaveLeaveEntry" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Code <strong class="req-star">*</strong></span>
                            <div style="display:flex;gap:8px;">
                                <input @bind="leaveEmpCode" placeholder="Emp Code" required class="company-form-input" />
                                <button type="button" class="btn-secondary-action" @onclick="SearchLeaveEmployee">Search</button>
                            </div>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Name</span>
                            <input value="@leaveItem.EmpName" disabled class="company-form-input" style="background:#f1f5f9;" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Leave Type <strong class="req-star">*</strong></span>
                            <select @bind="leaveItem.LeaveType" required class="company-form-input">
                                <option value="CL">Casual Leave (CL)</option>
                                <option value="SL">Sick Leave (SL)</option>
                                <option value="EL">Earn Leave (EL)</option>
                                <option value="ML">Medical / Maternity Leave (ML)</option>
                                <option value="LWP">Leave Without Pay (LWP)</option>
                                <option value="SPL">Special Leave (SPL)</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">From Date <strong class="req-star">*</strong></span>
                            <input type="date" value="@leaveItem.FromDate.ToString("yyyy-MM-dd")" @onchange="OnLeaveFromDateChanged" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">To Date <strong class="req-star">*</strong></span>
                            <input type="date" value="@leaveItem.ToDate.ToString("yyyy-MM-dd")" @onchange="OnLeaveToDateChanged" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Grant Days <strong class="req-star">*</strong></span>
                            <input type="number" @bind="leaveItem.GrantDays" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Remarks / Reason</span>
                            <input @bind="leaveItem.Remarks" placeholder="e.g. Family Emergency" class="company-form-input" />
                        </label>
                    </div>

                    @if (leaveItem.EmpId > 0)
                    {
                        <div style="display:flex;gap:12px;margin:14px 0;padding:12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">
                            <div style="flex:1;text-align:center;">
                                <div style="font-size:11px;color:#64748b;font-weight:600;">CASUAL (CL)</div>
                                <div style="font-size:15px;font-weight:700;color:#1e293b;">@leaveBalance.BalanceCl <small style="color:#64748b;font-weight:normal;">/ @leaveBalance.EntitledCl</small></div>
                            </div>
                            <div style="flex:1;text-align:center;border-left:1px solid #cbd5e1;border-right:1px solid #cbd5e1;">
                                <div style="font-size:11px;color:#64748b;font-weight:600;">SICK (SL)</div>
                                <div style="font-size:15px;font-weight:700;color:#1e293b;">@leaveBalance.BalanceSl <small style="color:#64748b;font-weight:normal;">/ @leaveBalance.EntitledSl</small></div>
                            </div>
                            <div style="flex:1;text-align:center;">
                                <div style="font-size:11px;color:#64748b;font-weight:600;">EARN (EL)</div>
                                <div style="font-size:15px;font-weight:700;color:#1e293b;">@leaveBalance.BalanceEl <small style="color:#64748b;font-weight:normal;">/ @leaveBalance.EntitledEl</small></div>
                            </div>
                        </div>
                    }

                    <div class="control-form-actions">
                        <button type="submit" class="btn-primary-action">
                            <span>Post & Save Leave</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Leave History Register (@leaveEntries.Count Records)</h2>
                        <p>Total Granted Leave: <strong>@leaveEntries.Sum(l => l.GrantDays) Days</strong></p>
                    </div>
                    <div class="table-action-group">
                        <button type="button" class="btn-secondary-action" @onclick="LoadLeaveEntries">Refresh List</button>
                    </div>
                </div>
                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th>Emp Code</th>
                                <th>Name / Desig</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th style="text-align:center;">From Date</th>
                                <th style="text-align:center;">To Date</th>
                                <th style="text-align:center;">Days</th>
                                <th>Remarks</th>
                                <th style="text-align:center;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in leaveEntries)
                            {
                                <tr>
                                    <td><strong>@l.EmpCode</strong></td>
                                    <td>@l.EmpName<div class="badge-sub">@l.DesignationName</div></td>
                                    <td>@l.DepartmentName</td>
                                    <td><span class="admin-badge">@l.LeaveType</span></td>
                                    <td style="text-align:center;"><small>@l.FromDate.ToString("dd-MMM-yyyy")</small></td>
                                    <td style="text-align:center;"><small>@l.ToDate.ToString("dd-MMM-yyyy")</small></td>
                                    <td style="text-align:center;"><span class="type-pill">@l.GrantDays d</span></td>
                                    <td><small>@l.Remarks</small></td>
                                    <td style="text-align:center;">
                                        <button type="button" class="action-btn btn-delete-ctrl" @onclick='() => PromptDelete("Leave Record", l.EmpName, () => DeleteLeaveEntry(l.LeaveId))'>Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- ==================== 3. ADVANCE-DUES-DEDUCTION ==================== -->
    @if (activeTab == "advancedues")
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Advance, Dues & Deduction Entry</h2>
                    <p>Record employee monthly advance deductions, arrears/dues, or special loan installments.</p>
                </div>
                <form @onsubmit="SaveAdvanceDues" @onsubmit:preventDefault>
                    <div class="master-form-grid">
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Code <strong class="req-star">*</strong></span>
                            <div style="display:flex;gap:8px;">
                                <input @bind="addEmpCode" placeholder="Emp Code" required class="company-form-input" />
                                <button type="button" class="btn-secondary-action" @onclick="SearchAddEmployee">Search</button>
                            </div>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Employee Name</span>
                            <input value="@addItem.EmpName" disabled class="company-form-input" style="background:#f1f5f9;" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Entry Type <strong class="req-star">*</strong></span>
                            <select @bind="addItem.AddType" required class="company-form-input">
                                <option value="Advance">Advance Salary</option>
                                <option value="Dues">Salary Dues / Arrear</option>
                                <option value="Deduction">Other Deduction / Loan</option>
                            </select>
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Amount (BDT) <strong class="req-star">*</strong></span>
                            <input type="number" @bind="addItem.AddAmount" required class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Effective Month <strong class="req-star">*</strong></span>
                            <input type="month" value="@addItem.MonthYear.ToString("yyyy-MM")" @onchange="OnAddMonthChanged" class="company-form-input" />
                        </label>
                        <label class="company-form-group">
                            <span class="company-form-label">Remarks</span>
                            <input @bind="addItem.Remarks" placeholder="e.g. Festival Advance Adjustment" class="company-form-input" />
                        </label>
                    </div>
                    <div class="control-form-actions">
                        <button type="submit" class="btn-primary-action">
                            <span>Save Entry</span>
                        </button>
                    </div>
                </form>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Monthly Adjustments Register (@advanceDuesList.Count)</h2>
