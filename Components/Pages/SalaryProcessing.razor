    private void OnLeaveFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            leaveItem.FromDate = dt;
            if (leaveItem.ToDate < dt) leaveItem.ToDate = dt;
            leaveItem.GrantDays = Math.Max(1, (int)(leaveItem.ToDate - leaveItem.FromDate).TotalDays + 1);
        }
    }

    private void OnLeaveToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            leaveItem.ToDate = dt;
            leaveItem.GrantDays = Math.Max(1, (int)(leaveItem.ToDate - leaveItem.FromDate).TotalDays + 1);
        }
    }

