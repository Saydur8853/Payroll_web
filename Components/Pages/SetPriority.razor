@page "/SetPriority"
@inject EmployeeRepository EmployeeRepository
@inject IJSRuntime JS
@using TG.Payroll.Web.Models
@using TG.Payroll.Web.Services

<div class="emp-page-container emp-status-page">
    <!-- Header Section -->
    <header class="emp-status-clean-header">
        <div class="emp-header-left">
            <div class="emp-badge-category">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>HIERARCHY & REPORT SEQUENCING</span>
            </div>
            <h1 class="emp-clean-title">Set Priority</h1>
            <p class="emp-clean-subtitle">Define employee executive order and reporting priorities for salary sheets, payslips, and administrative rosters.</p>
        </div>
        
        <div class="emp-header-right">
            @if (hasLoaded && employees.Count > 0)
            {
                <button type="button" class="emp-btn emp-btn-outline" @onclick="AutoSequencePriorities" disabled="@isSaving" title="Renumber from 1 to N sequentially">
                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/></svg>
                    <span>Auto-Sequence (1..N)</span>
                </button>
                <button type="button" class="emp-btn emp-btn-primary" @onclick="SaveChangesAsync" disabled="@(isSaving || !HasUnsavedChanges)">
                    @if (isSaving)
                    {
                        <span class="emp-spinner-dot"></span>
                        <span>Saving Priorities...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        <span>Save All Changes @(DirtyCount > 0 ? $"({DirtyCount})" : "")</span>
                    }
                </button>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="emp-toast-banner animate-in">
            <span>✅</span>
            <span>@toastMessage</span>
        </div>
    }

    <!-- Filters Section -->
    <section class="emp-card emp-status-filter-card">
        <div class="emp-status-filter-grid">
            <div class="emp-field">
                <label class="emp-label">Department</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="selectedDepartmentId">
                        <option value="">All Departments</option>
                        @foreach (var d in lookups.Departments)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field">
                <label class="emp-label">Section</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="selectedSectionId">
                        <option value="">All Sections</option>
                        @foreach (var s in FilteredSections)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field">
                <label class="emp-label">Designation</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="selectedDesignationId">
                        <option value="">All Designations</option>
                        @foreach (var des in lookups.Designations)
                        {
                            <option value="@des.Id">@des.Name</option>
                        }
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field">
                <label class="emp-label">Status</label>
                <div class="emp-select-wrap">
                    <select class="emp-input emp-select" @bind="selectedStatus">
                        <option value="Active">Active Only</option>
                        <option value="Close">Close Only</option>
                        <option value="ALL">All Employees</option>
                    </select>
                    <span class="emp-select-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </span>
                </div>
            </div>

            <div class="emp-field emp-field-search">
                <label class="emp-label">Quick Search</label>
                <div class="emp-search-input-wrap">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                    <input type="text" class="emp-input" placeholder="Search Code or Name..." @bind="searchQuery" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>
            </div>

            <div class="emp-field emp-field-actions">
                <label class="emp-label">&nbsp;</label>
                <div class="emp-filter-btns-wrap">
                    <button type="button" class="emp-btn emp-btn-primary emp-btn-search" @onclick="LoadDataAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="emp-spinner-dot"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                            <span>Load</span>
                        }
                    </button>
                    <button type="button" class="emp-btn emp-btn-secondary" @onclick="ResetFilters" title="Clear Filters">Clear</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Priority Management Grid -->
    <section class="emp-card emp-status-table-card">
        <div class="emp-status-table-header">
            <div class="table-header-left">
                <h3>
                    @if (hasLoaded)
                    {
                        <span>Priority Ordering (@employees.Count Employees)</span>
                    }
                    else
                    {
                        <span>Employee Hierarchy & Priority</span>
                    }
                </h3>
            </div>
            <div class="table-header-right">
                @if (HasUnsavedChanges)
                {
                    <span style="display:inline-flex; align-items:center; gap:6px; background:#fef3c7; color:#92400e; font-size:12px; font-weight:700; padding:4px 10px; border-radius:12px;">
                        ⚠️ @DirtyCount Pending Change(s)
                    </span>
                }
            </div>
        </div>

        <div class="emp-status-table-wrap">
            <table class="emp-status-table">
                <thead>
                    <tr>
                        <th class="col-center" style="width: 50px;">Order</th>
                        <th style="width: 120px;">Priority #</th>
                        <th style="width: 110px;">Emp Code</th>
                        <th style="width: 220px;">Employee Name</th>
                        <th style="width: 160px;">Bangla Name</th>
                        <th style="width: 160px;">Department</th>
                        <th style="width: 160px;">Section</th>
                        <th style="width: 180px;">Designation</th>
                        <th class="col-center" style="width: 90px;">Status</th>
                        <th class="col-center" style="width: 100px;">Reorder</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="10" class="table-loading-cell">
                                <div class="table-spinner"></div>
                                <span>Loading priority roster from database...</span>
                            </td>
                        </tr>
                    }
                    else if (!hasLoaded)
                    {
                        <tr>
                            <td colspan="10" class="table-loading-cell" style="padding: 48px 16px;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:42px; height:42px; margin-bottom:10px; color:#94a3b8;"><path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <div style="font-weight: 700; color: #334155; font-size: 15px; margin-bottom: 4px;">Ready to Configure Priority</div>
                                <div style="color: #64748b; font-size: 13px;">Select Department, Section or search keywords and click "Load" to view list.</div>
                            </td>
                        </tr>
                    }
                    else if (employees.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="table-loading-cell" style="padding: 48px 16px;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:42px; height:42px; margin-bottom:10px; color:#94a3b8;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                <div style="font-weight: 700; color: #334155; font-size: 15px; margin-bottom: 4px;">No Records Match Filter</div>
                                <div style="color: #64748b; font-size: 13px;">Please select a different Department or clear your search term.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < employees.Count; i++)
                        {
                            var index = i;
                            var emp = employees[index];
                            var isDirty = emp.Priority != emp.InitialPriority;
                            <tr class="@(isDirty ? "emp-row-modified" : "")">
                                <td class="col-center" style="color: #64748b; font-weight: 600;">
                                    @(index + 1)
                                </td>
                                <td>
                                    <input type="number" 
                                           class="emp-input emp-priority-input @(isDirty ? "emp-input-dirty" : "")" 
                                           min="0" 
                                           max="99999" 
                                           @bind="emp.Priority" 
                                           @bind:event="oninput" />
                                </td>
                                <td>
                                    <span class="emp-code-badge">@emp.EmployeeCode</span>
                                </td>
                                <td>
                                    <strong class="emp-name-main">@emp.EmployeeName</strong>
                                    <div class="emp-meta-sub">@emp.UnitName</div>
                                </td>
                                <td>
                                    <span class="emp-bangla-text">@(string.IsNullOrWhiteSpace(emp.BanglaEmployeeName) ? "-" : emp.BanglaEmployeeName)</span>
                                </td>
                                <td>@emp.DepartmentName</td>
                                <td>@emp.SectionName</td>
                                <td>
                                    <strong>@emp.DesignationName</strong>
                                </td>
                                <td class="col-center">
                                    <span class="emp-status-pill @emp.EmployeeStatus.ToLowerInvariant()">@emp.EmployeeStatus</span>
                                </td>
                                <td class="col-center">
                                    <div class="emp-reorder-btn-group">
                                        <button type="button" class="emp-btn-mini" disabled="@(index == 0)" @onclick="() => MoveRowUp(index)" title="Move Up">
                                            ▲
                                        </button>
                                        <button type="button" class="emp-btn-mini" disabled="@(index == employees.Count - 1)" @onclick="() => MoveRowDown(index)" title="Move Down">
                                            ▼
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private List<EmployeePriorityItem> employees = [];
    private EmployeeLookups lookups = new();
    private int? selectedDepartmentId;
    private int? selectedSectionId;
    private int? selectedDesignationId;
    private string selectedStatus = "Active";
    private string searchQuery = string.Empty;
    private bool isLoading = false;
    private bool hasLoaded = false;
    private bool isSaving = false;
    private string? toastMessage;

    private IEnumerable<LookupOption> FilteredSections => lookups.Sections;

    private bool HasUnsavedChanges => employees.Any(e => e.Priority != e.InitialPriority);
    private int DirtyCount => employees.Count(e => e.Priority != e.InitialPriority);

    protected override async Task OnInitializedAsync()
    {
        lookups = await EmployeeRepository.GetLookupsAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        hasLoaded = true;
        try
        {
            employees = await EmployeeRepository.GetPriorityEmployeesAsync(
                null,
                selectedDepartmentId,
                selectedSectionId,
                selectedDesignationId,
                selectedStatus,
                searchQuery);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFilters()
    {
        selectedDepartmentId = null;
        selectedSectionId = null;
        selectedDesignationId = null;
        selectedStatus = "Active";
        searchQuery = string.Empty;
        employees.Clear();
        hasLoaded = false;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadDataAsync();
        }
    }

    private void MoveRowUp(int index)
    {
        if (index <= 0 || index >= employees.Count) return;
        var current = employees[index];
        var prev = employees[index - 1];

        var tempPriority = current.Priority;
        current.Priority = prev.Priority;
        prev.Priority = tempPriority;

        employees[index] = prev;
        employees[index - 1] = current;
    }

    private void MoveRowDown(int index)
    {
        if (index < 0 || index >= employees.Count - 1) return;
        var current = employees[index];
        var next = employees[index + 1];

        var tempPriority = current.Priority;
        current.Priority = next.Priority;
        next.Priority = tempPriority;

        employees[index] = next;
        employees[index + 1] = current;
    }

    private void AutoSequencePriorities()
    {
        for (int i = 0; i < employees.Count; i++)
        {
            employees[i].Priority = (i + 1);
        }
    }

    private async Task SaveChangesAsync()
    {
        var dirtyItems = employees.Where(e => e.Priority != e.InitialPriority).ToList();
        if (dirtyItems.Count == 0) return;

        isSaving = true;
        try
        {
            var updatePayload = dirtyItems.Select(e => (e.EmployeeId, e.Priority)).ToList();
            await EmployeeRepository.SaveEmployeePrioritiesAsync(updatePayload);

            foreach (var item in dirtyItems)
            {
                item.InitialPriority = item.Priority;
            }

            toastMessage = $"Successfully updated priorities for {updatePayload.Count} employee records.";
            StateHasChanged();
            _ = Task.Delay(4000).ContinueWith(_ => { toastMessage = null; InvokeAsync(StateHasChanged); });
        }
        finally
        {
            isSaving = false;
        }
    }
}
