@page "/UploadFile"
@page "/UploadAttendanceFile"
@using System.Data
@using System.Text.RegularExpressions
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject MasterRepository MasterRepository
@inject AttendanceRepository AttendanceRepository

<PageTitle>Upload Attendance File - TG Payroll</PageTitle>

@if (!loaded)
{
    <div class="control-entry-shell">
        <section class="control-form-panel">
            <div class="skeleton-shimmer" style="height:32px;width:240px;margin-bottom:12px;"></div>
            <div class="skeleton-shimmer" style="height:18px;width:380px;margin-bottom:24px;"></div>
            <div class="master-form-grid">
                <div class="skeleton-shimmer" style="height:48px;"></div>
                <div class="skeleton-shimmer" style="height:48px;"></div>
            </div>
        </section>
    </div>
}
else if (!hasAccess)
{
    <div class="database-error management-message">
        Access Restricted: You do not have permission to access the Attendance File Upload module.
    </div>
}
else
{
    <section class="management-heading">
        <div>
            <p class="eyebrow">TIME & ATTENDANCE MANAGEMENT</p>
            <h1>Upload Attendance File & Auto-Process</h1>
            <p>Import biometric device card punch logs, compute in/out timestamps, calculate overtime, and update attendance registers.</p>
        </div>
    </section>

    <!-- Floating Modern Toast Notifications (5-Second Auto-Dismiss) -->
    <div class="toast-notification-container">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="toast-item toast-success">
                <div class="toast-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div class="toast-body">
                    <div class="toast-title">Operation Successful</div>
                    <div class="toast-text">@successMessage</div>
                </div>
                <button type="button" class="toast-close-btn" @onclick="() => successMessage = null">&times;</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="toast-item toast-error">
                <div class="toast-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01"/></svg>
                </div>
                <div class="toast-body">
                    <div class="toast-title">Notice / Error</div>
                    <div class="toast-text">@errorMessage</div>
                </div>
                <button type="button" class="toast-close-btn" @onclick="() => errorMessage = null">&times;</button>
            </div>
        }
    </div>

    <!-- Main Entry Console Form -->
    <div class="control-entry-shell" style="margin-bottom:20px;">
        <section class="control-form-panel">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <div>
                    <h2 style="font-size:16px;font-weight:700;margin:0;color:#0f172a;">Attendance File Ingestion & Auto-Roster Engine</h2>
                    <p style="font-size:12px;color:#64748b;margin:2px 0 0;">Configure date range, select biometric terminal log file or auto-generate baseline rosters.</p>
                </div>
                <div style="display:flex;gap:6px;">
                    <button type="button" class="type-pill" style="cursor:pointer;border:1px solid #cbd5e1;" @onclick="SetDateToday">Today</button>
                    <button type="button" class="type-pill" style="cursor:pointer;border:1px solid #cbd5e1;" @onclick="SetDateYesterday">Yesterday</button>
                    <button type="button" class="type-pill" style="cursor:pointer;border:1px solid #cbd5e1;" @onclick="SetDateCurrentMonth">This Month</button>
                </div>
            </div>

            <form @onsubmit="ProcessUploadedFile" @onsubmit:preventDefault>
                <div class="master-form-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
                    <label class="company-form-group">
                        <span class="company-form-label">From Date <strong class="req-star">*</strong></span>
                        <input type="date" value="@fromDate.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" class="company-form-input" />
                    </label>
                    <label class="company-form-group">
                        <span class="company-form-label">To Date <strong class="req-star">*</strong></span>
                        <input type="date" value="@toDate.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" class="company-form-input" />
                    </label>
                    <label class="company-form-group">
                        <span class="company-form-label">Department Filter (Optional)</span>
                        <select @bind="selectedDeptId" class="company-form-input">
                            <option value="">-- All Departments --</option>
                            @foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> }
                        </select>
                    </label>
                    <label class="company-form-group">
                        <span class="company-form-label">Shift Filter (Optional)</span>
                        <select @bind="selectedShiftId" class="company-form-input">
                            <option value="">-- All Shifts --</option>
                            @foreach (var sf in shifts) { <option value="@sf.ShiftId">@sf.ShiftName</option> }
                        </select>
                    </label>
                </div>

                <div style="margin-top:16px;display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:16px;">
                    <!-- Biometric File Input -->
                    <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                        <label class="company-form-label" style="margin-bottom:8px;display:block;">
                            <strong>Select Biometric Log File</strong> (.txt, .csv, .dat, .log)
                        </label>
                        <InputFile OnChange="HandleFileSelected" accept=".txt,.csv,.dat,.log" class="company-form-input" style="padding:8px 12px;background:#fff;cursor:pointer;" />
                        
                        @if (!string.IsNullOrWhiteSpace(uploadedFileName))
                        {
                            <div style="margin-top:10px;font-size:12px;color:#15803d;display:flex;align-items:center;gap:6px;">
                                <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span>Loaded: <strong>@uploadedFileName</strong> (@parsedPunchCount punches detected)</span>
                            </div>
                        }
                    </div>

                    <!-- Direct Raw Punch Stream Box -->
                    <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <label class="company-form-label" style="margin:0;">
                                <strong>Or Paste Direct Punch Stream</strong>
                            </label>
                            <button type="button" class="type-pill" style="cursor:pointer;font-size:11px;" @onclick="LoadSamplePunchLogs">Sample</button>
                        </div>
                        <textarea @bind="rawLogText" @bind:event="oninput" @onkeyup="CountPunchesInText"
                                  placeholder="EmpCode DateTime MachineNo&#10;1001 2026-08-24 08:02:15 1&#10;1001 2026-08-24 17:35:40 1"
                                  class="company-form-input" style="height:76px;font-family:monospace;font-size:12px;resize:vertical;"></textarea>
                    </div>
                </div>

                <div class="control-form-actions" style="margin-top:20px;gap:10px;flex-wrap:wrap;">
                    <button type="button" class="btn-secondary-action" @onclick="ResetForm">Reset</button>
                    <button type="button" class="btn-secondary-action" style="background:#16a34a;color:#fff;border:none;" disabled="@isProcessing" @onclick="InitializeRoster">
                        <span>@(isProcessing ? "Processing..." : "Auto-Calculate Roster (Leaves/Holidays/Weekends)")</span>
                    </button>
                    <button type="submit" class="btn-primary-action" disabled="@(isProcessing || string.IsNullOrWhiteSpace(rawLogText))">
                        <span>@(isProcessing ? "Processing..." : "Upload & Sync Punch Data")</span>
                    </button>
                </div>
            </form>
        </section>
    </div>

    <!-- Processing Result Card -->
    @if (processResult != null)
    {
        <!-- KPI Summary Cards -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:12px;margin-bottom:16px;">
            <div style="background:#fff;padding:12px;border-radius:10px;border:1px solid #e2e8f0;text-align:center;">
                <div style="font-size:11px;font-weight:700;color:#64748b;">TOTAL PUNCHES</div>
                <div style="font-size:18px;font-weight:800;color:#0f172a;">@processResult.TotalPunches</div>
            </div>
            <div style="background:#f0fdf4;padding:12px;border-radius:10px;border:1px solid #bbf7d0;text-align:center;">
                <div style="font-size:11px;font-weight:700;color:#16a34a;">PRESENT (P)</div>
                <div style="font-size:18px;font-weight:800;color:#15803d;">@processResult.UpdatedPresent</div>
            </div>
            <div style="background:#fef2f2;padding:12px;border-radius:10px;border:1px solid #fecaca;text-align:center;">
                <div style="font-size:11px;font-weight:700;color:#dc2626;">ABSENT (A)</div>
                <div style="font-size:18px;font-weight:800;color:#b91c1c;">@processResult.UpdatedAbsent</div>
            </div>
            <div style="background:#fefce8;padding:12px;border-radius:10px;border:1px solid #fef08a;text-align:center;">
                <div style="font-size:11px;font-weight:700;color:#ca8a04;">APPROVED LEAVES</div>
                <div style="font-size:18px;font-weight:800;color:#a16207;">@processResult.UpdatedLeave</div>
            </div>
            <div style="background:#eff6ff;padding:12px;border-radius:10px;border:1px solid #bfdbfe;text-align:center;">
                <div style="font-size:11px;font-weight:700;color:#2563eb;">WEEKEND / HOLIDAY</div>
                <div style="font-size:18px;font-weight:800;color:#1d4ed8;">@processResult.UpdatedWeekendHoliday</div>
            </div>
        </div>

        <section class="control-list-panel">
            <div class="control-list-header">
                <div>
                    <h2>Process Execution Report</h2>
                    <p>@processResult.SummaryMessage</p>
                </div>
                <a href="/AttendanceDetails" class="btn-primary-action" style="text-decoration:none;font-size:12px;padding:8px 14px;">
                    View Attendance Register &rarr;
                </a>
            </div>
        </section>
    }
}

@code {
    private bool loaded;
    private bool hasAccess;
    private int currentUserId;
    private bool isProcessing;

    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private int? selectedDeptId;
    private int? selectedShiftId;

    private string rawLogText = "";
    private string uploadedFileName = "";
    private int parsedPunchCount = 0;

    private List<DepartmentItem> departments = [];
    private List<ShiftOptionItem> shifts = [];
    private AttendanceProcessResult? processResult;

    // 5-Second Auto-Dismiss Toast
    private string? _successMessage;
    private string? successMessage
    {
        get => _successMessage;
        set
        {
            _successMessage = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _errorMessage = null;
                ScheduleToastDismiss();
            }
        }
    }

    private string? _errorMessage;
    private string? errorMessage
    {
        get => _errorMessage;
        set
        {
            _errorMessage = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                _successMessage = null;
                ScheduleToastDismiss();
            }
        }
    }

    private CancellationTokenSource? toastCts;
    private void ScheduleToastDismiss()
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        _successMessage = null;
                        _errorMessage = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdStr = session?.GetString("UserId");
        if (!int.TryParse(userIdStr, out currentUserId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        hasAccess = true;
        departments = await MasterRepository.GetDepartmentsAsync();
        shifts = await AttendanceRepository.GetShiftsAsync();
        loaded = true;
    }

    private void SetDateToday()
    {
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
    }

    private void SetDateYesterday()
    {
        fromDate = DateTime.Today.AddDays(-1);
        toDate = DateTime.Today.AddDays(-1);
    }

    private void SetDateCurrentMonth()
    {
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = fromDate.AddMonths(1).AddDays(-1);
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt)) fromDate = dt;
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt)) toDate = dt;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                uploadedFileName = file.Name;
                using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream);
                rawLogText = await reader.ReadToEndAsync();
                CountPunchesInText();
                successMessage = $"Loaded '{uploadedFileName}' with {parsedPunchCount} punches. Click 'Upload & Sync' to process.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"File Read Error: {ex.Message}";
        }
    }

    private void CountPunchesInText()
    {
        if (string.IsNullOrWhiteSpace(rawLogText))
        {
            parsedPunchCount = 0;
            return;
        }
        parsedPunchCount = ParsePunchLogs(rawLogText).Count;
    }

    private void LoadSamplePunchLogs()
    {
        var today = DateTime.Today.ToString("yyyy-MM-dd");
        rawLogText = $"1001 {today} 08:02:15 1\n1001 {today} 17:35:40 1\n1002 {today} 08:14:20 1\n1002 {today} 18:45:10 1\n1003 {today} 07:55:00 1";
        CountPunchesInText();
    }

    private void ResetForm()
    {
        rawLogText = "";
        uploadedFileName = "";
        parsedPunchCount = 0;
        processResult = null;
    }

    private async Task ProcessUploadedFile()
    {
        if (string.IsNullOrWhiteSpace(rawLogText))
        {
            errorMessage = "Please choose an attendance file or paste punch logs first.";
            return;
        }

        isProcessing = true;
        try
        {
            var punchList = ParsePunchLogs(rawLogText);
            if (punchList.Count == 0)
            {
                errorMessage = "Could not parse any valid punch timestamps from the input.";
                return;
            }

            processResult = await AttendanceRepository.UploadAndProcessPunchLogsAsync(punchList, fromDate, toDate, currentUserId);
            successMessage = processResult.SummaryMessage;
        }
        catch (Exception ex)
        {
            errorMessage = $"Processing Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task InitializeRoster()
    {
        isProcessing = true;
        try
        {
            processResult = await AttendanceRepository.ProcessAttendanceForDateRangeAsync(fromDate, toDate, null, selectedDeptId, selectedShiftId, currentUserId);
            successMessage = processResult.SummaryMessage;
        }
        catch (Exception ex)
        {
            errorMessage = $"Initialization Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private List<RawPunchLogItem> ParsePunchLogs(string text)
    {
        var list = new List<RawPunchLogItem>();
        var lines = text.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var line in lines)
        {
            var cleanLine = line.Trim();
            if (string.IsNullOrWhiteSpace(cleanLine) || cleanLine.StartsWith("#") || cleanLine.StartsWith("//")) continue;

            // Pattern 1: CSV format: EmpCode, DateTime, MachineNo
            var parts = cleanLine.Split(new[] { ',', '\t' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
            {
                var code = parts[0].Trim();
                var dtStr = parts[1].Trim();
                if (DateTime.TryParse(dtStr, out var parsedDt))
                {
                    var machine = parts.Length > 2 ? parts[2].Trim() : "1";
                    list.Add(new RawPunchLogItem
                    {
                        EmpCode = code,
                        PunchDateTime = parsedDt,
                        MachineNo = machine
                    });
                    continue;
                }
            }

            // Pattern 2: Space separated: EmpCode Date Time MachineNo (Standard ZK format)
            var spaceParts = cleanLine.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (spaceParts.Length >= 3)
            {
                var code = spaceParts[0].Trim();
                var dtStr = spaceParts[1] + " " + spaceParts[2];
                if (DateTime.TryParse(dtStr, out var parsedDt))
                {
                    var machine = spaceParts.Length > 3 ? spaceParts[3].Trim() : "1";
                    list.Add(new RawPunchLogItem
                    {
                        EmpCode = code,
                        PunchDateTime = parsedDt,
                        MachineNo = machine
                    });
                }
            }
        }
        return list;
    }
}
