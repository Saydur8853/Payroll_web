@page "/UserManagement"
@using System.Web
@inject IHttpContextAccessor HttpContextAccessor
@inject PayrollRepository PayrollRepository
@inject NavigationManager Navigation
@inject ILogger<UserManagement> Logger

<PageTitle>User & System Management - TG Payroll</PageTitle>

@if (!loaded)
{
    <div class="skeleton-shell">
        <div class="skeleton-header-card">
            <div class="skeleton-box" style="width:200px;height:12px;"></div>
            <div class="skeleton-box" style="width:340px;height:32px;border-radius:8px;"></div>
            <div class="skeleton-box" style="width:500px;height:14px;"></div>
        </div>

        <div style="display:flex;gap:8px;margin-bottom:8px;">
            <div class="skeleton-box" style="width:140px;height:38px;border-radius:10px;"></div>
            <div class="skeleton-box" style="width:140px;height:38px;border-radius:10px;"></div>
            <div class="skeleton-box" style="width:140px;height:38px;border-radius:10px;"></div>
        </div>

        <div class="skeleton-card">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div class="skeleton-box" style="width:240px;height:22px;"></div>
                <div class="skeleton-box" style="width:100px;height:14px;"></div>
            </div>
            <div class="skeleton-grid">
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:120px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:110px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
                <div class="skeleton-field">
                    <div class="skeleton-box" style="width:100px;height:13px;"></div>
                    <div class="skeleton-box" style="width:100%;height:40px;border-radius:8px;"></div>
                </div>
            </div>
        </div>

        <div class="skeleton-card">
            <div class="skeleton-table-wrap">
                <table class="skeleton-table">
                    <thead>
                        <tr>
                            <th style="width:60px;"><div class="skeleton-box" style="width:40px;height:12px;"></div></th>
                            <th><div class="skeleton-box" style="width:150px;height:12px;"></div></th>
                            <th><div class="skeleton-box" style="width:100px;height:12px;"></div></th>
                            <th style="width:120px;"><div class="skeleton-box" style="width:80px;height:12px;"></div></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < 4; i++)
                        {
                            <tr>
                                <td><div class="skeleton-box" style="width:36px;height:18px;border-radius:12px;"></div></td>
                                <td><div class="skeleton-box" style="width:180px;height:14px;"></div></td>
                                <td><div class="skeleton-box" style="width:80px;height:18px;border-radius:12px;"></div></td>
                                <td>
                                    <div style="display:flex;gap:6px;">
                                        <div class="skeleton-box" style="width:40px;height:24px;border-radius:6px;"></div>
                                        <div class="skeleton-box" style="width:45px;height:24px;border-radius:6px;"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (!hasAccess)
{
    <div class="database-error management-message">
        Access Restricted: You do not have permission to view User & System Management.
    </div>
}
else
{
    <section class="management-heading">
        <div>
            <p class="eyebrow">ADMINISTRATION & SECURITY</p>
            <h1>User & System Management</h1>
            <p>Manage system user privileges, controls, company settings, and task activity tracking.</p>
        </div>
    </section>

    <!-- Navigation Tabs -->
    <div class="management-tabs-container">
        <div class="management-tabs">
            @if (canAccessUserPrivileges)
            {
                <button type="button" class="tab-btn @(activeTab == "users" ? "active" : "")" @onclick='() => SetTab("users")'>
                    <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                    <span>User Privileges</span>
                </button>
            }
            @if (canAccessControlEntry)
            {
                <button type="button" class="tab-btn @(activeTab == "controls" ? "active" : "")" @onclick='() => SetTab("controls")'>
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                    <span>Control Entry</span>
                    <span class="tab-badge">@allControls.Count</span>
                </button>
            }
            @if (canAccessTrackingTask)
            {
                <button type="button" class="tab-btn @(activeTab == "tracking" ? "active" : "")" @onclick='() => SetTab("tracking")'>
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                    <span>Tracking Task</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="success-message">@successMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="database-error management-message">@errorMessage</div>
    }

    @if (showConfirmModal)
    {
        <div class="modal-backdrop-overlay" @onclick="CancelDelete">
            <div class="confirm-delete-modal" @onclick:stopPropagation>
                <div class="confirm-modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3>Are you sure?</h3>
                <p>Do you really want to delete control <strong>@confirmControlName</strong>? This action cannot be undone.</p>
                <div class="confirm-modal-actions">
                    <button type="button" class="btn-cancel-modal" @onclick="CancelDelete">No, Cancel</button>
                    <button type="button" class="btn-confirm-delete" @onclick="ExecuteConfirmedDelete">Yes, Delete</button>
                </div>
            </div>
        </div>
    }

    <!-- TAB 1: CONTROL ENTRY & MENU MASTER -->
    @if (activeTab == "controls" && canAccessControlEntry)
    {
        <div class="control-entry-shell">
            <!-- Control Form Card -->
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>@(editControlId > 0 ? $"Edit Control (ID: {editControlId})" : "Add New Control")</h2>
                    <p>Register a new system menu, module, or screen control into the database.</p>
                </div>
                <form @onsubmit="SaveControl" @onsubmit:preventDefault>
                    <div class="control-form-fields">
                        <label>
                            <span>Control / Menu Name <span style="color:#e11d48;">*</span></span>
                            <input @bind="controlNameInput" @bind:event="oninput" placeholder="e.g. Daily Attendance Report" required maxlength="120" />
                        </label>

                        <label>
                            <span>Parent / Calling Menu (Destination)</span>
                            <select @bind="callingIdInput">
                                <option value="">🌟 [Create as New Main / Root Category on Sidebar]</option>
                                <optgroup label="📂 Existing Category Folders (Place as Sub-Menu inside)">
                                    @foreach (var parent in moduleTree.OrderBy(m => m.Name))
                                    {
                                        <option value="@parent.Id">
                                            📂 @parent.Name (ID: @parent.Id) — contains @(parent.Children.Count) sub-menus
                                        </option>
                                    }
                                </optgroup>
                            </select>
                            <small class="field-hint">Choose where this menu item will be located.</small>
                        </label>

                        <label>
                            <span>Control Type</span>
                            <select @bind="controlTypeInput">
                                @foreach (var ctype in controlTypes)
                                {
                                    <option value="@ctype">@ctype</option>
                                }
                            </select>
                        </label>

                        <label>
                            <span>Priority Sequence</span>
                            <input @bind="priorityInput" type="number" min="0" max="9999" required />
                        </label>
                    </div>

                    <div class="control-location-preview">
                        <span class="preview-label">📍 Live Placement Preview:</span>
                        <div class="preview-breadcrumb">
                            <span class="crumb-item crumb-sidebar">📌 Sidebar</span>
                            <span class="crumb-sep">➔</span>
                            @if (callingIdInput is null or 0)
                            {
                                <span class="crumb-item crumb-child">📁 @(string.IsNullOrWhiteSpace(controlNameInput) ? "New Item" : controlNameInput) (Main Sidebar Category)</span>
                            }
                            else
                            {
                                var parentName = moduleTree.FirstOrDefault(m => m.Id == callingIdInput)?.Name ?? "Parent";
                                <span class="crumb-item crumb-parent">📂 @parentName</span>
                                <span class="crumb-sep">➔</span>
                                <span class="crumb-item crumb-child">↳ 📄 @(string.IsNullOrWhiteSpace(controlNameInput) ? "New Item" : controlNameInput)</span>
                            }
                        </div>
                    </div>

                    <div class="control-form-actions">
                        <button type="button" class="btn-secondary-action" @onclick="ResetControlForm">
                            <span>Reset Form</span>
                        </button>
                        <button type="submit" class="btn-primary-action @(editControlId > 0 ? "btn-update-mode" : "")">
                            <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/></svg>
                            <span>@(editControlId > 0 ? $"Update Control (ID: {editControlId})" : "Save New Control")</span>
                        </button>
                    </div>
                </form>
            </section>

            <!-- Controls Data Grid & Table -->
            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Registered System Controls</h2>
                        <p>Total @allControls.Count controls in database `CONTROLS` table.</p>
                    </div>
                    <div class="control-toolbar-actions">
                        <div class="control-sort-wrap">
                            <label>Sort by:</label>
                            <select @bind="controlsSortOption">
                                <option value="priority-asc">Priority (Low → High)</option>
                                <option value="priority-desc">Priority (High → Low)</option>
                                <option value="id-asc">Control ID (1 → N)</option>
                                <option value="id-desc">Control ID (N → 1)</option>
                                <option value="name-asc">Control Name (A → Z)</option>
                                <option value="name-desc">Control Name (Z → A)</option>
                                <option value="parent-asc">Parent Menu (A → Z)</option>
                                <option value="type-asc">Type (A → Z)</option>
                            </select>
                        </div>
                        <div class="control-search-wrap">
                            <input type="text" placeholder="Search controls..." @bind="controlsSearchQuery" @bind:event="oninput" />
                        </div>
                    </div>
                </div>

                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width: 60px;">ID</th>
                                <th>Control Name</th>
                                <th>Parent Menu</th>
                                <th style="width: 80px;">Type</th>
                                <th style="width: 75px;">Priority</th>
                                <th style="width: 110px; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ctrl in SortedFilteredControls)
                            {
                                <tr>
                                    <td><span class="id-badge">#@ctrl.ControlId</span></td>
                                    <td><strong class="ctrl-name-text">@ctrl.ControlName</strong></td>
                                    <td>
                                        @if (ctrl.CallingId is null or 0)
                                        {
                                            <span class="badge-root">Root Category</span>
                                        }
                                        else
                                        {
                                            <span class="badge-sub">↳ @ctrl.ParentName</span>
                                        }
                                    </td>
                                    <td><span class="type-pill">@ctrl.ControlType</span></td>
                                    <td><span class="priority-text">@ctrl.Priority</span></td>
                                    <td style="text-align: center;">
                                        <div class="table-action-group">
                                            <button type="button" class="action-btn btn-edit-ctrl" @onclick="() => EditControl(ctrl)" title="Edit this control">
                                                Edit
                                            </button>
                                            <button type="button" class="action-btn btn-delete-ctrl" @onclick="() => PromptDeleteControl(ctrl)" title="Delete control">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- TAB 3: TRACKING TASK & AUDIT -->
    @if (activeTab == "tracking" && canAccessTrackingTask)
    {
        <div class="control-entry-shell">
            <section class="control-form-panel">
                <div class="create-user-title">
                    <h2>Task & User Activity Tracking</h2>
                    <p>Real-time audit log, active user sessions, and database operation status.</p>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;margin-top:14px;">
                    <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                        <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">ACTIVE OPERATOR</span>
                        <strong style="font-size:18px;color:#0f172a;margin-top:4px;display:block;">@currentUserName</strong>
                        <small style="color:#16a34a;font-weight:700;">● Online Session</small>
                    </div>
                    <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                        <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">ORGANIZATION</span>
                        <strong style="font-size:18px;color:#0f172a;margin-top:4px;display:block;">@companyName</strong>
                        <small style="color:#64748b;">Active Company</small>
                    </div>
                    <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                        <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">TOTAL SYSTEM USERS</span>
                        <strong style="font-size:18px;color:#2563eb;margin-top:4px;display:block;">@users.Count Accounts</strong>
                        <small style="color:#64748b;">@users.Count(u => u.Admin == 1) Admins</small>
                    </div>
                    <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                        <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">REGISTERED CONTROLS</span>
                        <strong style="font-size:18px;color:#059669;margin-top:4px;display:block;">@allControls.Count Modules</strong>
                        <small style="color:#64748b;">CONTROLS table live</small>
                    </div>
                </div>
            </section>

            <section class="control-list-panel">
                <div class="control-list-header">
                    <div>
                        <h2>Recent System Activity & User Accounts</h2>
                        <p>Live tracking of registered payroll operator profiles.</p>
                    </div>
                </div>

                <div class="controls-table-container">
                    <table class="controls-data-table">
                        <thead>
                            <tr>
                                <th style="width:70px;">User ID</th>
                                <th>Username</th>
                                <th>Role / Privilege</th>
                                <th>Company Affiliation</th>
                                <th>Assigned Modules</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                var count = (user.PrivilegeArray ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                                <tr>
                                    <td><span class="id-badge">#@user.UserId</span></td>
                                    <td><strong class="ctrl-name-text">@user.UserName</strong></td>
                                    <td>
                                        @if (user.Admin == 1)
                                        {
                                            <span class="admin-badge">Administrator (Full Access)</span>
                                        }
                                        else
                                        {
                                            <span class="type-pill">Standard User</span>
                                        }
                                    </td>
                                    <td><span>@(string.IsNullOrWhiteSpace(user.CompanyId) ? "Default" : "Company #" + user.CompanyId)</span></td>
                                    <td>
                                        <span class="type-pill" style="background:#eff6ff;color:#1d4ed8;">@(user.Admin == 1 ? "All (" + modules.Count + ")" : count + " Modules")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    <!-- TAB 4: USER ROLES & ACCESS -->
    @if (activeTab == "users" && canAccessUserPrivileges)
    {
        <section class="create-user-panel user-create-panel">
            <div class="create-user-title"><div><h2>Add New User Account</h2><p>Create a login and assign its role and module privileges.</p></div></div>
            <form @onsubmit="CreateUser" @onsubmit:preventDefault>
                <div class="user-fields">
                    <label><span>Username</span><input @bind="newUsername" maxlength="80" autocomplete="off" required /></label>
                    <label><span>Password</span><input @bind="newPassword" type="password" maxlength="50" autocomplete="new-password" required /></label>
                    <label>
                        <span>Role</span>
                        <select @bind="newRole" @bind:after="OnNewUserRoleChanged">
                            <option value="User">Standard user</option>
                            <option value="Admin">Administrator</option>
                        </select>
                    </label>
                </div>
                <div class="create-module-heading">
                    <h3>Module Privileges (Hierarchical Categories)</h3>
                    <span>Selecting a Root Category automatically checks its sub-menus. Admin role receives all modules.</span>
                </div>
                <div class="privilege-tree-container">
                    @foreach (var root in moduleTree)
                    {
                        <div class="privilege-group-card">
                            <div class="privilege-group-header">
                                <label class="privilege-root-label">
                                    <input type="checkbox"
                                           checked="@newUserModuleIds.Contains(root.Id)"
                                           disabled="@(newRole == "Admin")"
                                           @onchange="(e) => ToggleNewUserRoot(root, (bool)(e.Value ?? false))" />
                                    <span>📁 @root.Name <small style="color:#64748b;font-weight:normal;">(ID: @root.Id)</small></span>
                                </label>
                                <div class="privilege-group-meta">
                                    <span class="privilege-count-badge">@(root.Children.Count > 0 ? root.Children.Count + " sub-menus" : "Root module")</span>
                                    @if (root.Children.Count > 0 && newRole != "Admin")
                                    {
                                        <button type="button" class="privilege-toggle-btn" @onclick="() => ToggleNewUserAll(root)">Toggle All</button>
                                    }
                                </div>
                            </div>
                            @if (root.Children.Count > 0)
                            {
                                <div class="privilege-group-body">
                                    <div class="privilege-children-grid">
                                        @foreach (var child in root.Children)
                                        {
                                            <label class="privilege-child-option">
                                                <input type="checkbox"
                                                       checked="@newUserModuleIds.Contains(child.Id)"
                                                       disabled="@(newRole == "Admin")"
                                                       @onchange="(e) => ToggleNewUserChild(root, child.Id, (bool)(e.Value ?? false))" />
                                                <div class="privilege-child-info">
                                                    <strong>↳ @child.Name</strong>
                                                    <small>Module ID: @child.Id</small>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="module-actions"><button type="submit">Create User</button></div>
            </form>
        </section>

        <div class="management-shell">
            <aside class="user-list-panel">
                <h2>User Accounts</h2>
                @foreach (var user in users)
                {
                    <button type="button" class="user-row @(user.UserId == selectedUserId ? "selected" : "")" @onclick="() => SelectUser(user.UserId)" style="border:none;background:transparent;text-align:left;width:100%;cursor:pointer;">
                        <span class="user-avatar">@((user.UserName ?? "U")[0].ToString().ToUpper())</span>
                        <span><strong>@user.UserName</strong><small>@(user.Admin == 1 ? "Administrator" : "Standard user")</small></span>
                    </button>
                }
            </aside>

            <section class="module-panel">
                @if (selectedUser is null)
                {
                    <p>No user found.</p>
                }
                else
                {
                    <div class="module-panel-title">
                        <div><h2>Module Access Permissions</h2><p>@selectedUser.UserName · @(selectedUserIsAdmin ? "Administrator" : "Standard user")</p></div>
                        @if (selectedUserIsAdmin)
                        {
                            <span class="admin-badge">All modules enabled</span>
                        }
                    </div>
                    <form @onsubmit="SavePrivileges" @onsubmit:preventDefault>
                        <div class="privilege-tree-container">
                            @foreach (var root in moduleTree)
                            {
                                <div class="privilege-group-card">
                                    <div class="privilege-group-header">
                                        <label class="privilege-root-label">
                                            <input type="checkbox"
                                                   checked="@selectedModuleIds.Contains(root.Id)"
                                                   disabled="@selectedUserIsAdmin"
                                                   @onchange="(e) => ToggleSelectedRoot(root, (bool)(e.Value ?? false))" />
                                            <span>📁 @root.Name <small style="color:#64748b;font-weight:normal;">(ID: @root.Id)</small></span>
                                        </label>
                                        <div class="privilege-group-meta">
                                            <span class="privilege-count-badge">@(root.Children.Count > 0 ? root.Children.Count + " sub-menus" : "Root module")</span>
                                            @if (root.Children.Count > 0 && !selectedUserIsAdmin)
                                            {
                                                <button type="button" class="privilege-toggle-btn" @onclick="() => ToggleSelectedAll(root)">Toggle All</button>
                                            }
                                        </div>
                                    </div>
                                    @if (root.Children.Count > 0)
                                    {
                                        <div class="privilege-group-body">
                                            <div class="privilege-children-grid">
                                                @foreach (var child in root.Children)
                                                {
                                                    <label class="privilege-child-option">
                                                        <input type="checkbox"
                                                               checked="@selectedModuleIds.Contains(child.Id)"
                                                               disabled="@selectedUserIsAdmin"
                                                               @onchange="(e) => ToggleSelectedChild(root, child.Id, (bool)(e.Value ?? false))" />
                                                        <div class="privilege-child-info">
                                                            <strong>↳ @child.Name</strong>
                                                            <small>Module ID: @child.Id</small>
                                                        </div>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="module-actions" style="margin-top: 18px;"><button type="submit">Save Module Access</button></div>
                    </form>
                }
            </section>
        </div>
    }
}

@code {
    private const int DashboardModuleId = 184;

    [SupplyParameterFromQuery(Name = "activeTab")]
    public string? QueryActiveTab { get; set; }

    [SupplyParameterFromQuery(Name = "userId")]
    public int? QueryUserId { get; set; }

    private bool loaded;
    private bool hasAccess;
    private bool canAccessUserPrivileges;
    private bool canAccessControlEntry;
    private bool canAccessTrackingTask;
    private string activeTab = "users";
    private string currentUserName = "User";
    private string companyName = "Payroll";
    private bool currentUserIsAdmin;
    private int currentUserId;

    private List<PayrollUser> users = [];
    private List<NavigationItem> modules = [];
    private List<NavigationItem> moduleTree = [];
    private List<ControlItem> allControls = [];
    private List<string> controlTypes = ["MENU", "FORM", "REPORT", "BUTTON"];
    private PayrollUser? selectedUser;
    private bool selectedUserIsAdmin => selectedUser?.Admin == 1;

    private int selectedUserId;
    private HashSet<int> selectedModuleIds = [];

    private string newUsername = string.Empty;
    private string newPassword = string.Empty;
    private string newRole = "User";
    private HashSet<int> newUserModuleIds = [DashboardModuleId];

    // Control Entry
    private int editControlId;
    private string controlNameInput = string.Empty;
    private int? callingIdInput;
    private string controlTypeInput = "MENU";
    private int priorityInput = 1;
    private string controlsSearchQuery = string.Empty;
    private string controlsSortOption = "priority-asc";

    // Feedback messages
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdStr = session?.GetString("UserId");
        if (!int.TryParse(userIdStr, out currentUserId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        currentUserName = session?.GetString("UserName") ?? "User";
        companyName = session?.GetString("CompanyName") ?? "Payroll";
        currentUserIsAdmin = session?.GetString("IsAdmin") == "1";

        var menu = await PayrollRepository.GetMenuAsync(currentUserId);
        canAccessUserPrivileges = currentUserIsAdmin || HasModuleRecursive(menu, item => 
            item.Id == 112 || 
            item.Name.Equals("User Privilage", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("User Privilege", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("User Privileges", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("User Control", StringComparison.OrdinalIgnoreCase));

        canAccessControlEntry = currentUserIsAdmin || HasModuleRecursive(menu, item => 
            item.Id == 23 || 
            item.Name.Equals("Control Entry", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("Control_Entry", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("Add Features", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("Feature Entry", StringComparison.OrdinalIgnoreCase));

        canAccessTrackingTask = currentUserIsAdmin || HasModuleRecursive(menu, item => 
            item.Id == 111 || 
            item.Name.Equals("Tracking Task", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Equals("Task Tracking", StringComparison.OrdinalIgnoreCase));

        hasAccess = canAccessUserPrivileges || canAccessControlEntry || canAccessTrackingTask;

        if (!hasAccess)
        {
            loaded = true;
            return;
        }

        ResolveActiveTab();
        await LoadDataAsync(QueryUserId);
        loaded = true;
    }

    protected override void OnParametersSet()
    {
        if (loaded && !string.IsNullOrWhiteSpace(QueryActiveTab))
        {
            ResolveActiveTab();
        }
    }

    private void ResolveActiveTab()
    {
        var requested = QueryActiveTab?.ToLowerInvariant();
        if (requested == "controls" && canAccessControlEntry)
        {
            activeTab = "controls";
        }
        else if (requested == "tracking" && canAccessTrackingTask)
        {
            activeTab = "tracking";
        }
        else if (requested == "users" && canAccessUserPrivileges)
        {
            activeTab = "users";
        }
        else
        {
            if (canAccessUserPrivileges) activeTab = "users";
            else if (canAccessControlEntry) activeTab = "controls";
            else if (canAccessTrackingTask) activeTab = "tracking";
            else activeTab = "controls";
        }
    }

    private void SetTab(string tab)
    {
        if (tab == "users" && !canAccessUserPrivileges) return;
        if (tab == "controls" && !canAccessControlEntry) return;
        if (tab == "tracking" && !canAccessTrackingTask) return;
        activeTab = tab;
        successMessage = null;
        errorMessage = null;
    }

    private async Task LoadDataAsync(int? preferredUserId)
    {
        users = await PayrollRepository.GetUsersAsync();
        modules = await PayrollRepository.GetAllMenuControlsAsync();
        moduleTree = await PayrollRepository.GetAllMenuTreeAsync();
        allControls = await PayrollRepository.GetControlsDetailedAsync();

        if (users.Count > 0)
        {
            var targetId = preferredUserId ?? selectedUserId;
            selectedUser = users.FirstOrDefault(u => u.UserId == targetId) ?? users[0];
            selectedUserId = selectedUser.UserId;
            LoadSelectedUserModules();
        }
    }

    private void SelectUser(int userId)
    {
        selectedUserId = userId;
        selectedUser = users.FirstOrDefault(u => u.UserId == userId);
        LoadSelectedUserModules();
        successMessage = null;
        errorMessage = null;
    }

    private void LoadSelectedUserModules()
    {
        if (selectedUser is null)
        {
            selectedModuleIds.Clear();
            return;
        }

        if (selectedUser.Admin == 1)
        {
            selectedModuleIds = modules.Select(m => m.Id).ToHashSet();
        }
        else
        {
            var ids = (selectedUser.PrivilegeArray ?? string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(id => int.TryParse(id, out var parsed) ? parsed : 0)
                .Where(id => id > 0)
                .ToHashSet();
            selectedModuleIds = ids;
        }
    }

    private void OnNewUserRoleChanged()
    {
        if (newRole == "Admin")
        {
            newUserModuleIds = modules.Select(m => m.Id).ToHashSet();
        }
        else
        {
            newUserModuleIds = [DashboardModuleId];
        }
    }

    private void ToggleNewUserRoot(NavigationItem root, bool isChecked)
    {
        if (isChecked)
        {
            newUserModuleIds.Add(root.Id);
            foreach (var child in root.Children) newUserModuleIds.Add(child.Id);
        }
        else
        {
            newUserModuleIds.Remove(root.Id);
            foreach (var child in root.Children) newUserModuleIds.Remove(child.Id);
        }
    }

    private void ToggleNewUserChild(NavigationItem root, int childId, bool isChecked)
    {
        if (isChecked)
        {
            newUserModuleIds.Add(childId);
            newUserModuleIds.Add(root.Id);
        }
        else
        {
            newUserModuleIds.Remove(childId);
            if (!root.Children.Any(c => newUserModuleIds.Contains(c.Id)))
            {
                newUserModuleIds.Remove(root.Id);
            }
        }
    }

    private void ToggleNewUserAll(NavigationItem root)
    {
        var allChecked = root.Children.All(c => newUserModuleIds.Contains(c.Id));
        ToggleNewUserRoot(root, !allChecked);
    }

    private void ToggleSelectedRoot(NavigationItem root, bool isChecked)
    {
        if (isChecked)
        {
            selectedModuleIds.Add(root.Id);
            foreach (var child in root.Children) selectedModuleIds.Add(child.Id);
        }
        else
        {
            selectedModuleIds.Remove(root.Id);
            foreach (var child in root.Children) selectedModuleIds.Remove(child.Id);
        }
    }

    private void ToggleSelectedChild(NavigationItem root, int childId, bool isChecked)
    {
        if (isChecked)
        {
            selectedModuleIds.Add(childId);
            selectedModuleIds.Add(root.Id);
        }
        else
        {
            selectedModuleIds.Remove(childId);
            if (!root.Children.Any(c => selectedModuleIds.Contains(c.Id)))
            {
                selectedModuleIds.Remove(root.Id);
            }
        }
    }

    private void ToggleSelectedAll(NavigationItem root)
    {
        var allChecked = root.Children.All(c => selectedModuleIds.Contains(c.Id));
        ToggleSelectedRoot(root, !allChecked);
    }

    private async Task SavePrivileges()
    {
        if (!canAccessUserPrivileges)
        {
            errorMessage = "Access Denied: You do not have permission to modify user privileges.";
            return;
        }
        try
        {
            await PayrollRepository.UpdateUserPrivilegesAsync(selectedUserId, selectedModuleIds.ToList());
            users = await PayrollRepository.GetUsersAsync();
            selectedUser = users.FirstOrDefault(u => u.UserId == selectedUserId);
            successMessage = "Module permissions saved successfully.";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save user privileges");
            errorMessage = "Failed to save permissions: " + ex.Message;
        }
    }

    private async Task CreateUser()
    {
        if (!canAccessUserPrivileges)
        {
            errorMessage = "Access Denied: You do not have permission to create user accounts.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Username and password are required.";
            return;
        }

        try
        {
            var companyId = HttpContextAccessor.HttpContext?.Session?.GetString("CompanyId") ?? "1";
            var createdId = await PayrollRepository.CreateUserAsync(
                newUsername.Trim(),
                newPassword,
                newRole == "Admin",
                currentUserId,
                companyId,
                newUserModuleIds.ToList());

            newUsername = string.Empty;
            newPassword = string.Empty;
            newRole = "User";
            newUserModuleIds = [DashboardModuleId];

            await LoadDataAsync(createdId);
            successMessage = "User created successfully. The new user can now sign in.";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "User creation failed");
            errorMessage = "Failed to create user: " + ex.Message;
        }
    }

    // Controls CRUD
    private IEnumerable<ControlItem> SortedFilteredControls
    {
        get
        {
            var list = allControls.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(controlsSearchQuery))
            {
                var q = controlsSearchQuery.Trim();
                list = list.Where(c => 
                    c.ControlName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (c.ParentName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    c.ControlType.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    c.ControlId.ToString().Contains(q));
            }

            return controlsSortOption switch
            {
                "priority-desc" => list.OrderByDescending(c => c.Priority),
                "id-asc" => list.OrderBy(c => c.ControlId),
                "id-desc" => list.OrderByDescending(c => c.ControlId),
                "name-asc" => list.OrderBy(c => c.ControlName),
                "name-desc" => list.OrderByDescending(c => c.ControlName),
                "parent-asc" => list.OrderBy(c => c.ParentName ?? ""),
                "type-asc" => list.OrderBy(c => c.ControlType),
                _ => list.OrderBy(c => c.Priority)
            };
        }
    }

    private void EditControl(ControlItem ctrl)
    {
        editControlId = ctrl.ControlId;
        controlNameInput = ctrl.ControlName;
        callingIdInput = ctrl.CallingId;
        controlTypeInput = ctrl.ControlType;
        priorityInput = ctrl.Priority;
        successMessage = null;
        errorMessage = null;
    }

    private void ResetControlForm()
    {
        editControlId = 0;
        controlNameInput = string.Empty;
        callingIdInput = null;
        controlTypeInput = "MENU";
        priorityInput = 1;
        successMessage = null;
        errorMessage = null;
    }

    private async Task SaveControl()
    {
        if (!canAccessControlEntry)
        {
            errorMessage = "Access Denied: You do not have permission to modify system controls.";
            return;
        }
        if (string.IsNullOrWhiteSpace(controlNameInput))
        {
            errorMessage = "Control Name is required.";
            return;
        }

        try
        {
            if (editControlId > 0)
            {
                await PayrollRepository.UpdateControlAsync(
                    editControlId,
                    controlNameInput.Trim(),
                    callingIdInput,
                    controlTypeInput,
                    priorityInput);
                successMessage = $"Control '{controlNameInput}' updated successfully.";
            }
            else
            {
                await PayrollRepository.CreateControlAsync(
                    controlNameInput.Trim(),
                    callingIdInput,
                    controlTypeInput,
                    priorityInput);
                successMessage = $"Control '{controlNameInput}' registered successfully.";
            }

            ResetControlForm();
            allControls = await PayrollRepository.GetControlsDetailedAsync();
            moduleTree = await PayrollRepository.GetAllMenuTreeAsync();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save control");
            errorMessage = "Failed to save control: " + ex.Message;
        }
    }

    private async Task DeleteControl(ControlItem ctrl)
    {
        if (!canAccessControlEntry)
        {
            errorMessage = "Access Denied: You do not have permission to delete system controls.";
            return;
        }
        try
        {
            await PayrollRepository.DeleteControlAsync(ctrl.ControlId);
            allControls = await PayrollRepository.GetControlsDetailedAsync();
            moduleTree = await PayrollRepository.GetAllMenuTreeAsync();
            if (editControlId == ctrl.ControlId) ResetControlForm();
            successMessage = $"Control '{ctrl.ControlName}' deleted successfully.";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete control");
            errorMessage = "Failed to delete control: " + ex.Message;
        }
    }

    // Confirmation Modal State
    private bool showConfirmModal = false;
    private string confirmControlName = "";
    private ControlItem? pendingControlToDelete = null;

    private void PromptDeleteControl(ControlItem ctrl)
    {
        pendingControlToDelete = ctrl;
        confirmControlName = ctrl.ControlName;
        showConfirmModal = true;
    }

    private void CancelDelete()
    {
        showConfirmModal = false;
        pendingControlToDelete = null;
    }

    private async Task ExecuteConfirmedDelete()
    {
        if (pendingControlToDelete != null)
        {
            var ctrl = pendingControlToDelete;
            showConfirmModal = false;
            pendingControlToDelete = null;
            await DeleteControl(ctrl);
        }
    }

    private static bool HasModuleRecursive(IEnumerable<NavigationItem> items, Func<NavigationItem, bool> predicate)
    {
        foreach (var item in items)
        {
            if (predicate(item)) return true;
            if (item.Children.Count > 0 && HasModuleRecursive(item.Children, predicate)) return true;
        }
        return false;
    }
