    protected override async Task OnInitializedAsync()
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var userIdStr = session?.GetString("UserId");
        if (!int.TryParse(userIdStr, out currentUserId))
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        currentUserName = session?.GetString("UserName") ?? "User";
        companyName = session?.GetString("CompanyName") ?? "Payroll";
        currentUserIsAdmin = session?.GetString("IsAdmin") == "1";

        var menu = await PayrollRepository.GetMenuAsync(currentUserId);
        hasAccess = currentUserIsAdmin || HasModuleRecursive(menu, item => 
            item.Name.Contains("USER MANAGEMENT", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("USER & SYSTEM", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("User Privilege", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("Control Entry", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("User Management", StringComparison.OrdinalIgnoreCase));

        if (!hasAccess)
        {
            loaded = true;
            return;
        }

        if (!string.IsNullOrWhiteSpace(QueryActiveTab))
        {
            activeTab = QueryActiveTab.ToLowerInvariant();
        }

        await LoadDataAsync(QueryUserId);
        loaded = true;
    }

    protected override void OnParametersSet()
    {
        if (loaded && !string.IsNullOrWhiteSpace(QueryActiveTab) && QueryActiveTab != activeTab)
        {
            activeTab = QueryActiveTab.ToLowerInvariant();
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        successMessage = null;
        errorMessage = null;
    }

    private async Task LoadDataAsync(int? preferredUserId)
    {
        users = await PayrollRepository.GetUsersAsync();
        modules = await PayrollRepository.GetAllMenuControlsAsync();
        moduleTree = await PayrollRepository.GetAllMenuTreeAsync();
        allControls = await PayrollRepository.GetControlsDetailedAsync();
        companies = await PayrollRepository.GetCompaniesAsync();

        if (users.Count > 0)
        {
            var targetId = preferredUserId ?? selectedUserId;
            selectedUser = users.FirstOrDefault(u => u.UserId == targetId) ?? users[0];
            selectedUserId = selectedUser.UserId;
            LoadSelectedUserModules();
        }
    }

    private void SelectUser(int userId)
    {
        selectedUserId = userId;
        selectedUser = users.FirstOrDefault(u => u.UserId == userId);
        LoadSelectedUserModules();
        successMessage = null;
        errorMessage = null;
    }

    private void LoadSelectedUserModules()
    {
        if (selectedUser is null)
        {
            selectedModuleIds.Clear();
            return;
        }

        if (selectedUser.Admin == 1)
        {
            selectedModuleIds = modules.Select(m => m.Id).ToHashSet();
        }
        else
        {
            var ids = (selectedUser.PrivilegeArray ?? string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(id => int.TryParse(id, out var parsed) ? parsed : 0)
                .Where(id => id > 0)
                .ToHashSet();
            selectedModuleIds = ids;
        }
    }

    private void OnNewUserRoleChanged()
    {
        if (newRole == "Admin")
        {
            newUserModuleIds = modules.Select(m => m.Id).ToHashSet();
        }
        else
        {
            newUserModuleIds = [DashboardModuleId];
        }
    }

    private void ToggleNewUserRoot(NavigationItem root, bool isChecked)
    {
        if (isChecked)
        {
            newUserModuleIds.Add(root.Id);
            foreach (var child in root.Children) newUserModuleIds.Add(child.Id);
        }
        else
        {
            newUserModuleIds.Remove(root.Id);
            foreach (var child in root.Children) newUserModuleIds.Remove(child.Id);
        }
    }

    private void ToggleNewUserChild(NavigationItem root, int childId, bool isChecked)
    {
        if (isChecked)
        {
            newUserModuleIds.Add(childId);
            newUserModuleIds.Add(root.Id);
        }
        else
        {
            newUserModuleIds.Remove(childId);
            if (!root.Children.Any(c => newUserModuleIds.Contains(c.Id)))
            {
                newUserModuleIds.Remove(root.Id);
            }
        }
    }

    private void ToggleNewUserAll(NavigationItem root)
    {
        var allChecked = root.Children.All(c => newUserModuleIds.Contains(c.Id));
        ToggleNewUserRoot(root, !allChecked);
    }

    private void ToggleSelectedRoot(NavigationItem root, bool isChecked)
    {
        if (isChecked)
        {
            selectedModuleIds.Add(root.Id);
            foreach (var child in root.Children) selectedModuleIds.Add(child.Id);
        }
        else
        {
            selectedModuleIds.Remove(root.Id);
            foreach (var child in root.Children) selectedModuleIds.Remove(child.Id);
        }
    }

    private void ToggleSelectedChild(NavigationItem root, int childId, bool isChecked)
    {
        if (isChecked)
        {
            selectedModuleIds.Add(childId);
            selectedModuleIds.Add(root.Id);
        }
        else
        {
            selectedModuleIds.Remove(childId);
            if (!root.Children.Any(c => selectedModuleIds.Contains(c.Id)))
            {
                selectedModuleIds.Remove(root.Id);
            }
        }
    }

    private void ToggleSelectedAll(NavigationItem root)
    {
        var allChecked = root.Children.All(c => selectedModuleIds.Contains(c.Id));
        ToggleSelectedRoot(root, !allChecked);
    }

    private async Task SavePrivileges()
    {
        if (!hasAccess) return;
        try
        {
            await PayrollRepository.UpdateUserPrivilegesAsync(selectedUserId, selectedModuleIds.ToList());
            users = await PayrollRepository.GetUsersAsync();
            selectedUser = users.FirstOrDefault(u => u.UserId == selectedUserId);
            successMessage = "Module permissions saved successfully.";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save user privileges");
            errorMessage = "Failed to save permissions: " + ex.Message;
        }
    }

    private async Task CreateUser()
    {
        if (!hasAccess) return;
        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Username and password are required.";
            return;
        }

        try
        {
            var companyId = HttpContextAccessor.HttpContext?.Session?.GetString("CompanyId") ?? "1";
            var createdId = await PayrollRepository.CreateUserAsync(
                newUsername.Trim(),
                newPassword,
                newRole == "Admin",
                currentUserId,
                companyId,
                newUserModuleIds.ToList());

            newUsername = string.Empty;
            newPassword = string.Empty;
            newRole = "User";
            newUserModuleIds = [DashboardModuleId];

            await LoadDataAsync(createdId);
            successMessage = "User created successfully. The new user can now sign in.";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "User creation failed");
            errorMessage = "Failed to create user: " + ex.Message;
        }
    }

    // Controls CRUD
    private IEnumerable<ControlItem> SortedFilteredControls
    {
        get
        {
            var list = allControls.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(controlsSearchQuery))
            {
                var q = controlsSearchQuery.Trim();
                list = list.Where(c => 
                    c.ControlName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (c.ParentName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    c.ControlType.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    c.ControlId.ToString().Contains(q));
            }

            return controlsSortOption switch
            {
                "priority-desc" => list.OrderByDescending(c => c.Priority),
                "id-asc" => list.OrderBy(c => c.ControlId),
                "id-desc" => list.OrderByDescending(c => c.ControlId),
                "name-asc" => list.OrderBy(c => c.ControlName),
                "name-desc" => list.OrderByDescending(c => c.ControlName),
                "parent-asc" => list.OrderBy(c => c.ParentName ?? ""),
                "type-asc" => list.OrderBy(c => c.ControlType),
                _ => list.OrderBy(c => c.Priority)
            };
        }
    }

