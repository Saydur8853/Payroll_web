@page
@model AccountModel
@{
    ViewData["Title"] = "My Profile & Account Settings";
    bool HasModuleRecursive(IEnumerable<NavigationItem> items, Func<NavigationItem, bool> predicate)
    {
        foreach (var item in items)
        {
            if (predicate(item)) return true;
            if (item.Children.Count > 0 && HasModuleRecursive(item.Children, predicate)) return true;
        }
        return false;
    }

    bool hasDashboard = Model.CurrentUserIsAdmin || HasModuleRecursive(Model.Menu, item => item.Id == 184 || item.Name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase));
    bool hasUserManagement = Model.CurrentUserIsAdmin || HasModuleRecursive(Model.Menu, item => item.Name.Contains("USER MANAGEMENT", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("User Privilege", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Control Entry", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("User Management", StringComparison.OrdinalIgnoreCase));
}

<main class="dashboard-page">
    <header class="topbar">
        <a class="brand-link" href="/Dashboard">
            <div class="brand-badge">
                <span class="brand-mark small">TG</span>
            </div>
            <div class="brand-text-group">
                <span class="topbar-title">TG Payroll</span>
                <span class="topbar-tag">Enterprise HRIS</span>
            </div>
        </a>

        <div class="topbar-right">
            <div class="topbar-company-badge" title="Active Organization">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9zM7 13h2v2H7v-2zm4 0h2v2h-2v-2z" clip-rule="evenodd"/></svg>
                <span>@Model.CompanyName</span>
            </div>

            <a class="topbar-user-pill topbar-user-link active-profile" href="/Account" title="Manage Profile & Password">
                <div class="topbar-avatar">
                    <span>@(string.IsNullOrWhiteSpace(Model.CurrentUserName) ? "U" : Model.CurrentUserName[0].ToString().ToUpperInvariant())</span>
                    <span class="topbar-avatar-status"></span>
                </div>
                <div class="topbar-user-details">
                    <strong class="topbar-user-name">@Model.CurrentUserName</strong>
                    <small class="topbar-user-role">@(Model.CurrentUserIsAdmin ? "Administrator" : "Standard user")</small>
                </div>
            </a>

            <form method="post" action="/logout" style="margin:0;">
                <button type="submit" class="topbar-btn topbar-btn-signout" title="Sign out of your session">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M19 10a.75.75 0 00-.75-.75H8.704l2.47-2.47a.75.75 0 10-1.06-1.06l-3.75 3.75a.75.75 0 000 1.06l3.75 3.75a.75.75 0 101.06-1.06l-2.47-2.47h9.546A.75.75 0 0019 10z" clip-rule="evenodd"/></svg>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </header>

    <div class="application-shell">
        <aside class="sidebar">
            <div class="sidebar-header">
                <span class="sidebar-section-title">Navigation</span>
            </div>

            <div class="sidebar-search-box">
                <svg viewBox="0 0 20 20" fill="currentColor" class="sidebar-search-icon">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
                <input type="text"
                       class="sidebar-search-input"
                       id="sidebar-search-input"
                       placeholder="Search modules..."
                       oninput="filterSidebarItems()" />
            </div>

            @if (hasDashboard || hasUserManagement)
            {
                <div class="sidebar-quick-nav">
                    @if (hasDashboard)
                    {
                        <a class="dashboard-link" href="/Dashboard">
                            <span class="menu-icon-wrap dashboard-icon-wrap">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                                </svg>
                            </span>
                            <span class="menu-text">Dashboard</span>
                            <span class="menu-pill-indicator"></span>
                        </a>
                    }
                    @if (hasUserManagement)
                    {
                        <a class="dashboard-link" href="/UserManagement">
                            <span class="menu-icon-wrap user-nav-icon-wrap">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
                                </svg>
                            </span>
                            <span class="menu-text">User Management</span>
                            <span class="menu-pill-indicator"></span>
                        </a>
                    }
                </div>
            }

            <div class="sidebar-divider">
                <span>Payroll Modules</span>
            </div>

            <nav class="sidebar-nav" id="sidebar-nav-container" aria-label="Payroll modules">
                @foreach (var item in Model.Menu.Where(m => m.Id != 184 && !m.Name.Contains("USER MANAGEMENT", StringComparison.OrdinalIgnoreCase)))
                {
                    @await Html.PartialAsync("_MenuItem", item)
                }
            </nav>

            <div class="sidebar-footer-card">
                <div class="sidebar-footer-header">
                    <div class="sidebar-footer-dot"></div>
                    <span class="sidebar-footer-label">System Online</span>
                </div>
                <div class="sidebar-footer-meta">
                    <strong title="@Model.CompanyName">@Model.CompanyName</strong>
                    <small>TG Payroll Enterprise</small>
                </div>
            </div>
        </aside>

        <div class="dashboard-content">
            <section class="management-heading">
                <div>
                    <p class="eyebrow">MY PROFILE</p>
                    <h1>Account & Login Settings</h1>
                    <p>Manage your login credentials and personal account preferences.</p>
                </div>
            </section>

            @if (Model.CredentialsUpdated)
            {
                <div class="success-message">Your username and password were updated successfully.</div>
            }
            @if (Model.CredentialError is not null)
            {
                <div class="database-error management-message">@Model.CredentialError</div>
            }

            <section class="create-user-panel account-panel" style="max-width: 680px;">
                <div class="create-user-title">
                    <div>
                        <h2>Update Credentials</h2>
                        <p>Change your login username or set a new password. Internal numeric user ID remains unchanged.</p>
                    </div>
                </div>
                <form method="post" asp-page-handler="UpdateCredentials">
                    <div class="user-fields account-fields">
                        <label>
                            <span>Login username</span>
                            <input asp-for="AccountUsername" maxlength="80" autocomplete="username" required />
                        </label>
                        <label>
                            <span>Current password <span style="color:#e11d48;">*</span></span>
                            <span class="password-field">
                                <input asp-for="CurrentPassword" type="password" maxlength="50" autocomplete="current-password" required />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" title="Show password">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 12s3.5-6 9.6-6 9.6 6 9.6 6-3.5 6-9.6 6-9.6-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                                </button>
                            </span>
                        </label>
                        <label>
                            <span>New password (optional)</span>
                            <span class="password-field">
                                <input asp-for="NewAccountPassword" data-new-password type="password" maxlength="50" autocomplete="new-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" title="Show password">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 12s3.5-6 9.6-6 9.6 6 9.6 6-3.5 6-9.6 6-9.6-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                                </button>
                            </span>
                        </label>
                        <label>
                            <span>Confirm new password</span>
                            <span class="password-field">
                                <input asp-for="ConfirmAccountPassword" data-confirm-password type="password" maxlength="50" autocomplete="new-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" title="Show password">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 12s3.5-6 9.6-6 9.6 6 9.6 6-3.5 6-9.6 6-9.6-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                                </button>
                            </span>
                            <small class="password-match-message" data-password-message aria-live="polite"></small>
                        </label>
                    </div>
                    <div class="module-actions">
                        <button type="submit">Update My Login</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</main>

<script>
    function filterSidebarItems() {
        const query = (document.getElementById('sidebar-search-input').value || '').toLowerCase().trim();
        const details = document.querySelectorAll('#sidebar-nav-container details');
        const items = document.querySelectorAll('#sidebar-nav-container .menu-item');
        
        if (!query) {
            details.forEach(d => { d.style.display = ''; d.open = true; });
            items.forEach(i => i.style.display = '');
            return;
        }

        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            if (text.includes(query)) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });

        details.forEach(d => {
            const visibleChild = d.querySelector('.menu-item:not([style*="display: none"])');
            const summaryText = d.querySelector('summary').innerText.toLowerCase();
            if (visibleChild || summaryText.includes(query)) {
                d.style.display = '';
                d.open = true;
            } else {
                d.style.display = 'none';
            }
        });
    }
</script>
