@model TG.Payroll.Web.Models.NavigationItem

@functions {
    string GetCategoryIcon(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("employee") || n.Contains("personnel") || n.Contains("workforce") || n.Contains("staff") || n.Contains("worker"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path d=""M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z""/></svg>";
        }
        else if (n.Contains("attend") || n.Contains("leave") || n.Contains("time") || n.Contains("shift") || n.Contains("punch") || n.Contains("duty"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path fill-rule=""evenodd"" d=""M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"" clip-rule=""evenodd""/></svg>";
        }
        else if (n.Contains("salary") || n.Contains("pay") || n.Contains("wage") || n.Contains("bonus") || n.Contains("advance") || n.Contains("allowance") || n.Contains("fund"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path d=""M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z""/><path fill-rule=""evenodd"" d=""M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"" clip-rule=""evenodd""/></svg>";
        }
        else if (n.Contains("increment") || n.Contains("promotion") || n.Contains("transfer") || n.Contains("upgrade"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path fill-rule=""evenodd"" d=""M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"" clip-rule=""evenodd""/></svg>";
        }
        else if (n.Contains("report") || n.Contains("statement") || n.Contains("summary") || n.Contains("audit") || n.Contains("list") || n.Contains("slip"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path d=""M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z""/><path d=""M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z""/></svg>";
        }
        else if (n.Contains("setup") || n.Contains("master") || n.Contains("config") || n.Contains("company") || n.Contains("setting") || n.Contains("system") || n.Contains("control"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path fill-rule=""evenodd"" d=""M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"" clip-rule=""evenodd""/></svg>";
        }
        else if (n.Contains("user") || n.Contains("security") || n.Contains("privilege") || n.Contains("role") || n.Contains("access") || n.Contains("auth"))
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path fill-rule=""evenodd"" d=""M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z"" clip-rule=""evenodd""/></svg>";
        }
        else
        {
            return @"<svg viewBox=""0 0 20 20"" fill=""currentColor""><path d=""M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z""/></svg>";
        }
    }
}

@if (Model.Children.Count == 0)
{
    @if (Model.Name.Equals("Employee", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Employee Information", StringComparison.OrdinalIgnoreCase))
    {
        <a class="menu-item menu-link-activeable" href="/EmployeeInformation" title="@Model.Name">
            <span class="menu-bullet-dot"></span>
            <span class="menu-text">@Model.Name</span>
            <span class="menu-status-badge available">Live</span>
        </a>
    }
    else if (Model.Name.Equals("Control Entry", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Control_Entry", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Add Features", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Feature Entry", StringComparison.OrdinalIgnoreCase))
    {
        <a class="menu-item menu-link-activeable" href="/UserManagement?activeTab=controls" title="@Model.Name">
            <span class="menu-bullet-dot"></span>
            <span class="menu-text">@Model.Name</span>
            <span class="menu-status-badge available">Live</span>
        </a>
    }
    else if (Model.Name.Equals("Set Company", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Company", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Company Setup", StringComparison.OrdinalIgnoreCase))
    {
        <a class="menu-item menu-link-activeable" href="/UserManagement?activeTab=company" title="@Model.Name">
            <span class="menu-bullet-dot"></span>
            <span class="menu-text">@Model.Name</span>
            <span class="menu-status-badge available">Live</span>
        </a>
    }
    else if (Model.Name.Equals("Tracking Task", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Task Tracking", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("Tracking_Task", StringComparison.OrdinalIgnoreCase))
    {
        <a class="menu-item menu-link-activeable" href="/UserManagement?activeTab=tracking" title="@Model.Name">
            <span class="menu-bullet-dot"></span>
            <span class="menu-text">@Model.Name</span>
            <span class="menu-status-badge available">Live</span>
        </a>
    }
    else if (Model.Name.Equals("User Management", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("User Control", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("User Privilege", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("User Privilage", StringComparison.OrdinalIgnoreCase) || Model.Name.Equals("User Privilages", StringComparison.OrdinalIgnoreCase))
    {
        <a class="menu-item menu-link-activeable" href="/UserManagement?activeTab=users" title="@Model.Name">
            <span class="menu-bullet-dot"></span>
            <span class="menu-text">@Model.Name</span>
            <span class="menu-status-badge available">Live</span>
        </a>
    }
    else
    {
        <span class="menu-item unavailable" title="@Model.Name (Module under development)">
            <span class="menu-bullet-dot mute"></span>
            <span class="menu-text">@Model.Name</span>
            <span class="menu-status-badge locked">Soon</span>
        </span>
    }
}
else
{
    <details class="menu-group" open>
        <summary class="menu-group-summary">
            <span class="menu-icon-wrap">
                @Html.Raw(GetCategoryIcon(Model.Name))
            </span>
            <span class="menu-text" title="@Model.Name">@Model.Name</span>
            <span class="menu-count-badge">@Model.Children.Count</span>
            <svg class="menu-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
        </summary>
        <div class="menu-children-container">
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("_MenuItem", child)
            }
        </div>
    </details>
}
