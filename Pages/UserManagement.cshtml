@page
@model UserManagementModel
@{
    ViewData["Title"] = "User & System Management";
    var selectedModuleIds = Model.SelectedModuleIds.ToHashSet();
    var newUserModuleIds = Model.NewUserModuleIds.ToHashSet();
}

@{
    bool HasModuleRecursive(IEnumerable<NavigationItem> items, Func<NavigationItem, bool> predicate)
    {
        foreach (var item in items)
        {
            if (predicate(item)) return true;
            if (item.Children.Count > 0 && HasModuleRecursive(item.Children, predicate)) return true;
        }
        return false;
    }

    bool hasDashboard = Model.CurrentUserIsAdmin || HasModuleRecursive(Model.Menu, item => item.Id == 184 || item.Name.Equals("Dashboard", StringComparison.OrdinalIgnoreCase));
    bool hasUserManagement = Model.CurrentUserIsAdmin || HasModuleRecursive(Model.Menu, item => item.Name.Contains("USER MANAGEMENT", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("User Privilege", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Control Entry", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("User Management", StringComparison.OrdinalIgnoreCase));
}

<main class="dashboard-page">
    <header class="topbar">
        <a class="brand-link" href="/Dashboard">
            <div class="brand-badge">
                <span class="brand-mark small">TG</span>
            </div>
            <div class="brand-text-group">
                <span class="topbar-title">TG Payroll</span>
                <span class="topbar-tag">Enterprise HRIS</span>
            </div>
        </a>

        <div class="topbar-right">
            <div class="topbar-company-badge" title="Active Organization">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9zM7 13h2v2H7v-2zm4 0h2v2h-2v-2z" clip-rule="evenodd"/></svg>
                <span>@Model.CompanyName</span>
            </div>

            <a class="topbar-user-pill topbar-user-link" href="/Account" title="My Profile & Login Settings">
                <div class="topbar-avatar">
                    <span>@(string.IsNullOrWhiteSpace(Model.CurrentUserName) ? "U" : Model.CurrentUserName[0].ToString().ToUpperInvariant())</span>
                    <span class="topbar-avatar-status"></span>
                </div>
                <div class="topbar-user-details">
                    <strong class="topbar-user-name">@Model.CurrentUserName</strong>
                    <small class="topbar-user-role">@(Model.CurrentUserIsAdmin ? "Administrator" : "Active Account")</small>
                </div>
            </a>

            <form method="post" action="/logout" style="margin:0;">
                <button type="submit" class="topbar-btn topbar-btn-signout" title="Sign out of your session">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M19 10a.75.75 0 00-.75-.75H8.704l2.47-2.47a.75.75 0 10-1.06-1.06l-3.75 3.75a.75.75 0 000 1.06l3.75 3.75a.75.75 0 101.06-1.06l-2.47-2.47h9.546A.75.75 0 0019 10z" clip-rule="evenodd"/></svg>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </header>

    <div class="application-shell">
        <aside class="sidebar">
            <div class="sidebar-header">
                <span class="sidebar-section-title">Navigation</span>
            </div>

            <div class="sidebar-search-box">
                <svg viewBox="0 0 20 20" fill="currentColor" class="sidebar-search-icon">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
                <input type="text"
                       class="sidebar-search-input"
                       id="sidebar-search-input"
                       placeholder="Search modules..."
                       oninput="filterSidebarItems()" />
            </div>

            @if (hasDashboard || hasUserManagement)
            {
                <div class="sidebar-quick-nav">
                    @if (hasDashboard)
                    {
                        <a class="dashboard-link" href="/Dashboard">
                            <span class="menu-icon-wrap dashboard-icon-wrap">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                                </svg>
                            </span>
                            <span class="menu-text">Dashboard</span>
                            <span class="menu-pill-indicator"></span>
                        </a>
                    }
                    @if (hasUserManagement)
                    {
                        <a class="dashboard-link active" href="/UserManagement">
                            <span class="menu-icon-wrap user-nav-icon-wrap">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
                                </svg>
                            </span>
                            <span class="menu-text">User Management</span>
                            <span class="menu-pill-indicator"></span>
                        </a>
                    }
                </div>
            }

            <div class="sidebar-divider">
                <span>Payroll Modules</span>
            </div>

            <nav class="sidebar-nav" id="sidebar-nav-container" aria-label="Payroll modules">
                @foreach (var item in Model.Menu.Where(m => m.Id != 184 && !m.Name.Contains("USER MANAGEMENT", StringComparison.OrdinalIgnoreCase)))
                {
                    @await Html.PartialAsync("_MenuItem", item)
                }
            </nav>

            <div class="sidebar-footer-card">
                <div class="sidebar-footer-header">
                    <div class="sidebar-footer-dot"></div>
                    <span class="sidebar-footer-label">System Online</span>
                </div>
                <div class="sidebar-footer-meta">
                    <strong title="@Model.CompanyName">@Model.CompanyName</strong>
                    <small>TG Payroll Enterprise</small>
                </div>
            </div>
        </aside>

        <div class="dashboard-content">
            <section class="management-heading">
                <div>
                    <p class="eyebrow">ADMINISTRATION & SECURITY</p>
                    <h1>User & System Management</h1>
                    <p>Manage system user privileges, controls, company settings, and task activity tracking.</p>
                </div>
            </section>

            <!-- Navigation Tabs -->
            <div class="management-tabs-container">
                <div class="management-tabs">
                    @if (Model.CurrentUserIsAdmin)
                    {
                        <a class="tab-btn @(Model.ActiveTab == "users" ? "active" : "")" href="/UserManagement?activeTab=users">
                            <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                            <span>User Privileges</span>
                        </a>
                        <a class="tab-btn @(Model.ActiveTab == "controls" ? "active" : "")" href="/UserManagement?activeTab=controls">
                            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                            <span>Control Entry</span>
                            <span class="tab-badge">@Model.AllControls.Count</span>
                        </a>
                        <a class="tab-btn @(Model.ActiveTab == "company" ? "active" : "")" href="/UserManagement?activeTab=company">
                            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9zM7 13h2v2H7v-2zm4 0h2v2h-2v-2z" clip-rule="evenodd"/></svg>
                            <span>Set Company</span>
                            <span class="tab-badge">@Model.Companies.Count</span>
                        </a>
                        <a class="tab-btn @(Model.ActiveTab == "tracking" ? "active" : "")" href="/UserManagement?activeTab=tracking">
                            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                            <span>Tracking Task</span>
                        </a>
                    }
                </div>
            </div>

            @if (Model.Saved)
            {
                <div class="success-message">Module permissions saved successfully.</div>
            }
            @if (Model.Created)
            {
                <div class="success-message">User created successfully. The new user can now sign in.</div>
            }
            @if (Model.CredentialsUpdated)
            {
                <div class="success-message">Your username and password were updated successfully.</div>
            }
            @if (Model.ControlCreated)
            {
                <div class="success-message">New control / menu item created successfully in CONTROLS table.</div>
            }
            @if (Model.ControlUpdated)
            {
                <div class="success-message">Control / menu item updated successfully.</div>
            }
            @if (Model.ControlDeleted)
            {
                <div class="success-message">Control / menu item deleted successfully.</div>
            }
            @if (Model.CompanyCreated)
            {
                <div class="success-message">Company registered successfully in COMPANY table.</div>
            }
            @if (Model.CompanyUpdated)
            {
                <div class="success-message">Company information updated successfully.</div>
            }
            @if (Model.CompanyDeleted)
            {
                <div class="success-message">Company deleted successfully.</div>
            }
            @if (Model.CreateError is not null)
            {
                <div class="database-error management-message">@Model.CreateError</div>
            }
            @if (Model.CredentialError is not null)
            {
                <div class="database-error management-message">@Model.CredentialError</div>
            }
            @if (Model.ControlError is not null)
            {
                <div class="database-error management-message">@Model.ControlError</div>
            }
            @if (Model.CompanyError is not null)
            {
                <div class="database-error management-message">@Model.CompanyError</div>
            }

            <!-- TAB 1: CONTROL ENTRY & MENU MASTER -->
            @if (Model.ActiveTab == "controls" && Model.CurrentUserIsAdmin)
            {
                <div class="control-entry-shell">
                    <!-- Top: Control Form Card -->
                    <section class="control-form-panel">
                        <div class="create-user-title">
                            <h2 id="control-form-title">Add New Control</h2>
                            <p>Register a new system menu, module, or screen control into the database.</p>
                        </div>
                        <form method="post" id="control-entry-form" asp-page-handler="CreateControl">
            <input type="hidden" asp-for="EditControlId" id="edit-control-id" value="0" />
                            
                            <div class="control-form-fields">
                                <label>
                                    <span>Control / Menu Name <span style="color:#e11d48;">*</span></span>
                                    <input asp-for="ControlNameInput" id="control-name-input" placeholder="e.g. Daily Attendance Report" required maxlength="120" oninput="updateControlLocationPreview()" />
                                </label>

                                <label>
                                    <span>Parent / Calling Menu (Destination)</span>
                                    <select asp-for="CallingIdInput" id="calling-id-input" onchange="updateControlLocationPreview()">
                                        <option value="" data-name="Root Category (New Main Menu)">🌟 [Create as New Main / Root Category on Sidebar]</option>
                                        <optgroup label="📂 Existing Category Folders (Place as Sub-Menu inside)">
                                            @foreach (var parent in Model.ModuleTree.OrderBy(m => m.Name))
                                            {
                                                <option value="@parent.Id" data-name="@parent.Name">
                                                    📂 @parent.Name (ID: @parent.Id) — contains @(parent.Children.Count) sub-menus
                                                </option>
                                            }
                                        </optgroup>
                                    </select>
                                    <small class="field-hint">Choose where this menu item will be located.</small>
                                </label>

                                <label>
                                    <span>Control Type</span>
                                    <select asp-for="ControlTypeInput" id="control-type-input">
                                        @foreach (var ctype in Model.ControlTypes)
                                        {
                                            <option value="@ctype">@ctype</option>
                                        }
                                    </select>
                                </label>

                                <label>
                                    <span>Priority Sequence</span>
                                    <input asp-for="PriorityInput" id="priority-input" type="number" min="0" max="9999" value="1" required />
                                </label>
                            </div>

                            <div class="control-location-preview" id="control-location-preview">
                                <span class="preview-label">📍 Live Placement Preview:</span>
                                <div class="preview-breadcrumb">
                                    <span class="crumb-item crumb-sidebar">📌 Sidebar</span>
                                    <span class="crumb-sep">➔</span>
                                    <span class="crumb-item crumb-child" id="preview-parent-crumb">📁 New Item (Main Sidebar Category)</span>
                                    <span class="crumb-sep" id="preview-sep-crumb" style="display:none;">➔</span>
                                    <span class="crumb-item crumb-child" id="preview-child-crumb" style="display:none;">↳ New Item</span>
                                </div>
                            </div>

                            <div class="control-form-actions">
                                <button type="button" id="btn-reset-control" class="btn-secondary-action" onclick="resetControlForm()">
                                    <span>Reset Form</span>
                                </button>
                                <button type="submit" id="btn-save-control" class="btn-primary-action">
                                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/></svg>
                                    <span>Save New Control</span>
                                </button>
                            </div>
                        </form>
                    </section>

                    <!-- Bottom: Controls Data Grid & Table -->
                    <section class="control-list-panel">
                        <div class="control-list-header">
                            <div>
                                <h2>Registered System Controls</h2>
                                <p>Total @Model.AllControls.Count controls in database `CONTROLS` table.</p>
                            </div>
                            <div class="control-toolbar-actions">
                                <div class="control-sort-wrap">
                                    <label for="controls-sort-select">Sort by:</label>
                                    <select id="controls-sort-select" onchange="onSortSelectChange(this.value)">
                                        <option value="priority-asc">Priority (Low → High)</option>
                                        <option value="priority-desc">Priority (High → Low)</option>
                                        <option value="id-asc">Control ID (1 → N)</option>
                                        <option value="id-desc">Control ID (N → 1)</option>
                                        <option value="name-asc">Control Name (A → Z)</option>
                                        <option value="name-desc">Control Name (Z → A)</option>
                                        <option value="parent-asc">Parent Menu (A → Z)</option>
                                        <option value="type-asc">Type (A → Z)</option>
                                    </select>
                                </div>
                                <div class="control-search-wrap">
                                    <input type="text" id="controls-filter-input" placeholder="Search controls..." oninput="filterControlsTable()" />
                                </div>
                            </div>
                        </div>

                        <div class="controls-table-container">
                            <table class="controls-data-table" id="controls-table">
                                <thead>
                                    <tr>
                                        <th class="sortable-th" style="width: 60px;" onclick="sortTableByColumn('id')" title="Click to sort by ID">
                                            <div class="th-content"><span>ID</span><span class="sort-icon" id="sort-icon-id">↕</span></div>
                                        </th>
                                        <th class="sortable-th" onclick="sortTableByColumn('name')" title="Click to sort by Control Name">
                                            <div class="th-content"><span>Control Name</span><span class="sort-icon" id="sort-icon-name">↕</span></div>
                                        </th>
                                        <th class="sortable-th" onclick="sortTableByColumn('parent')" title="Click to sort by Parent Menu">
                                            <div class="th-content"><span>Parent Menu</span><span class="sort-icon" id="sort-icon-parent">↕</span></div>
                                        </th>
                                        <th class="sortable-th" style="width: 80px;" onclick="sortTableByColumn('type')" title="Click to sort by Type">
                                            <div class="th-content"><span>Type</span><span class="sort-icon" id="sort-icon-type">↕</span></div>
                                        </th>
                                        <th class="sortable-th active-sort" style="width: 75px;" onclick="sortTableByColumn('priority')" title="Click to sort by Priority">
                                            <div class="th-content"><span>Priority</span><span class="sort-icon" id="sort-icon-priority">▲</span></div>
                                        </th>
                                        <th style="width: 110px; text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ctrl in Model.AllControls)
                                    {
                                        <tr data-id="@ctrl.ControlId" data-name="@ctrl.ControlName" data-parent="@(ctrl.CallingId?.ToString() ?? "")" data-parent-name="@ctrl.ParentName" data-type="@ctrl.ControlType" data-priority="@ctrl.Priority">
                                            <td><span class="id-badge">#@ctrl.ControlId</span></td>
                                            <td>
                                                <strong class="ctrl-name-text">@ctrl.ControlName</strong>
                                            </td>
                                            <td>
                                                @if (ctrl.CallingId is null or 0)
                                                {
                                                    <span class="badge-root">Root Category</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-sub">↳ @ctrl.ParentName</span>
                                                }
                                            </td>
                                            <td><span class="type-pill">@ctrl.ControlType</span></td>
                                            <td><span class="priority-text">@ctrl.Priority</span></td>
                                            <td style="text-align: center;">
                                                <div class="table-action-group">
                                                    <button type="button" class="action-btn btn-edit-ctrl" onclick="editControl(@ctrl.ControlId, '@Html.Raw(JavaScriptEncoder.Default.Encode(ctrl.ControlName))', '@(ctrl.CallingId?.ToString() ?? "")', '@ctrl.ControlType', @ctrl.Priority)" title="Edit this control">
                                                        Edit
                                                    </button>
                                                    <form method="post" asp-page-handler="DeleteControl" asp-route-controlId="@ctrl.ControlId" style="margin:0;display:inline;" onsubmit="return confirm('Are you sure you want to delete control: @Html.Raw(JavaScriptEncoder.Default.Encode(ctrl.ControlName)) (ID: @ctrl.ControlId)?');">
                                                        <button type="submit" class="action-btn btn-delete-ctrl" title="Delete control">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            }

            <!-- TAB 2: SET COMPANY MANAGEMENT -->
            @if (Model.ActiveTab == "company" && Model.CurrentUserIsAdmin)
            {
                <div class="control-entry-shell">
                    <!-- Top: Company Form Card -->
                    <section class="control-form-panel">
                        <div class="create-user-title">
                            <h2 id="company-form-title">Register Company</h2>
                            <p>Configure company entities, addresses, short names, and logo settings.</p>
                        </div>
                        <form method="post" id="company-entry-form" asp-page-handler="CreateCompany">
                            <input type="hidden" asp-for="EditCompanyId" id="edit-company-id" value="0" />
                            
                            <div class="control-form-fields">
                                <label>
                                    <span>Company Name <span style="color:#e11d48;">*</span></span>
                                    <input asp-for="CompanyNameInput" id="company-name-input" placeholder="e.g. NTTML Mirjapur Mills Ltd" required maxlength="150" />
                                </label>

                                <label>
                                    <span>Short Name / Remarks</span>
                                    <input asp-for="CompanyRemarksInput" id="company-remarks-input" placeholder="e.g. NTTML" maxlength="50" />
                                </label>

                                <label>
                                    <span>Company Address</span>
                                    <input asp-for="CompanyAddressInput" id="company-address-input" placeholder="e.g. Mirjapur, Tangail" maxlength="200" />
                                </label>

                                <label>
                                    <span>Logo File / Path</span>
                                    <input asp-for="CompanyLogoPathInput" id="company-logo-input" placeholder="e.g. /images/logo.png" maxlength="250" />
                                </label>
                            </div>

                            <div class="control-form-actions">
                                <button type="button" id="btn-reset-company" class="btn-secondary-action" onclick="resetCompanyForm()">
                                    <span>Reset Form</span>
                                </button>
                                <button type="submit" id="btn-save-company" class="btn-primary-action">
                                    <svg viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/></svg>
                                    <span>Save Company</span>
                                </button>
                            </div>
                        </form>
                    </section>

                    <!-- Bottom: Registered Companies Table -->
                    <section class="control-list-panel">
                        <div class="control-list-header">
                            <div>
                                <h2>Registered Companies</h2>
                                <p>Total @Model.Companies.Count company entities in database `COMPANY` table.</p>
                            </div>
                        </div>

                        <div class="controls-table-container">
                            <table class="controls-data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 70px;">ID</th>
                                        <th>Company Name</th>
                                        <th>Short Name</th>
                                        <th>Address</th>
                                        <th style="width: 110px; text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var comp in Model.Companies)
                                    {
                                        <tr>
                                            <td><span class="id-badge">#@comp.CompanyId</span></td>
                                            <td><strong class="ctrl-name-text">@comp.CompanyName</strong></td>
                                            <td><span class="type-pill">@(string.IsNullOrWhiteSpace(comp.Remarks) ? "-" : comp.Remarks)</span></td>
                                            <td><span style="color:#64748b;font-size:12.5px;">@(string.IsNullOrWhiteSpace(comp.Address) ? "-" : comp.Address)</span></td>
                                            <td style="text-align: center;">
                                                <div class="table-action-group">
                                                    <button type="button" class="action-btn btn-edit-ctrl" onclick="editCompany(@comp.CompanyId, '@Html.Raw(JavaScriptEncoder.Default.Encode(comp.CompanyName))', '@Html.Raw(JavaScriptEncoder.Default.Encode(comp.Address))', '@Html.Raw(JavaScriptEncoder.Default.Encode(comp.Remarks))', '@Html.Raw(JavaScriptEncoder.Default.Encode(comp.CompanyLogoPath))')" title="Edit company">
                                                        Edit
                                                    </button>
                                                    <form method="post" asp-page-handler="DeleteCompany" asp-route-companyId="@comp.CompanyId" style="margin:0;display:inline;" onsubmit="return confirm('Are you sure you want to delete company: @Html.Raw(JavaScriptEncoder.Default.Encode(comp.CompanyName))?');">
                                                        <button type="submit" class="action-btn btn-delete-ctrl" title="Delete company">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            }

            <!-- TAB 3: TRACKING TASK & AUDIT -->
            @if (Model.ActiveTab == "tracking" && Model.CurrentUserIsAdmin)
            {
                <div class="control-entry-shell">
                    <section class="control-form-panel">
                        <div class="create-user-title">
                            <h2>Task & User Activity Tracking</h2>
                            <p>Real-time audit log, active user sessions, and database operation status.</p>
                        </div>
                        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;margin-top:14px;">
                            <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                                <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">ACTIVE OPERATOR</span>
                                <strong style="font-size:18px;color:#0f172a;margin-top:4px;display:block;">@Model.CurrentUserName</strong>
                                <small style="color:#16a34a;font-weight:700;">● Online Session</small>
                            </div>
                            <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                                <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">ORGANIZATION</span>
                                <strong style="font-size:18px;color:#0f172a;margin-top:4px;display:block;">@Model.CompanyName</strong>
                                <small style="color:#64748b;">Active Company ID: 1</small>
                            </div>
                            <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                                <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">TOTAL SYSTEM USERS</span>
                                <strong style="font-size:18px;color:#2563eb;margin-top:4px;display:block;">@Model.Users.Count Accounts</strong>
                                <small style="color:#64748b;">@Model.Users.Count(u => u.Admin == 1) Admins</small>
                            </div>
                            <div style="background:#f8fafc;padding:16px;border-radius:10px;border:1px solid #e2e8f0;">
                                <span style="font-size:12px;color:#64748b;font-weight:700;display:block;">REGISTERED CONTROLS</span>
                                <strong style="font-size:18px;color:#059669;margin-top:4px;display:block;">@Model.AllControls.Count Modules</strong>
                                <small style="color:#64748b;">CONTROLS table live</small>
                            </div>
                        </div>
                    </section>

                    <section class="control-list-panel">
                        <div class="control-list-header">
                            <div>
                                <h2>Recent System Activity & User Accounts</h2>
                                <p>Live tracking of registered payroll operator profiles.</p>
                            </div>
                        </div>

                        <div class="controls-table-container">
                            <table class="controls-data-table">
                                <thead>
                                    <tr>
                                        <th style="width:70px;">User ID</th>
                                        <th>Username</th>
                                        <th>Role / Privilege</th>
                                        <th>Company Affiliation</th>
                                        <th>Assigned Modules</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.Users)
                                    {
                                        var count = (user.PrivilegeArray ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                                        <tr>
                                            <td><span class="id-badge">#@user.UserId</span></td>
                                            <td><strong class="ctrl-name-text">@user.UserName</strong></td>
                                            <td>
                                                @if (user.Admin == 1)
                                                {
                                                    <span class="admin-badge">Administrator (Full Access)</span>
                                                }
                                                else
                                                {
                                                    <span class="type-pill">Standard User</span>
                                                }
                                            </td>
                                            <td><span>@(string.IsNullOrWhiteSpace(user.CompanyId) ? "Default" : "Company #" + user.CompanyId)</span></td>
                                            <td>
                                                <span class="type-pill" style="background:#eff6ff;color:#1d4ed8;">@(user.Admin == 1 ? "All (" + Model.Modules.Count + ")" : count + " Modules")</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            }

            <!-- TAB 4: USER ROLES & ACCESS -->
            @if (Model.ActiveTab == "users")
            {
                @if (Model.CurrentUserIsAdmin)
                {
                    <section class="create-user-panel user-create-panel">
                        <div class="create-user-title"><div><h2>Add New User Account</h2><p>Create a login and assign its role and module privileges.</p></div></div>
                        <form method="post" asp-page-handler="Create" id="create-user-form">
                            <div class="user-fields">
                                <label><span>Username</span><input asp-for="NewUsername" maxlength="80" autocomplete="off" required /></label>
                                <label><span>Password</span><span class="password-field"><input asp-for="NewPassword" type="password" maxlength="50" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle aria-label="Show password" title="Show password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 12s3.5-6 9.6-6 9.6 6 9.6 6-3.5 6-9.6 6-9.6-6-9.6-6Z"/><circle cx="12" cy="12" r="2.7"/></svg></button></span></label>
                                <label><span>Role</span><select asp-for="NewRole" id="new-user-role"><option value="User">Standard user</option><option value="Admin">Administrator</option></select></label>
                            </div>
                            <div class="create-module-heading">
                                <h3>Module Privileges (Hierarchical Categories)</h3>
                                <span>Selecting a Root Category automatically checks its sub-menus. Admin role receives all modules.</span>
                            </div>
                            <div class="privilege-tree-container">
                                @foreach (var root in Model.ModuleTree)
                                {
                                    <div class="privilege-group-card">
                                        <div class="privilege-group-header">
                                            <label class="privilege-root-label">
                                                <input type="checkbox"
                                                       class="new-user-module new-user-root"
                                                       name="NewUserModuleIds"
                                                       value="@root.Id"
                                                       checked="@newUserModuleIds.Contains(root.Id)"
                                                       data-group="new-grp-@root.Id"
                                                       onchange="toggleGroupChildren('new-grp-@root.Id', this.checked)" />
                                                <span>📁 @root.Name <small style="color:#64748b;font-weight:normal;">(ID: @root.Id)</small></span>
                                            </label>
                                            <div class="privilege-group-meta">
                                                <span class="privilege-count-badge">@(root.Children.Count > 0 ? root.Children.Count + " sub-menus" : "Root module")</span>
                                                @if (root.Children.Count > 0)
                                                {
                                                    <button type="button" class="privilege-toggle-btn" onclick="toggleGroupAll('new-grp-@root.Id')">Toggle All</button>
                                                }
                                            </div>
                                        </div>
                                        @if (root.Children.Count > 0)
                                        {
                                            <div class="privilege-group-body">
                                                <div class="privilege-children-grid">
                                                    @foreach (var child in root.Children)
                                                    {
                                                        <label class="privilege-child-option">
                                                            <input type="checkbox"
                                                                   class="new-user-module child-of-new-grp-@root.Id"
                                                                   name="NewUserModuleIds"
                                                                   value="@child.Id"
                                                                   checked="@newUserModuleIds.Contains(child.Id)"
                                                                   onchange="onChildPrivilegeChange('new-grp-@root.Id')" />
                                                            <div class="privilege-child-info">
                                                                <strong>↳ @child.Name</strong>
                                                                <small>Module ID: @child.Id</small>
                                                            </div>
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="module-actions"><button type="submit">Create User</button></div>
                        </form>
                    </section>
                }

                <div class="management-shell">
                    <aside class="user-list-panel">
                        <h2>User Accounts</h2>
                        @foreach (var user in Model.Users)
                        {
                            <a class="user-row @(user.UserId == Model.SelectedUserId ? "selected" : "")" asp-page="/UserManagement" asp-route-userId="@user.UserId" asp-route-activeTab="users">
                                <span class="user-avatar">@((user.UserName ?? "U")[0].ToString().ToUpper())</span>
                                <span><strong>@user.UserName</strong><small>@(user.Admin == 1 ? "Administrator" : "Standard user")</small></span>
                            </a>
                        }
                    </aside>

                    <section class="module-panel">
                        @if (Model.SelectedUser is null)
                        {
                            <p>No user found.</p>
                        }
                        else
                        {
                            <div class="module-panel-title">
                                <div><h2>Module Access Permissions</h2><p>@Model.SelectedUser.UserName · @(Model.SelectedUserIsAdmin ? "Administrator" : "Standard user")</p></div>
                                @if (Model.SelectedUserIsAdmin)
                                {
                                    <span class="admin-badge">All modules enabled</span>
                                }
                                else if (!Model.CurrentUserIsAdmin)
                                {
                                    <span class="readonly-badge">Read only</span>
                                }
                            </div>
                            <form method="post" asp-page-handler="SavePrivileges">
                                <input type="hidden" asp-for="SelectedUserId" />
                                <div class="privilege-tree-container">
                                    @foreach (var root in Model.ModuleTree)
                                    {
                                        <div class="privilege-group-card">
                                            <div class="privilege-group-header">
                                                <label class="privilege-root-label">
                                                    <input type="checkbox"
                                                           name="SelectedModuleIds"
                                                           value="@root.Id"
                                                           checked="@selectedModuleIds.Contains(root.Id)"
                                                           disabled="@(Model.SelectedUserIsAdmin || !Model.CurrentUserIsAdmin)"
                                                           data-group="edit-grp-@root.Id"
                                                           onchange="toggleGroupChildren('edit-grp-@root.Id', this.checked)" />
                                                    <span>📁 @root.Name <small style="color:#64748b;font-weight:normal;">(ID: @root.Id)</small></span>
                                                </label>
                                                <div class="privilege-group-meta">
                                                    <span class="privilege-count-badge">@(root.Children.Count > 0 ? root.Children.Count + " sub-menus" : "Root module")</span>
                                                    @if (root.Children.Count > 0 && !Model.SelectedUserIsAdmin && Model.CurrentUserIsAdmin)
                                                    {
                                                        <button type="button" class="privilege-toggle-btn" onclick="toggleGroupAll('edit-grp-@root.Id')">Toggle All</button>
                                                    }
                                                </div>
                                            </div>
                                            @if (root.Children.Count > 0)
                                            {
                                                <div class="privilege-group-body">
                                                    <div class="privilege-children-grid">
                                                        @foreach (var child in root.Children)
                                                        {
                                                            <label class="privilege-child-option">
                                                                <input type="checkbox"
                                                                       class="child-of-edit-grp-@root.Id"
                                                                       name="SelectedModuleIds"
                                                                       value="@child.Id"
                                                                       checked="@selectedModuleIds.Contains(child.Id)"
                                                                       disabled="@(Model.SelectedUserIsAdmin || !Model.CurrentUserIsAdmin)"
                                                                       onchange="onChildPrivilegeChange('edit-grp-@root.Id')" />
                                                                <div class="privilege-child-info">
                                                                    <strong>↳ @child.Name</strong>
                                                                    <small>Module ID: @child.Id</small>
                                                                </div>
                                                            </label>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (Model.CurrentUserIsAdmin)
                                {
                                    <div class="module-actions" style="margin-top: 18px;"><button type="submit">Save Module Access</button></div>
                                }
                            </form>
                        }
                    </section>
                </div>
            }
        </div>
    </div>
</main>

<script>
    (() => {
        const role = document.getElementById('new-user-role');
        const modules = [...document.querySelectorAll('.new-user-module')];
        if (!role) return;
        const syncRole = () => {
            const admin = role.value === 'Admin';
            modules.forEach(module => {
                if (admin) module.checked = true;
                module.disabled = admin;
            });
        };
        role.addEventListener('change', syncRole);
        syncRole();
    })();

    function updateControlLocationPreview() {
        const select = document.getElementById('calling-id-input');
        const nameInput = document.getElementById('control-name-input');
        const parentCrumb = document.getElementById('preview-parent-crumb');
        const sepCrumb = document.getElementById('preview-sep-crumb');
        const childCrumb = document.getElementById('preview-child-crumb');
        if (!select || !parentCrumb || !sepCrumb || !childCrumb) return;
        
        const menuName = (nameInput?.value || '').trim() || 'New Item';
        const selectedOpt = select.options[select.selectedIndex];
        const parentId = select.value;
        const parentName = selectedOpt?.getAttribute('data-name') || selectedOpt?.text || '';

        if (!parentId) {
            parentCrumb.className = 'crumb-item crumb-child';
            parentCrumb.innerText = '📁 ' + menuName + ' (Main Sidebar Category)';
            sepCrumb.style.display = 'none';
            childCrumb.style.display = 'none';
        } else {
            parentCrumb.className = 'crumb-item crumb-parent';
            parentCrumb.innerText = '📂 ' + parentName;
            sepCrumb.style.display = 'inline';
            childCrumb.style.display = 'inline-flex';
            childCrumb.innerText = '↳ 📄 ' + menuName;
        }
    }

    function editControl(id, name, parentId, type, priority) {
        document.getElementById('control-form-title').innerText = 'Edit Control (ID: ' + id + ')';
        document.getElementById('edit-control-id').value = id;
        document.getElementById('control-name-input').value = name;
        document.getElementById('calling-id-input').value = parentId || '';
        document.getElementById('control-type-input').value = type || 'MENU';
        document.getElementById('priority-input').value = priority || 1;
        
        const form = document.getElementById('control-entry-form');
        form.setAttribute('action', '/UserManagement?handler=UpdateControl');
        
        const btn = document.getElementById('btn-save-control');
        btn.querySelector('span').innerText = 'Update Control (ID: ' + id + ')';
        btn.classList.add('btn-update-mode');

        updateControlLocationPreview();
        window.scrollTo({ top: document.querySelector('.control-form-panel').offsetTop - 80, behavior: 'smooth' });
    }

    function resetControlForm() {
        document.getElementById('control-form-title').innerText = 'Add New Control';
        document.getElementById('edit-control-id').value = 0;
        document.getElementById('control-name-input').value = '';
        document.getElementById('calling-id-input').value = '';
        document.getElementById('control-type-input').value = 'MENU';
        document.getElementById('priority-input').value = 1;
        
        const form = document.getElementById('control-entry-form');
        form.setAttribute('action', '/UserManagement?handler=CreateControl');
        
        const btn = document.getElementById('btn-save-control');
        btn.querySelector('span').innerText = 'Save New Control';
        btn.classList.remove('btn-update-mode');

        updateControlLocationPreview();
    }

    function editCompany(id, name, address, remarks, logoPath) {
        document.getElementById('company-form-title').innerText = 'Edit Company (ID: ' + id + ')';
        document.getElementById('edit-company-id').value = id;
        document.getElementById('company-name-input').value = name;
        document.getElementById('company-address-input').value = address;
        document.getElementById('company-remarks-input').value = remarks;
        document.getElementById('company-logo-input').value = logoPath;

        const form = document.getElementById('company-entry-form');
        form.setAttribute('action', '/UserManagement?handler=UpdateCompany');

        const btn = document.getElementById('btn-save-company');
        btn.querySelector('span').innerText = 'Update Company (ID: ' + id + ')';
        btn.classList.add('btn-update-mode');

        window.scrollTo({ top: document.querySelector('.control-form-panel').offsetTop - 80, behavior: 'smooth' });
    }

    function resetCompanyForm() {
        document.getElementById('company-form-title').innerText = 'Register Company';
        document.getElementById('edit-company-id').value = 0;
        document.getElementById('company-name-input').value = '';
        document.getElementById('company-address-input').value = '';
        document.getElementById('company-remarks-input').value = '';
        document.getElementById('company-logo-input').value = '';

        const form = document.getElementById('company-entry-form');
        form.setAttribute('action', '/UserManagement?handler=CreateCompany');

        const btn = document.getElementById('btn-save-company');
        btn.querySelector('span').innerText = 'Save Company';
        btn.classList.remove('btn-update-mode');
    }

    let currentSortColumn = 'priority';
    let currentSortOrder = 'asc';

    function sortTableByColumn(column) {
        if (currentSortColumn === column) {
            currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
        } else {
            currentSortColumn = column;
            currentSortOrder = 'asc';
        }
        applySortAndFilter();
    }

    function onSortSelectChange(value) {
        const parts = value.split('-');
        currentSortColumn = parts[0];
        currentSortOrder = parts[1];
        applySortAndFilter();
    }

    function applySortAndFilter() {
        ['id', 'name', 'parent', 'type', 'priority'].forEach(col => {
            const icon = document.getElementById('sort-icon-' + col);
            const th = icon?.closest('th');
            if (col === currentSortColumn) {
                if (th) th.classList.add('active-sort');
                if (icon) icon.innerText = currentSortOrder === 'asc' ? '▲' : '▼';
            } else {
                if (th) th.classList.remove('active-sort');
                if (icon) icon.innerText = '↕';
            }
        });

        const select = document.getElementById('controls-sort-select');
        if (select) {
            select.value = currentSortColumn + '-' + currentSortOrder;
        }

        const tbody = document.querySelector('#controls-table tbody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));

        rows.sort((a, b) => {
            let valA, valB;
            if (currentSortColumn === 'id') {
                valA = parseInt(a.getAttribute('data-id') || '0', 10);
                valB = parseInt(b.getAttribute('data-id') || '0', 10);
                return currentSortOrder === 'asc' ? valA - valB : valB - valA;
            } else if (currentSortColumn === 'priority') {
                valA = parseInt(a.getAttribute('data-priority') || '0', 10);
                valB = parseInt(b.getAttribute('data-priority') || '0', 10);
                if (valA === valB) {
                    const idA = parseInt(a.getAttribute('data-id') || '0', 10);
                    const idB = parseInt(b.getAttribute('data-id') || '0', 10);
                    return idA - idB;
                }
                return currentSortOrder === 'asc' ? valA - valB : valB - valA;
            } else if (currentSortColumn === 'name') {
                valA = (a.getAttribute('data-name') || '').toLowerCase();
                valB = (b.getAttribute('data-name') || '').toLowerCase();
                return currentSortOrder === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
            } else if (currentSortColumn === 'parent') {
                valA = (a.getAttribute('data-parent-name') || '').toLowerCase();
                valB = (b.getAttribute('data-parent-name') || '').toLowerCase();
                return currentSortOrder === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
            } else if (currentSortColumn === 'type') {
                valA = (a.getAttribute('data-type') || '').toLowerCase();
                valB = (b.getAttribute('data-type') || '').toLowerCase();
                return currentSortOrder === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
            }
            return 0;
        });

        rows.forEach(r => tbody.appendChild(r));
        filterControlsTable();
    }

    function filterControlsTable() {
        const query = (document.getElementById('controls-filter-input').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#controls-table tbody tr');
        rows.forEach(r => {
            const name = (r.getAttribute('data-name') || '').toLowerCase();
            const id = (r.getAttribute('data-id') || '').toLowerCase();
            const parent = (r.innerText || '').toLowerCase();
            if (!query || name.includes(query) || id.includes(query) || parent.includes(query)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function filterSidebarItems() {
        const query = (document.getElementById('sidebar-search-input').value || '').toLowerCase().trim();
        const details = document.querySelectorAll('#sidebar-nav-container details');
        const items = document.querySelectorAll('#sidebar-nav-container .menu-item');
        
        if (!query) {
            details.forEach(d => { d.style.display = ''; d.open = true; });
            items.forEach(i => i.style.display = '');
            return;
        }

        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            if (text.includes(query)) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });

        details.forEach(d => {
            const visibleChild = d.querySelector('.menu-item:not([style*="display: none"])');
            const summaryText = d.querySelector('summary').innerText.toLowerCase();
            if (visibleChild || summaryText.includes(query)) {
                d.style.display = '';
                d.open = true;
            } else {
                d.style.display = 'none';
            }
        });
    }

    function toggleGroupChildren(groupId, isChecked) {
        const children = document.querySelectorAll('.child-of-' + groupId);
        children.forEach(c => {
            if (!c.disabled) c.checked = isChecked;
        });
    }

    function toggleGroupAll(groupId) {
        const root = document.querySelector('[data-group="' + groupId + '"]');
        const children = document.querySelectorAll('.child-of-' + groupId);
        if (!children.length) return;
        const allChecked = Array.from(children).every(c => c.checked);
        const newState = !allChecked;
        if (root && !root.disabled) root.checked = newState;
        children.forEach(c => {
            if (!c.disabled) c.checked = newState;
        });
    }

    function onChildPrivilegeChange(groupId) {
        const root = document.querySelector('[data-group="' + groupId + '"]');
        const children = document.querySelectorAll('.child-of-' + groupId);
        if (!root || root.disabled || !children.length) return;
        const anyChecked = Array.from(children).some(c => c.checked);
        if (anyChecked && !root.checked) {
            root.checked = true;
        }
    }
</script>
